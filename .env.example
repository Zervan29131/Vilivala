# Copy to .env and change all secrets before deploying to production
MYSQL_ROOT_PASSWORD=change-me-root-pass
MYSQL_DATABASE=personal_blog
MYSQL_USER=bloguser
MYSQL_PASSWORD=change-me-blog-pass

SERVER_PORT=8080
GIN_MODE=release
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=86400

SITE_URL=http://localhost:8080
SITE_TITLE=Zervan的小站
SITE_DESCRIPTION=这是存在于某处的幻想世界 · Zervanのblog
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

FRONTEND_PORT=8080
