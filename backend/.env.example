# 数据库连接（DSN 格式）
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=bloguser:blogpass123@tcp(127.0.0.1:3306)/personal_blog?charset=utf8mb4&parseTime=True&loc=Local

# 服务器端口
SERVER_PORT=8080

# JWT 密钥（生产环境请替换为随机长字符串）
JWT_SECRET=vilivala-super-secret-key-change-in-production

# JWT 有效期（秒），默认 24 小时
JWT_EXPIRES_IN=86400

# 运行环境：development / production
GIN_MODE=debug
