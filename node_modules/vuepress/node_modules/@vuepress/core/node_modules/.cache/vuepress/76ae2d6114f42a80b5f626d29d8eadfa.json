    [\n      _c(\"p\", [_vm._v(\"很少大喜大悲，内心波动比较少。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"喜欢哲学学科知识，喜欢看玄学类的东西，喜欢探究事物的本质根源。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大智如愚的样子，有很多东西他们都懂，却装作不懂。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"喜欢孤独，喜欢清静，很享受孤独和清静，享受一个人的世界，很多人都害怕孤独，而他却很喜欢孤独，喜欢一个人静静，喜欢与世无争的感觉，喜欢一个人静下来思考的感觉。他会经常把自己关在房间里，或者去一些没什么人的地方发呆。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"懂得克制自己的欲望，懂得降低自己的欲望，知足常乐。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很少看到他心情不好的样子，心态非常好，积极、乐观。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"喜怒哀乐不会表现在脸上，有什么情绪不会轻易表现在脸上，让人看不懂、琢磨不透。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"悟性很高，能很容易就看透一些事情，很容易就参悟，很容易就看透一个人，这是天赋，是与生俱来的能力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"遇到难过的事情，看得开，想得开，放得下。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"学习能力非常强，记忆力非常好，非常聪明，别人需要一年学完的东西，他可能几天就可以学完。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有很强的预见能力，可以根据自己的经验，判断事情的发展方向，预见事情的发展趋势和未来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"具有很强的逻辑思维能力，推理能力，分析总结归纳的能力。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"心思非常细腻，一草一木的凋零，他都能够感知到，别人的一个表情，一个细微的动作，他也能够感知到别人在想什么，想干什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不攀比，不炫耀，不虚荣，不嫉妒别人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"低调、谦虚、谨慎、自律、自尊、自爱。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"非常有礼貌，尊老爱幼，懂得尊重别人，富有同情心。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对自己的脾气控制能力非常强，不会乱发脾气，基本上没什么脾气，性情温和，为人和善，不喜欢跟别人争辩，不喜欢跟别人纠缠，对于很多事情都能忍过去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"语速比较缓慢，看上去反应比较迟钝的感觉。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不喜欢抱怨，遇到苦难自己扛，默默忍受，不会对别人说。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"懂得换位思考，懂得理解和包容别人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"看事情很通透、明亮。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"喜欢助人为乐，不求回报。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不斤斤计较，为人大方大气大度，相信吃亏是福。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"内心很强大，无所畏惧，没什么担心害怕的事情。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有很强的自愈能力，懂得治愈自己的内心创伤，对于已经过去的苦难，不会计较，不会在乎，不会纠结，不会纠缠。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"遇到挫折，遇到困难，只要没让他倒下，他就还会继续做自己想做的事，有不服输的劲。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不惑，对任何事情都不再迷惑，因为已经通达任何的“理”，已经不再有任何问题，并且坚信“心”的力量\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"没有狭义的善恶观念，知晓慈悲是正道，一切以天道行为为准则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"时常保持觉察，觉知，正念，体验万物合一的感觉\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"感知力增强，“他心通”开始显现，站在你面前，便知你的心念是善是恶\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"脸上会一直有喜悦的表情，这个不是单纯情绪上的喜悦，是从内向外发生的，不由自主的发生出来的喜悦心，这种喜悦心保持的久了，周围任何人见到你都很欢喜，都愿意接近你\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"时间观念开始消失，没有时间观念，每一天中的时间都是一件事一件事串起来的，厉害的人能破掉时间幻象，体会到刹那即是永恒\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"内心平静，遇事稳若泰山，真正的波澜不惊，已不被任何情绪左右，就类似于可以把情绪拿在自己手里把玩，想弄成什么样就弄成什么样\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"知因果不虚，开始注重每个发心，每个念头，凡事从因上改变。而果来则顺受之，也就是“臣服”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"分别心，评判心，开始减少，假象已经懒得继续蒙蔽你智慧的双眼，任凭你一眼看穿\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"喜欢亲近自然，尤其是树林草地这些，在这些地方能感到能量很足\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你的“本源”会和你周围的人或事物产生极微妙的联系，你会感觉到每天都在进步，每天都有不一样的收获，或许是无意中看到的一句话，或一个场景，都会跟你的思维产生一定的联系，你想要的任何答案都会显现。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一即一切，一切即一。“本源”是一体的，是你我他，是一切众生，我们是所有人，所有人都是我们自己，爱别人就是爱自己，万物同体，本无分别\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"痛苦是“苦”，快乐也是“苦”，痛苦和快乐都是假的，否极泰来，乐极生悲这种道理我就不多说了\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"格物致知。\\n上德不德。\\n天人合一。\\n世事洞明。\\n慈悲。\\n正念。\\n尽人事，听天命。\\n愿赌服输。\\n常善救人，故无弃人。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4GACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sB