{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/02.通透.md?vue&type=template&id=1eb35492","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/02.通透.md","mtime":1768579404259},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","id","staticClass","href","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/02.通透.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"抑郁时期其实是一个灵台非常澄明的时期。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你以为抑郁症患者是看不开，人生不就是吃吃喝喝，快快乐乐的享受当下吗？快乐不就行了吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而实际上，他们是看得太开了，一眼看到了终点，看得透透彻彻。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人越通透，越想清楚要做的每一件事的意义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"注意，是清楚而非追求，先是清楚，再决定是否追求。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"然而这世界本没有意义，所有的意义，都是我们人赋予的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这也是为什么，很多看起来有大智慧的人，寻找到最后，一切为空。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"吃山珍海味有什么用？营养物质没有显著提高，消化后都是那些杂质，粗茶淡饭我能吃饱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"玩电脑游戏有什么用？赢了输了又能如何，这东西也不能陪你一辈子，早晚有一天就会脱离它。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"去大城市有什么用？生活成本那么高，买不起房子要背负那么大压力，我随便栖居活的就很好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"结婚有什么用？无外乎最后生了个孩子让他度过我这同样无意义的一生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"通透的人，会把一切面对的事情背后的意义，都想得很清楚，进而省去了很多他们认为无意义的、不明智的行为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不过人想得太明白，真的不是好事。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们为什么怀念童年？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为只有那个时候，我们才能对着一个平淡无奇的玩偶鼓弄一天，我们才能不顾作业压力地陶醉在卡通动画里，我们才能觉得和好朋友在一起玩就是最大的快乐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"后来，我们明白了人总要长大，开始接触到生活的心酸，开始意识到人不能像以前一样无忧无虑，于是我们再也无法从玩偶中得到乐趣。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"有人管这个叫成长，我则管这个叫作……永远告别一种心理状态。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"普通的我们，享受的是美食、亲友团聚、每一点学习工作上的进步和成就、和喜欢的人发展关系……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这些就是普通人的意义组成。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而在他们看来，这些，大都没有意义，故尽皆不追求。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们看我们，正如我们看小孩子——我们往往不会去追求小孩子追求的那些玩具。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"然而什么是人生？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我第一次深刻思考这个命题时，是被初中读的一本叫《仙逆》的网文某段话所惊艳：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“这雨，出生于天，死于大地，中间的过程，便是人生。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人生到底还是过程量。彻底想明白这些，不会让你开心，因为这会动摇你之前认可的某些意义——比如竭力要达到的目标。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"举个例子\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#举个例子\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 举个例子\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"韭菜聪明地发现自己是韭菜。于是想摆脱韭菜的命运，又聪明地发现不可能。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是愤怒，继而无力，至于颓废。而不聪明的韭菜永远不知道自己是韭菜，他开开心心地创造剩余价值并光荣自豪地贡献出去，觉得自己就是一个拯救人类的英雄。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当他回首往事的时候，他不会因为虚度年华而悔恨，也不会因为碌碌无为而羞耻。他的一生是自足圆满的，没有牢骚，没有哀怨，只有热情和忠诚。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他的墓碑上写着:这是一颗平凡的韭菜，生得贫乏，死得满足。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"再举个例子\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#再举个例子\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 再举个例子\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们都是狗，但你不同，你是一只聪明的狗，聪明到你甚至意识到了自己是一只狗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这很不容易，大部分狗都意识不到自己是狗，他们以为他们是人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"作为一只聪明狗，你很清楚你生来是狗，将来也是狗，不可能成为人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而你又那么聪明，懂得、知道那么多，你和一般的狗不一样。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所以到头来，这种聪明，就给你带来了无尽的痛苦，怎么办？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"改变？作为一只狗，你能改变什么?改变你所处的环境吗?你每天吃狗粮、遛弯，生病了还能去宠物医院，你甚至是这个环境的受益者，你什么都改变不了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"反抗?你反抗谁呢?谁是坏人吗?你的主人对你很好啊，就算反抗你反抗得了吗?逃离?回到从林中或者成为流浪狗，你都生存不下去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就算逃离,你逃离了现在这个主人，还有别的主人，你看得，见的或者看不见的主人，你逃不掉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"改变、反抗、逃离都不行，那你就接受拥抱它咯。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不，你也拥抱不了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为你是一只聪明的狗，你所知道的、了解的一切，是你的价值所在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"智商这个东西没有回头路，高起来了就下不去了，你没办法再变回笨狗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你不愿意抛弃你懂得的东西，并且你以此为傲。所以你就非常痛苦，而且这种痛苦只属于你，因为其他的狗没有这种痛苦。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而你又懒得去跟那些笨狗去说，你知道他们不会懂你，跟他们说不明白。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们想着的是什么时候能吃肉啊，什么时候遛弯能再遇见小区里那只心仪的泰迪，或者和那只逗逼的哈士奇一块玩玩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"能抑郁的人，基本都是本质敏感聪明又善良的人，由于某些诱因，开始意识到人类的愚蠢和虚伪，社会的黑暗，生命是没有意义的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"感到非常失望，并在这个过程中越陷越深身体出现病变的过程。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人活在这地球上，不过是虫子一般的生物，出生，受尽苦难折磨，最终走向死亡，什么都不留下。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人的一生毫无意义可言，却要在自己发明的游戏里，主动或被动追求金钱，权利，名望，只为不停地满足自己低级的食欲，性欲。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种短暂的满足有什么意义，那不如一键到底的快进，他们的肉体对这种短暂的满足早已没有了兴趣，所以甚至愿意选择死亡来结束这场无聊游戏。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人的一生，不过是在死亡。他们的思想已经超脱世俗的欲望，身体也逐渐跟上了脚步。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以不是他们不想，而是已经生理的，本能的，对美味的食物失去兴趣，对性失去兴趣，对万事万物失去兴趣，更无法愉快的享受睡眠，又无法清醒的醒过来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"或许他们是因为遭受了某些失意，或许是因为痛失所爱，是童年阴影，是家庭关系，是受尽生活的种种折磨，在某一刻开始，抑郁症的病毒无声的侵入他们的身体，控制他们的思想。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就好像你淋了一场暴雨，就生了感冒一样自然。有的人淋了雨会感冒，有的人智齿会发炎，有的人天生心脏病，但你不能说，这没什么大不了的啊，我都好好的，你怎么就病了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁症被确认是一种精神性疾病，自然不同于心脏病。但是物质虽然决定意识，意识也能反作用于物质。肉体的存在决定精神的存在，但精神的状态也反作用于肉体的状态。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁的孩子最主要的一点变化就是，人际敏感度降低，抑郁时期，每说出一句话都觉得自己是不是说错了，开始想这句话重说应该怎么说，陷入了无边的自责和内耗，开始抗拒社交，因为消耗太多精力（尤其是敏感的人跟钝感的人相处是对敏感的人很深的伤害）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁症患者会一口气删了三百多个微信好友，因为觉得自己可能说不上什么时候就死了，生命太珍贵了，一秒都不能浪费在我不喜欢的人身上，这种想法有错吗？一点都没有。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁之所以是劝不出来的就是因为，抑郁者想的，活着没意义，社交没意义，做什么都没意义，这个世界不行，虽然悲观，但是都是对的，跟正常人的区别就是正常人没事儿压根儿不会去深想。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们病了，身体已经随时准备好死亡，所以主动衰竭，不再对世界做出敏锐的感知。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你以为快乐是自己的，是自我的，我想快乐就快乐，可快乐不过是大脑受到刺激分泌的多巴胺。抑郁症患者的大脑，不过是不再对这些刺激做出反应了，不再分泌快乐的化学物质，你所说的快乐，他们已经无法感知，就好像你没法说一个死人是快乐的一样简单。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他们唯一能感觉的，是精神死亡后肉体的疲惫。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你以为抑郁症只是精神的疾病，只要主动走出阴影就好了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可抑郁症就像是癌症一样，也折磨病者的肉体，他们会食欲下降。食欲原本是人类最基础的欲望，是驱动人类生存的动力，可是抑郁症患者没有了。所有的食物吃起来都如同嚼蜡，那么你所说的，挣钱买点吃的对他们来说有吸引力吗，会让他们快乐得跳起来吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁症还会失眠。整夜整夜的睡不着，或者夜里惊醒无数次，睁着眼睛等天亮。普通人只是熬一两个通宵就觉得精神恍惚，要好好睡自觉恢复一下，可是抑郁症却很难得到这样的恢复。长时间的失眠使他们精神萎靡，更加敏感暴躁。你可知道古代有种刑法，就是不让人睡觉，直到把他逼疯为止。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"吃不下也睡不好，思想没了兴趣，肉体也没了兴致。身体沉重的像灌了铅一般，日复一日的疲惫累积，他们连起床出门的力气都没有。就算他们被人拖出门，难道你发高烧40度的时候还会觉得过山车好玩？还能欣赏雪山美景？你只想回家躺着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"抑郁症并不是一时失意，而是医学界确认的一种病，一种需要吃药病。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但吃药并不能治好所有的病，也不一定能治好抑郁症。大多数抑郁症患者只是在绝望的沼泽里苦苦挣扎，试着把头露出泥潭，或者干脆一头扎进泥里，仅此而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"明明是这世界有病，为什么吃药的是我\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说 死去的人 是想开了还是想不开\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"怎么说呢，还是那句话\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多人与死亡之间的一座高墙叫做：爸妈会很难过的\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我活着是我一个人的痛苦，我死了，是多个人的多痛苦，所以我，痛苦的活着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而这到底是抑郁者的错，还是这个世界的错呢。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我不知道，但是想要从抑郁状态中走出来，确实是要学着适应环境，摸清人性，尊重客观规律，不要跟世界正面刚。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,EACrCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,YAAY,CAAC,CAAC,CAAC,EAC/BN,GAA