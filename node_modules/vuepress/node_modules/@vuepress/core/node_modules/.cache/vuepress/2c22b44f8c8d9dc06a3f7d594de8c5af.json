{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/07.技术/04.面向对象编程.md?vue&type=template&id=55801150","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/07.技术/04.面向对象编程.md","mtime":1768579404250},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/07.技术/04.面向对象编程.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"面向对象编程\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#面向对象编程\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 面向对象编程\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"面向对象编程(Object Oriented Programming)是目前非常重要的一种编程方式， 当前主流的强类型语言如C#和Java都提供了面向对象的语法特征。相对于面向过程来说，面向对象有封装、继承和多态性等特性，因此面向对象编程可以设计出高内聚、低耦合的系统，从而使系统更加灵活、更加易于维护。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"面对软件规模的日趋扩大、架构的日趋复杂和需求变化的日趋加快，将计算机解决问题的基本方法统一到人类解决问题的习惯方法之上，这是提出面向对象的首要原因。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可重用性代表着软件产品的可复用能力，是衡量一个软件产品成功与否的重要标志。当今的软件开发行业，人们越来越追求开发更通用的可重用构件，从而使软件开发过程彻底改善，即从过去的语句级编码发展到现在的构件组装，最终实现提高软件开发的效率，降低软件维护成本的目的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"面向对象编程的本质是以建立模型来抽象表达现实事物。模型是用来反映现实世界中事物特征的一种抽象载体。一般情况 下，任何一个模型都不可能完全反映客观事物的一切具体特征，但是可以根据需求抓住待解决问题的主要矛盾，即主要的特征和行为。合理的建模既可以对现实事物中的主要特征和行为进行描述，又可以简化问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"面向对象是把待解决问题分解成各个对象，而建立对象的目的不是为了完成某一个步骤，而是为了描述某个事物在整个解决问题的步骤中的特征和行为。面向对象足以功能来划分问题，而不是步骤。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"曾经在网上看到过一篇文章， 用一个比较具象的例子来说明面向对象和面向过程的不同，面向对象写出来的程序相当于盖饭，而面向过程写出来的程序相当于炒饭。用面向对象的思想来分析盖饭，那么可以抽象出来盖饭主要是由白米饭和菜(盖在米饭上)构成的，因此可以将盖饭分解成白米饭和菜。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"盖饭有很多种，其中主要的区别就是通过菜来决定的。如果盖在饭上的是青椒肉丝，那么就是青椒肉丝盖饭:如果盖在饭上的是番茄鸡蛋，那么就是番茄鸡蛋盖饭。由此可以看出，我们为了提高服务的速度和后续可扩展性，可以将米饭的制作通过电饭煲完成，然后将番茄鸡蛋和青椒肉丝分别做好，这样就可以通过不同的组合来生成不同的盖饭了。此时如果有新客户说要份鱼香肉丝盖饭， 那么我们只需要单独炒一份鱼香肉丝即可，饭不用重新做，从而提高了扩展性。面向对象就是高内聚、低耦合，相当于一种积木的方式，可以组合成不同的系统。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果是炒饭，炒饭的精髓在于入味和融合。炒饭是将饭和菜(例如鸡蛋)充分进行翻炒，达到饭中有菜、菜中有饭的境界。炒饭虽然好吃，但是饭和菜一旦混合， 二者分离起来非常难，如果客户说我要青椒肉丝炒饭，那么之前的蛋炒饭就无法利用了，只能重新将饭和菜准备好，之前的饭无法重用。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"盖饭的好处就是将菜和饭分离，从而提高了制作盖饭的灵活性。饭不满意就换饭，菜不满意就换菜。从软件工程领域来说，盖饭就是可维护性和扩展性比较好，饭和菜的耦合度比较低。炒饭将菜和饭搅和在一起， 想换炒饭中的菜和饭都很困难，饭和菜的耦合度很高，以至于可维护性比较差。软件工程追求的目标之一就是可维护性。 可维护性主要表现在3个方面:可理解性、可测试性和可修改性。面向对象的好处之一就是 显著地改善了软件系统的可维护性。当前主面向对象是种对现实世界理解和抽象的方法，是计算机编程技术发展到一定阶段后的产物。抽象、封装、继承和多态是面向对象的基础，是面向对象的四大基础特性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"四大基本特性\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#四大基本特性\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 四大基本特性:\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"抽象\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#抽象\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 抽象\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"提取现实世界中某事物的关键特性，为该事物构建模型的过程。对同一事物在 不同的需求下，需要提取的特性可能不一 样。得到的抽象模型中一 般包含属性(数据)和操作(行为)。这个抽象模型称为类。对类进行实例化可得到对象。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"封装\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#封装\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 封装\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"封装可以使类具有独立性和隔离性，保证类的高内聚。只暴露给类外部或者子类必需的属性和操作。类封装的实现依赖类的修饰符（public 、 protected 和 private 等）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"继承\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#继承\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 继承\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对现有类的一种复用机制。一个类如果继承现有的类，那么这个类将拥有被继承类的所有私有特性（属性和操作）。这里指的继承包含类的继承和接口的实现。子类可以对父类的行和属性进行扩展和覆盖。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"多态\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#多态\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 多态\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"多态是在继承的基础上实现的。多态有3个要素：继承、重写和父类引用指向子类对象。类引用指向不同的子类对象时，调用相同的方法，呈现出不同的行为，这就是类的多态特性。态可以分成编译时多态和运行时多态。在面向对象四大基础特性之上，我们在做面向对象\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"基本的设计原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#基本的设计原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 基本的设计原则：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"开放封闭原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#开放封闭原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 开放封闭原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个软件实体如类、模块和函数应该对扩展开放，对修改关闭。当软件需求变化时，尽量通过扩展软件实体的行为来实现变化，而不是通过修改已有的代码来实现变化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这项原则应该是所有面向对象编程的核心。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当然，不要妄想对修改完全封闭，这是不可能的，就像组件之间零依赖是不可能的一样。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"单一职责原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#单一职责原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 单一职责原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要存在多于一个导致类变更的原因。通俗地说，就是一个类只负责一项职责。如果一个拥有多于一项的职责，就是比较脆弱的设计，那么这些职责就会耦合到一起，也就会有多个原因来导致这个类的变化。对某一职责的更改可能会损害类满足其他耦合职责的能力。这样职责的耦合会导致设计的脆弱，以至于当职责发生更改时产生无法预期的破坏。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"做且只做好一件事，这条原则其实不仅仅适用于对象，也同样适用于函数、变量等元素。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"里氏替换原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#里氏替换原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 里氏替换原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所有引用基类的地方必须能透明地使用其子类的对象，只有当派生类可以替换掉基类，且软件的功能不受影响时，基类才能真正被复用，而派生类也能够在基类的基础上增加新的行为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当一个基类出现了其子类不想要的接口成员时，继承关系必然是欠缺考虑的继承。这个时候要么想办法把基类的那个对象抽象出去，要么子类再选择从合适的基类继承。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"接口分离原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#接口分离原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 接口分离原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"客户端不应该依赖它不需要的接口，使用多个专门的接口要优于使用单一的总接口。一个类对另一个类的依赖应该建立在最小的接口处，接口功能应该最小化，过于臃肿的接口应该拆分为多个接口。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"依赖倒置原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#依赖倒置原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 依赖倒置原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"高层模块不应该依赖低层模块，二者都应该依赖其抽象（抽象类或接口）；抽象（抽象类或接口）不应该依赖细节（具体实现类）；细节（具体实现类）应依赖抽象。简单地说就是尽量面向接口编程。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"总结起来，就是每个类与别的类交互时，尽量只使用满足接口规范的抽象类。因为抽象类几乎没有实现细节，没有什么需要变化的。抽象的对象才是最具有表达能力的对象，可以随时填充相关的细节。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"迪米特原则\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#迪米特原则\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 迪米特原则\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个对象应该对其他对象保持最少的了解，简单的理解就是高内聚、低耦合。一个类尽量减少对其他对象的依赖，并且这个类的方法和属性能用私有的就尽量私有化。对象之间的联系越简单越容易管理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就是要求对象只与必须交互的各类对象通信：当前对象本身；以参数形式传入到当前对象方法中的对象；当前对象的成员对象；如果当前对象的成员是一个集合，那么集合中的元素也都是可以交互的；当前对象所创建的对象。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"总结一下，就是类要单纯，继承要谨慎，变化要封装，抽象类型要多用。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"提示\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#提示\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 提示\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果一味地遵守这些设计原则，将导致代码分层和类变多，项目变得非常庞大。所以对这些原则要根据实际情况做出取舍。一般分层不要过多，否则会导致代码变得难以维护和跟踪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"传统的 JavaScript 程序使用函数和基于原型的继承来创建可重用的组件，但对于习惯使用面向对象编程方式的程序员来说就有些棘手了，因为面向对象编程用的是基于类的继承且对象是由类创建出来的。从ES6开始， JavaScript 程序员将能够使用基于类的面向对象的方式，但目前ES6还没有得到所有主流浏览器的支持。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果我们现在就想在 Web 应用上使用ES6的面向对象来编程，那么 TypeScript 是一个很好的选择。 TypeScript 允许开发者使用面向对象的特性来编写代码，并且编译后的 JavaScrip （可以配置编译目标版本为ES5）可以在所有主流浏览器和平台上运行。通过本章的学习可以让读者掌握面向对象的编程的基本概念，并掌握 TypeScript 语言中类、接口模块以及命名子间的基本用法。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"主要涉及的知识点\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#主要涉及的知识点\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 主要涉及的知识点\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●面向对象的基本概念：学会如何把数据有机地组合起来。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●对象的创建。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●类的基本概念和类的用法。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●接口的概念以及用法。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●命名空间以及其用法。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●外部模块的概念和用法。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●模块解析过程。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"●声明合并。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAS;EAAE,CAAC,EAAE,CACpCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAU;EAAE,CAAC,EAC5D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,SAAS,CAAC,CAClB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,0JACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,4EACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,iIACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,sJACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,yFACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,uIACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,qPACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,sIACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EA