{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/41.文笔.md?vue&type=template&id=4bda1067","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/41.文笔.md","mtime":1768579404275},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/41.文笔.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"1、生活中随处可见这样的脸孔，它们的五官是拼凑在一起的：眼睛来自上司，耳朵取材于走廊或楼梯，鼻子朝向窗外的自由市场，而嘴巴及舌头还沾着传达室的余温。这样的人令人混淆，即使很熟也常常叫错他们的名字。——穆涛\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“马屁精”、“领导肚子里的蛔虫”、“道听途说”、“爱八卦”、“成天说东道西”、“长舌”之类的词句。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2、中国人的脸，不但可以洗，可以刮，并且可以丢，可以赏，可以争，可以留，有时好像争脸是人生的第一要义，甚至倾家荡产而为之，也不为过。——林语堂\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“中国人特别爱面子”之类的词句。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"3、门口桌子上，一叠饭碗，大碟子里几块半生不熟的肥肉，原是红烧，现在像红人倒运，又冷又黑。旁边一碟馒头，远看也像玷污了清白的大闺女，全是黑斑点，走近了，这些黑点飞升而消散于周遭的阴暗之中，原来是苍蝇。——钱钟书\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“红烧肉糊了”、“苍蝇乱飞”之类的词句。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"4、他恭维人的方式，肤浅的人看来似乎很迷人；精细的人却觉得是一种冒犯，因为这种急不可耐的、过火的阿谀奉承，一听就能猜出他肚里的盘算。\\n——巴尔扎克\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“拍马屁露骨”之类的词句。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"5、一见短袖子，立刻想到白臂膊，立刻想到全裸体，立刻想到生殖器，立刻想到性交，立刻想到杂交，立刻想到私生子。中国人的想像惟在这一层能够如此跃进。——鲁迅\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“上纲上线”之类的词句。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"6、拜读过苑子豪郭敬明等人的大作(特别大的作品)，也读过钱钟书，杨绛，梁实秋等人的大作(真的大作)\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"前者算是堆砌而成，后者则是文风的积淀。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我仍记得围城开篇，写道：……夜仿佛纸浸了油，变成半透明体。它给太阳拥抱住了，分不出身来……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没有45度角仰望的天空，也没有明媚的忧伤，但我至今仍未找到比这描写得还贴切的晚霞，用的不过是寻常的词汇，小学生也可以读的懂。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而华丽的文风，也别有一般风味。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"小楼昨夜又东风，故园无此声，都是唯美的典范，然而并不是华丽的词藻。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，我觉得，文风不是由词藻决定的。堆砌的词藻哪里能算得上华丽的文风？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"态度决定一切。感人心者，莫先乎情。文出于情，无论词藻华丽与否，自然动人。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wGACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,EACrCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2GACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4EACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8EACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EA