r _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h1\", { attrs: { id: \"积累写作素材\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#积累写作素材\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 积累写作素材\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"作家写作旁征博引，我对此感到很好奇，难道他们真的能把这么多东西背进脑海里吗？还是他们是建立了一座素材库，需要时就拿出来用。\\n如果说作品是一个完整的生命体，那么素材就是它的血肉、器官、四肢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"素材的积累相当重要，可以说没有素材，就没有鲜活的生命体。从创作最源头开始，素材收集也是一个有相当技术含量的工作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"一、特点鲜明的个体\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#一、特点鲜明的个体\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 一、特点鲜明的个体\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人物收集起来可以做主人公，也可以做次要角色（NPC）。注意，\"),\n        _c(\"strong\", [\n          _vm._v(\n            \"人物类素材一定要有个性，比较特别（平凡到不能再平凡也属于一种特别）\"\n          ),\n        ]),\n        _vm._v(\n          \"，起到的作用就是使作者在调用某种类型角色时能够快速联想，包括衣着、体型、风格、口头禅或标志性动作、习惯等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"举个例子，鲜明的小偷形象：衣着普通，可能胡子拉碴、头发浓密，不爱说话，目光飘忽不定。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"或者更加具有性格区分度的两种：\")]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"老警察——衣着普通，与小市民无二，做事圆滑，面对违法之事有时甚至会视利益情况做出不同处理；\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"年轻警察——带有冲劲，刚正不阿，对邪恶和不公正极为反感，衣着色彩明亮，外表大多阳光。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"二、一切可能发生故事的地方\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#二、一切可能发生故事的地方\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 二、一切可能发生故事的地方\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"地点类素材很好理解，很多作者都反映过，场景环境总是写不好，谈个恋爱只能去小树林，而且连树都还描写不生动。这是由地点素材匮乏导致的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们在收集素材时，\"),\n        _c(\"strong\", [_vm._v(\"一切可能发生故事的地方\")]),\n        _vm._v(\"都在该类型之下。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这样的地点应该有一些细微之处能够体现在文字中，并让读者感受到这样的环境特色：清幽、嘈杂、危险、祥和等等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"普通型地点素材举例：常见的家中生活处、电影院、某某大学、监狱；\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"特殊型地点素材举例：热带雨林中的某处瀑布（声音极大，场面壮观）、跳伞前的飞机上（高空低压、寒冷、极限运动）。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"三、有价值的非人器物\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#三、有价值的非人器物\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 三、有价值的非人器物\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"物品属于一个宽泛的概念，可以是杀人工具，也可以是一个礼物，还可以是摆在老家院子角落里的一个簸箕。\"\n        ),\n        _c(\"strong\", [_vm._v(\"只要是有价值的非人器物，都属于物品类素材。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"物品大多组成故事细节，但更为合适的方式是\"),\n        _c(\"strong\", [_vm._v(\"担当导火线以及某个线索\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在很多警匪片里都有这样的情节，侦探勘察完现场之后，会在某个细微处找到突破口，比如一根头发丝，比如死者的指甲里的血迹等等，结合起物品的表征可以更好发挥它的作用。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"再举个例子，厕所火灾后的灰烬里一把尖刀。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"四、立场对立\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#四、立场对立\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 四、\"),\n        _c(\"strong\", [_vm._v(\"立场对立\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"当看到某种冲突出现时\")]),\n        _vm._v(\"，情境类素材积累点就到了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"双方或多方立场对立、目的互斥是较为基本的情境结构，能够起到制造压力的效果\"\n          ),\n        ]),\n        _vm._v(\"。与其他素材不同的是，情境类的幅度稍微广些，涉及面也大一些。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"举个例子，人物一和人物二同时看上一本书，书店里只剩一本，双方均不愿退步。这就是一个典型的小情境样本。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"另外，冲突只是较为有效的情境素材，不一定非得是冲突，只要满足基本情境条件，能够在故事中使用的都可囊括进来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"五、动作描写\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#五、动作描写\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"五、动作描写\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"动作描写是相当大的一门学问，单独也可以讲个几天几夜，限于篇幅，在这里做概述。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"行为或动作一定要为大局服务，带有目的性。这里举一个很精彩的动作素材：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"小姨将双袖向上一挽，裤脚也被卷到了大腿。她在小溪水里慢慢移动着，左脚轻轻地抬起一点，向前迈了一小步，右脚再慢慢拖向前，好像穿着千斤重的鞋。她把帽子扭了扭正，躬着背，低着头，眯着眼，双手做出捧东西的样子。这时，她停下脚步，不再东张西望，对着右边的一个地方目不转睛，猛然把手向水中一扎，将一条小鱼捧在手中了。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“挽、卷、抬起、迈、拖向前、躬着背，低着头，眯着眼、一扎”将捕鱼的镜头活灵活现地呈现在读者眼前，就好像一出戏刚刚上演一样，这样的描写，不可谓不出神入化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"再来一个经典片段：\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\"那野人喝了酒，又听见自己已经获救，不觉\"),\n          _c(\"strong\", [_vm._v(\"精神为之一振\")]),\n          _vm._v(\n            \"，居然马上坐了起来。不料，星期五一听见他说话，把他的脸一看，立刻又是吻他，又是拥抱他，又是\"\n          ),\n          _c(\"strong\", [_vm._v(\"大哭大笑\")]),\n          _vm._v(\"，又是\"),\n          _c(\"strong\", [_vm._v(\"大喊大叫\")]),\n          _vm._v(\"；又是扭自己的两手，打自己的脸和头，继而又是高声大唱，又是\"),\n          _c(\"strong\", [_vm._v(\"乱跳狂舞\")]),\n          _vm._v(\n            \"，活像个疯子。他那样子，任何人看了都要感动得流泪。——《鲁滨逊漂流记》\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如上文，野人的“坐”起来，和星期五的“吻”“拥抱”“大哭大笑”“大喊大叫”“乱跳乱舞”等等形成一个对比，把星期五的兴奋和狂喜塑造得非常美妙。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"上面两个例子是已经转化为作品的现成素材，我们在遇到一些原始的动作时，也要注意运作模式，恰当地积累下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"六、观点、想法、经验\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#六、观点、想法、经验\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"六、观点、想法、经验\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"留心可能作为主旨的观点、想法、经验。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然后在写作时融入到故事之中去，比如说35岁职场危机，就能贯穿到都市、现代小说里，升华故事情感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"主题素材相对较虚化，不容易抓住，但好在不需要太多，主旨也就那么一些，而且使用时往往一两个就够了，所以难度反而不是很大。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"综上，\"),\n        _c(\"strong\", [\n          _vm._v(\n            \"积累素材的最大好处就是，我们的素材不再是紊乱模糊的，在具体创作时能够根据需要随时快速调用，而且原素材在收集时是经过思考整理的，运用会更加得心应手。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"素材收集源\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#素材收集源\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 素材收集源\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"· 观察生活\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"日常生活是一切的源头，当然也包括我们的素材积累。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"吃饭的餐厅、下午茶的水吧、学习、旅行、上班等等，有无数有趣的内容等着我们去摘取。记得擦亮眼睛~\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"· 亲人好友的经历\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"自己亲自体悟肯定是远远不够的，所以可以多听听来自老师、朋友、长辈们的故事，觉得很棒的就可以摘抄下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"多和他们聊天，会有精彩的情节出现。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"· 梦境\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"庄生晓梦、南柯一梦、黄粱一梦，我们无比熟悉的这三个梦境就是活生生的例子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有些人在平时没有什么想法，但梦里的脑洞却超级大，更要利用好这个完全不用靠他人的方式，把素材积累起来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"· 媒体网络\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"电影、电视剧、新闻，甚至各种八卦，都能成为某种素材的来源，特别是新闻，这种未被加工之前的纯实践经过，是最原生也最有改造价值的情境、主题素材。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有很多世界名著就是出自原生新闻，比如托尔斯泰的《安娜·卡列尼娜》。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"· 阅读\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在阅读过程中，我们能获得一些相当精彩的素材或者灵感，而且还能学习其他作家的表现手法，通过阅读时你的联想，思绪发散之后，往往一个故事雏形就已经在你脑海里成形了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"还有一些比如绘画、著名雕塑、摄影等也属于广义上的阅读素材源。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ul\", [_c(\"li\", [_c(\"strong\", [_vm._v(\"自身灵感\")])])]