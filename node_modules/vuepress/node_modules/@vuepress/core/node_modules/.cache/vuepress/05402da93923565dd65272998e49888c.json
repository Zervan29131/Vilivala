{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/11.精神控制.md?vue&type=template&id=6c579b56","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/11.精神控制.md","mtime":1768579404260},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/11.精神控制.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"一种周围所有的人带给你的精神控制。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"冷门，大多数人没有真正察觉到这种手段。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"常见，这种手段在我们的身边时时刻刻都在发生。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"阴毒，这种手段攻击的是你的潜意识。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"明显，这种方式其实在心理上，早就给你带来了强大的压迫感。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不道德，废掉你的人就是发自内心地想干掉你。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"符合人性，想要废掉你的人，\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"同样也是一个个可怜人，在他们的内心里，他们也同样因为自己的弱小，深深地陷入了无限的焦虑和无助感之中，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"因此，他们只能用拼命阉割掉你的方式，才能让自己活下去。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不知道你们有没有听说过这样的一句话，我在第一次听见的时候，陷入了一种深深的思考当中\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们每个人都渴望着成功，但事实上，我们之所以没有真正成功，是因为害怕成功之后所遭受的惩罚。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因此，我们总是趋向于不断地通过各种方式将自己进行阉割，不断地通过各种方式将自己废掉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不断努力地冲破层层束缚着你的屏障，但每当你成功地冲破一次屏障，获得一次成功之时，周围的人都会不断地向你传来惊异的目光。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"起初，这种目光是一种夹杂着祝福的美好问候。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，一旦你还在继续不断地去突破、去成功，以至于你开始渐渐地突破周围的那个阶层。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"此时，在人们的内心当中，会自觉不自觉的生出一种惊恐和嫉妒的心理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当你的水平和实力还在不断地去突破，以至于周围的人完全跟你不在一个档次之时，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在他们的心底里，会开始感觉你是一个异类，巨大的落差感让他们开始感觉到自己的人生被抛弃，他们开始在内心深处觉得你是一个怪胎。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"此时，在你的内心深处，你开始感觉与周围人的心理距离越来越远，你感觉到自己在无形之中攻击到了他们。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你开始害怕自己与周围人的关系遭受破坏，孤独、寂寞、害怕的情绪也就随之而来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"此时，你因为成功而遭受的惩罚也就随之而来了\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"此时，在你的面前，唯一能够选择的只有两条路。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第一条，背负着这种巨大的威胁和压迫感，继续努力地去成长、去突破，以至于完全突破之前的那个阶层，最后打开一个新世界的大门，进入一个新的环境和人际关系当中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第二条，在你的潜意识当中，你开始承载不住这种巨大的压迫感。因此，就算你有充足的潜力和本领让你成功，你也会在冥冥之中自断其臂，你的潜意识会将你自觉不自觉地进行阉割，然后让你的实力和水平回归到之前的那个阶层，只有这样，你内心里的安全感才会重新找回来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可是，一旦你选择了第二条路径，你就因为周围所有人给你带来的压力，被废掉了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我们在学校读书的时候，年级第一的日子其实是非常不好过的，他因为自己的过于优秀，告诉了身边的所有人一个事实，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你们看，一个人的学习成绩本就应该可以做到这个高度，所以，你们都是傻子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在这一瞬间，年级第一直接攻击到了全校的所有人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这种对周围所有人的嘲讽虽然不是出于本意，但却无法避免。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当你在努力地学习的时候，周围的所有人都会感受到强烈的压迫感，这种压迫感就会导致他们在内心深处对你产生恐惧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而这种他人内心深处的恐惧感，会对你进行反噬，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那是因为，虽然大家明面上不会说出来，但是你过于强大的成绩，会拉开他人与你的心理距离，会让他人对你产生敌意，你成为所有人潜意识里的众矢之的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"150分的数学卷子，你能考满分，其他人连及格都难，这份巨大的落差感所带来的敌意，让你感受到压力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你的学习成绩可以考重点985、211，甚至是清华北大，但周围的人连考上一个普通的一本都难，这份巨大的落差所带来的敌意，让你感受到压力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你的未来一片大好，迎接你的将会是一片光鲜亮丽的人生，而周围的人将会面临的是指日可待的味同嚼蜡的生活，这份巨大的落差所带来的敌意，让你感受到压力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"当你因为这份成绩感受到高出不胜寒的时候，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你因为自己的成功而遭受的惩罚也就随之而来了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在这种情况之下，如果你承载不住这份因为自身的强大而带来的巨大压力，你会重新堕落到之前的那个阶层，你会在自己的学习工作当中自觉不自觉的进行放水，从而使自己跟他人处于同一个水平层次，使得自己能够心安理得。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"最后，你就这样非常遗憾地被废掉了。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“害怕成功之后的巨大惩罚”，这样的例子，在我们的生活当中，或者是影视作品当中比比皆是。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"全国著名的民间歌唱家——朱之文，本来生活在一个贫寒的农村家庭，却因为拥有一个美丽的歌喉闪耀于星光大道，在无数的鲜花与掌声之中，他所面临的，使同村人的嘲讽与嫉妒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"无数死皮赖脸的同村人向他借钱然后杳无音信。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"多少谩骂和责备也向他汹涌而来，明明是他通过自己艰辛的劳动和努力所积累的财富，却被指责他是一个没有良心的人，没有好好地为村里人做出贡献。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中央电视台新闻联播主持人张宏民，因为人民和事业付出了自己终生的一切，直到晚年大家才惊讶地发现，因为工作的过于繁忙，直到退休依旧孑然一人，这份无私的精神本应该被大家所钦佩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"没想到，张宏民遭受的确是无数网友的谩骂，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“聪明人干的糊涂事。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“这么好的基因，不多繁殖，太可惜了。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“书都白念了。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“在父母面前不是一个好儿子，不是一个完美的人生。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“不结婚，恋爱也不谈，肯定有问题。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“（因为不结婚）书都白念了。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对于这份成功之后的惩罚，张宏民又能承担多少。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"影视作品当中，这份成功之后的惩罚也比比皆是。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"著名的邻家男孩——蜘蛛侠彼得帕克，本应该在获得超能力之后获得一个幸福而美满的人生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于他来说，完全可以通过摔跤比赛赚取巨额的佣金，从而走向人生的巅峰，却因为叔叔的死，走上了一条“能力越大，责任就越大的道路”，从此，他所面临的，就是一条修罗之道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"复仇者联盟3中的著名角色钢铁侠也是如此，在与灭霸的战斗当中，灭霸就对他直言：“你不是唯一一个被知识所诅咒的人！”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就在复仇者联盟4的结尾，为了取得最后的胜利，钢铁侠唯一能够做的，就是牺牲自己，然后换取全宇宙所有人的性命。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"欲戴王冠，必承其重，想要不成为一个废物，就必须承担不是一个废物所带来的巨大压力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们大多数人之所以都是废物，其本质原因，是因为成为一个废物可以让我们感到舒适、安全、以及心安理得。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人，就是这么被废掉的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"现在的你为自己依旧是个废物感到可怜而又可悲么？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"好好想想，你的人生到底想要的究竟是什么？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"是为了某些重要的事情，承载巨大的压力，在痛苦之中不断地冲破屏障，获得一个辉煌而又充满沧桑的人生？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"还是心安理得的当一条咸鱼，在从众的过程当中，归于平庸。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这两者，到底哪一个更好？\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v