c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"庄子的下限：贫穷。逗逼。嘴毒。没钱，没工作，没事业。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"庄子的上限：庄子的上限，就是你们人类的上限。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"真实、无为。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一个真实的人，就是人类精神世界的顶峰。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"就好比一个玉器，要怎么才是玉器？做自己就可以了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人要怎么才叫艺术品？要怎么活才能活出人的自由品质？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"活出人本身。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"庄子，既没有工作，又没有钱，又没干什么事业，也就是他所说的“不材之木”，是废材。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们一般历史上留名的人，都有事业。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"庄子，既没有什么主张，也没有什么事业，但是最聪明的人，都喜欢他。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这棵没什么用的树，在得道之人眼中，却是神木。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有利用价值的，都在食物链当中，参与这个世界的利益斗争的人，都没能保存自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"例如，我们普通人，辛苦工作，获得一点口粮，一辈子就那样过了。这都是不会保存自己，没有活出完整的自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"神木为了学会保存自己的完整，到了生死边缘。\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [_vm._v(\"且予求无所可用久矣！几死，乃今得之，为予大用。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这也是“道”的境界，“道”无用，“爱”无用，“自由”无用，才保存了它在宇宙中无处不在的地位。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这也是《道德经》中“水”的境界：处众人之所恶，为而不争。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"呆在不被重视的地方，默默洒下一片阴凉。\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"古之真人，不逆寡，不雄成，不谟士。若然者，过而弗悔，当而不自得也。\\n古之真人，其寝不梦，其觉无忧，其食不甘，其息深深。\\n古之真人，不知说生，不知恶死。其出不欣，其入不距。（庄子《大宗师》）\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“过而弗悔，当而不自得”，就普通的“活在当下”：犯了错误也不会后悔自责，做了什么事也不得意洋洋。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不活在时间中的人，没有自我中心的人，都不难。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"不要以为“道”很复杂。我不明白有的人为什么学来学去，总学不会。\"),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,QAAQ,CAAC,CAAC,CAAC,EAC3BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,QAAQ,CAAC,CAAC,CAAC,EAC3BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG