this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"现在还是一个学生，很快就要进入社会。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一个性格上很单纯的人，就会逐步的显得幼稚起来。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在很多时候，都还会把自己定义为一个孩子，但是进入社会后没有人会把你当成孩子对待。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"单纯可以理解成性格上的天性，需要我们有意识的培养自己引导自己，做到进入社会以后可以保护自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这并不是让自己成为那种心机深似海的人，只是学习一下如何保护自己，而不是别人说什么就傻乎乎的信什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"和人相处的时候，很多人都会见人说人话，见鬼说鬼话。表面看起来关系不错，其实关系一般甚至不好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"性格单纯，就会以为表面上的和善就是真的对自己好，其实只是礼貌的客套。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么遇到这种情况该怎么办呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"走技术流。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"性格单纯的人最大的弱势就是不会搞关系，容易把别人的客套话当真，看不出来好人坏人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"解决方案要么是改变自己（绝大多数人做不到），要么是随它去。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但随它去的前提，就得是你得表现出自己的价值。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"技术流最合适。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"打个比方，比如全公司只有你一个人会修电脑，不管你多么单纯，大家也不会主动去害你，因为别人会想到：我电脑坏了还得找他帮忙呢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"再打个比方，如果你是一位医生，这个手术只有你能做好，那么不管别人对你多么羡慕嫉妒恨，也有你的一席之地——因为遇到这个手术，就必须得你上场。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即使遇到了极品的医院，周围人各个都是极品，宁愿不要你这样的专家也非得要欺负你排挤你，那你换一家医院就是了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这世界上伯乐虽然不常有，但资本家常有。能挣钱的台柱子，没几个人会愿意拒绝。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"做到技术流，尤其是权威水准的，那你在大多数情况下，根本不需要去应酬，根本不需要去辨别别人是好还是坏——你只要做好自己的技术工作就够了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为了避免被人害，每件事来往的文件，邮件，信息，都要留个底，不要只打电话，如果打电话要养成录音的习惯。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,yBAAyB,CAAC,CAAC,CAAC,EAC5CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,gBAAgB,CAAC,CAAC,CAAC,EACnCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,OAAO,CAAC,CAAC,CAAC,EAC1BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EA