{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/05.乌合之众摘抄.md?vue&type=template&id=50d705d4","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/05.乌合之众摘抄.md","mtime":1768579404272},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/05.乌合之众摘抄.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"村口的狗叫了，其他狗也跟着叫，但他们不知道为什么叫。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"优秀的人不是不合群，只是她合群的人没有你而已\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这个世界好奇怪，把想活着的人往死里逼，又劝想死的人好好活着，于是所有人都半死不活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人一到群体中，智商就严重降低，为了获得认同，个体愿意抛弃是非，用智商去换取那份让人备感安全的归属感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"群体只会干两种事——锦上添花或落井下石。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个国家为其年轻人所提供的教育，可以让我们看到这个国家未来的样子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对历史而言，个人命运可能隐藏在很小的一个小数点里，但对个人而言，却是百分之一百的人生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体总是对强权俯首帖耳，却很少为仁慈善行感动！在他们看来，仁慈善良只不过是软弱可欺的代名词。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大众没有辨别能力，因而无法判断事情的真伪，许多经不起推敲的观点，都能轻而易举的得到普遍赞同。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体中累加在一起的只有愚蠢而不是智慧，因为群体中的个人才智被削弱了，在群体中能获得响应的只是大家都具备的寻常品质，那么这只会带来平庸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在与理性永恒的冲突中，感情从未失过手。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"个人一旦成为群体的一员，他所作所为就不会再承担责任，这时每个人都会暴露出自己不受到的约束的一面。群体追求和相信的从来不是什么真相和理性，而是盲从、残忍、偏执和狂热，只知道简单而极端的感情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"夸大其词，不断重复，言之凿凿，绝对不以说理的方式证明任何事情，是说服群众的不二法门。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们以为自己是理性的，我们以为自己的一举一动都是有其道理的。但事实上，我们的绝大多数日常行为，都是一些我们自己根本无法了解的隐蔽动机的结果。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有时不真实的东西比真实的东西包含更多的真理。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群众从未渴求过真理，他们对不合口味的证据视而不见。假如谬误对他们有诱惑力，他们更愿意崇拜谬误。谁向他们提供幻觉，谁就可以轻易地成为他们的主人；谁摧毁他们的幻觉，谁就会成为他们的牺牲品。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"数量在人类社会中经常性地会产生一种充足的理由，处于群体中的个人会感受到一种强烈的“正义”力量，对他们来说群体就是正义，数量就是道理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体可以杀人放火，无恶不作，但是也能表现出极崇高的献身、牺牲和不计名利的举动，即孤立的个人根本做不到的极崇高的行为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"没有传统，就没有文明；没有对传统的缓慢淘汰，就没有进步。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"孤立的个体具有控制自身反应行为的能力，而群体则不具备。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"专横和偏执是一切类型的群体的共性。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所谓的信仰，它能让一个人变得完全受自己的梦想奴役。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"令人难忘的历史事件，只是人类思想无形的变化造成的有形的后果而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"群体喜欢幻觉而不喜欢真理。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只要他属于有组织的群体中的一员，他就在文明的阶梯上倒退了好几步。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在群体中，蠢人、白痴和妒忌者不会再感到自己平庸和无能，而是产生了一种强烈、短暂却巨大的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"个人可以容忍矛盾和争论，群体却绝不允许。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"残忍与破坏的本能是与生俱来的，它蛰伏在我们每个人身上。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"暗示给群体的不管是什么观念，其形式只有变得绝对和简单的时候才能显示出其重要性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"观念具有非常简单的形式之后才能被群体所接受。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当某种观念通过各种方式终于进入群体的大脑，它便有了不可战胜的力量，产生了人们必须忍受的一系列影响。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"各个时期、各个国家的伟大政治家，包括最残酷的独裁者，都把民众的想象力当作是他们的权力基础，从来不逆之而行。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"影响大众想象力的不是事实本身，而是它所扩散和传播的方式。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体的笃信具有宗教感情固有的特点：盲目服从，极其褊狭，渴望传播。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对一个民族来说，理想的状况是保持过去的制度，不知不觉地、慢慢地对它们进行改良。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"教育可以让群体的头脑部分地改善或恶化。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"群体从来不渴望真理。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"要让真理深深地扎根在群众的思想当中，摧毁已变得很危险的幻觉，经验可以说是唯一有效的办法。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个演说家，如果只顾着自己的思路说话而不顾听众的感受，是绝对产生不了什么影响的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"理性把人类带向了文明之路，但缺乏幻觉所激起的那种热情和勇敢。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"领袖起初往往都是被领导者，他本人也需要被某种思想所迷惑，然后才成为这种思想的拥护者。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不管他们捍卫的主张或追随的目标是多么荒谬，面对信仰，所有的理性都是多余的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"聚集成群的人失去了自己的意志，本能地走向某个有主见的人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"历史上的重大事件都是由默默无闻的信徒发端的，他们除了自己的信仰一无所有。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体最想得到的，并不是自由，而是被奴役。他们非常渴望服从，本能地臣服于自称为他们领袖的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"通过重复而被肯定的东西会深入人们的思想，让他们把它当作是一种经过检验的真理来接受。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"模仿被认为对社会现象有重大影响，其实，它只是传染的一个小小的结果而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"声望其实是一个人、一部作品或是一种思想对我们的精神统治。这种统治麻痹了我们的批评能力，让我们的灵魂充满惊讶和崇敬。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"神明、英雄和信条都具有迫使大家接受的力量，而且不允许讨论。一讨论，他们的声望就荡然无存了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于每个历史悠久的民族来说，伟大的普遍信仰的诞生和灭亡都意味着它的历史高峰，构成了文明的真正基础。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"革命的开始其实就是信念的结束。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一种重大信念走向衰亡的确切日期是很容易发现的，即它的价值开始受到质疑的那天。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"新的教条一旦在群体的思想中扎根，就会成为其制度、艺术和行为的灵感之源。它对灵魂的统治是绝对的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"在集体当中，智力不起任何作用，只有无意识的感情在起作用。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"文明是少数精英的作品，他们组成了金字塔的顶部，下面的几层，思想价值越低便越宽，组成了一个民族的深厚底层。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在揭示事情的复杂性，进行解释和说明的时候，智力常常会让人显得太过宽容，从而大大削弱使徒所需的强烈而粗暴的信念。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在某些民族中，所有的自由都被逐渐限制，尽管表面上的许可会让大家产生幻觉，觉得自己还有自由。这种限制似乎是民族衰老的结果之一，任何制度衰老了都会如此。这是衰亡阶段到来的前兆之一。至今为止，任何文明都无法逃避这种衰亡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这一不可避免的时刻总是以理想的衰亡为标志，而理想是种族精神的支柱。理想日益苍白，在它的光芒照耀下建立起来的宗教、政治和社会大厦都将开始动摇。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"随着古老理想的彻底丧失，种族将最终完全失去自己的灵魂，成了一群独处的个人，回到了起点：群体，表现出一切短时间的特征，步调不一，没有前途。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从野蛮到文明，一路追逐着梦想，而当这种梦想失去了力量，便开始衰落，走向死亡。这就是一个民族的生命周期。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"关于“群体道德”，残忍与破坏的本能是与生俱来的\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果我们把“道德”这个词理解为持久地遵守某些社会习俗，不断压制自私的冲动，那么，过于冲动和多变的群体显然不能被认为是有道德的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但如果我们在“道德”这个词当中加上某些可以一时表现出来的优点，如忘我、忠诚、无私、自我牺牲、渴望平等，我们则可以说，群体有时表现得恰恰相反，能做出非常道德的事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"研究群体的心理学家不多，而且都是从群体犯罪的角度去研究。看到他们如此频繁地犯罪，心理学家们都认为他们的道德十分低下。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也许事实往往如此。可为什么会这样呢？原因只有一个，那就是残忍与破坏的本能是与生俱来的，它蛰伏在我们每个人身上。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，如果说群体常常服从低劣的本能，有时也可以作为品德高尚和道德崇高的典范。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果无私、顺从、绝对忠于某种或虚或实的理想也属于美德的范畴，我们就可以说，群体常常拥有这类美德，其水平甚至连最睿智的哲学家也不一定能够达到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他们这样做也许是无意识的，但这没关系。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们不要过多地抱怨群体总是受无意识的驱使，不动脑筋。如果他们动起脑筋，考虑自己眼前的利益，也许任何文明都无法在我们这个世界上发展，人类也就不会有历史了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个问题可以上升到制度\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"就像民主共和治和民主专制。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"民主共和制是由多数人选出来的领袖，从而代表大多数人的利益，牺牲小部分人的利益。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从而领导社会发展，但多数人都是愚昧自私的。他们很容易受到眼前利益的诱骗从而做出错误的选择将权力滥用！社会也会自然无法进步！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"民主专制是由时代变化产生的自然领袖。是时代自然选择的领袖（毛泽东），他们代表的是社会集体利益。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可以增强社会凝聚力！使社会快速有效的方式快速发展！但是太权力集中！权利被滥用的后果也将会巨大的灾难。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"民主共和制：让自己做选择！民主专制：让聪明人帮助大家做选择！\"),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,