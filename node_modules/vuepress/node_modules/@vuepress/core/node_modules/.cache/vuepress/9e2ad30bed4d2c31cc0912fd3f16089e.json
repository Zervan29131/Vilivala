ot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"选择越多越自由，但人也越容易疲惫。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"上高中时，没得选择，你只有拼命刷题，拼命学习，其他事你并不需要管。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"上了大学以后，你可以选择不写作业，实在不行去抄抄作业就行了；\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你可以选择不上早晚自习，到头来扣减一些操行分也无所谓；\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你可以选择翘课、不认真上课，大不了挂科；\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你可以选择作弊，顶多拿不到毕业证\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你有太多选择了，但与此同时，主动选择也是一件痛苦的事，被动选择、随波逐流是很舒服的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"高中时，你什么都不用想，周围的人都在题海战术，自己随波逐流拼命刷题拼命学习就行了，考好考不好都没关系，只要你机械地服从安排就好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"表面上努力，自己也足够安慰自己。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但上大学后，需要你自己主动选择，你可以选择奋发向上，也可以选择随波逐流、堕落、混日子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没得选择听起来是件很不舒服的事，因为这没自由，但其实，这样是最轻松舒服的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"因为你不用去选择，也不用去承担选择出差错的后果。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有的选择是最痛苦的，因为你选择的出了差错，所有的压力、结果都得由你自己一人承担。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没得选择时，你可以推卸，说自己笨，自己努力地刷题，但自己就是考不好又能有什么办法？你可以推卸，说老师不行，自己和同学们一样，都认真学习，但就是考不好，怪我咯？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大部分人觉得上大学的压力比高中时代压力大。没错，只是因为面临的选择太多太多了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以选择抓住每一个可以积极表现自己的机会，你也可以选择所谓的低调保持沉默；\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以选择为每一个集体积极出力，你也可以选择事不关己高高挂起；\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以选择自己中意的团体组织锻炼自己的各种能力、扩展人脉，你也可以选择只禁锢在自己的小圈圈内坐井观天、妄自菲薄。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一切的一切都取决于你自己，没人替你安排你的人生。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你有太多选择，你也有太多事需要你去选择。看似自由，但你要清楚，你所做出的每一个选择，你都要想好去承担其相应的结果。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你不能再像以前一样，有人替你选择好了，自己只管去做就行，但尽人事，各凭天命。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你必须自己去选择，然后，自己去承担，如人饮水，冷暖自知。你可能因为自己的选择而高兴，也可能最后得到一个悲伤的结局而难过。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以我们会迷茫、会彷徨、会不知所措，因为以前有人替我们选择，有人替我们操心后果。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而现在，只能自己选择，自己去承担结果，无论结果是好是坏。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人生就是一个不断试错的过程，你选择不去选择、随波逐流，你不会错，但你也只能平庸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你一旦去主动选择，你就要做好承担出错的准备，你要能承受选择出错所导致的代价。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你可能会因为你的选择错千次万次，也可能恰好对一次。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"当你面临众多选择时，是该选择随波逐流还是该选择坚持自我？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不要害怕去选择，不要后悔自己的选择。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GA