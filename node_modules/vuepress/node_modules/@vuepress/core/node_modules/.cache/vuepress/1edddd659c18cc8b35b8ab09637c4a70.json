   \"※养成全面的开放思想，对社会万象（合法范围内）积极接受、适应，紧跟社会潮流，快速跟进。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"对社会争议事件应当敢于面对、敢于评论并且保证客观看待。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"积极学习，养成谦虚的态度。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"爱国，并且合理爱国。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"③知识与能力\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在高三生活基本压制住小爱电脑知识提升，目前对近期电脑市场基本失去掌握的背景下，小爱必须保持继续学习。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大学应重视ps，ai，ae，pr等专业软件的学习与使用，提高ps的使用水平，并且继续为二次元部落C群制作图片。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大学必须自学编程技术。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在大学学习期间必须积极适应上海环境，适应大城市的快节奏生活，了解大城市的各种事物包括文化与娱乐，以为之后的生活作准备。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"克服腼腆性格，必须提高各方面胆量与办事能力。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"必须提高自己的自信心，以自信驱动起自己的一些未来活动。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"安氏第二计划隶属于多棱镜计划。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"多棱镜计划目前阶段口号：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"多棱镜熠熠生辉，吾等学子奋起直追。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"该口号与高三时期口号一致，但高三的“奋起直追”指努力提高自己的应试成绩，接下来阶段的“奋起直追”指向新生活奋力奔进，适应并提高，缩小自己与发达地区学子的差距。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,+CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,sCACF,CAAC,CACF,CAAC,EACFN,