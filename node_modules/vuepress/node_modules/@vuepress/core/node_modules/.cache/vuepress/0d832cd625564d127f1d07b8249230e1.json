tSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"「对吃苦精神的执着，迷信，与病态的追求」\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"司马迁不割就写不出史记，孙子不瘸写不出兵法，勾践不吃屎就要二十投，韩信不爬一回胯不能领兵，困了累了喝什么红牛，必须要头悬梁锥刺股。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"趋利避害是所有生物的本能，但中国文化里都有点病态的趋害避利了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"这个话题很有争议，我的观点是\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"Pain is inevitable, Suffering is optional.\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"如何理解这句话，就见仁见智了，每个人对pain与suffering理解不一样。对待吃苦，应该是勇往直前的面对一切pain,而不是不假思索的选择冲向所有的suffering.\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"现在哪个成功人士站出来都是:”我吃了多少苦，才获得今天的地位啊，根本不是运气好，也不是我爹比你爹强，也不是我更聪明，就是我更能吃苦。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\n        \"h2\",\n        { attrs: { id: \"在中国式思维里-吃苦就是成功的充分必要条件。\" } },\n        [\n          _c(\n            \"a\",\n            {\n              staticClass: \"header-anchor\",\n              attrs: { href: \"#在中国式思维里-吃苦就是成功的充分必要条件。\" },\n            },\n            [_vm._v(\"#\")]\n          ),\n          _vm._v(\" 在中国式思维里，吃苦就是成功的充分必要条件。\"),\n        ]\n      ),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"王健林一出来，就是我吃了多少苦，一步一步走过来，多不容易。你儿子吃苦了么？难道现在不成功。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"马云一出来，就是年轻人要吃苦。先不管真假，爱看的人一大堆。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"撒贝宁一出来，北大还行，我没吃过什么苦，嘘声一片。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这还不是首富爸爸们开的头。司马迁大概以为《史记》是因为宫出来的，还不快谢主隆恩？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"圣贤孟子亦如此\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\"故天将降大任于是人也，\"),\n          _c(\"strong\", [_vm._v(\"必\")]),\n          _vm._v(\n            \"先苦其心志，劳其筋骨，饿其体肤，空伐其身行，行弗乱其所为，所以动心忍性，曾益其所不能。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"难道因为每年被饿其体肤一个月，绿军才能接受圣战的大任么？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人家拍电影社交网络，就是喝酒开趴，直指人生巅峰。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"中国合伙人总是要刷那么几个碗。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比尔盖茨哪个吃过苦，就算吃过，有在西方社会广为传颂么？有自己挂嘴上天天吹么？但是世界名人的吃苦经验被中国的故事编来编去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"谈起贝多芬，都知道双耳失聪，却少人知道他惊世骇俗代表作的名字。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"谈起罗斯福，都知道是个瘸子，却少人知道他在外交场上的叱咤风云。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"谈起霍金，都知道是个残疾，却少人有时间捡屎。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"西方很多伟大的科学家，奠定现代科学基础的人，大多都是贵族，是何不食肉糜的公子哥，更不要说吃苦了。吃苦很重要，但在世界范围内并没有像中国思维里那么强调。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"身体有缺陷的人那么多，为什么偏要拿人家残缺的那部分说事，伟人们真正的闪光点在中国的伟人故事里完全被掩盖。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"人家讲创造力，我们讲吃苦。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"人家讲执行力，我们讲吃苦。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"人家讲深谋远虑，我们讲吃苦。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"人家讲目光敏锐，我们讲吃苦。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"人家讲策略，讲时运，我们还在讲吃苦。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"吃苦耐劳已经成为了中国人的精神标签。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"不是说吃苦耐劳不好，那么多成功的重要因素，在中国式思维里吃苦是第一位。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中国人就喜欢搞的别人能吃五根苦瓜，我只能吃三根，人家就应该比我强。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我就要工作到两点，我就是能吃苦，管我效率高不高。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我有钱买鱼给我妈吃，但我就不去买，我要卧冰求鱼。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"中国人专注吃苦三千年，一直在吃苦，从未被超越。\"),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"狄马勇于挑战权威，抗拒时流，血性却不失清明理性。[赞]\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"历史上更多的是多难灭邦，幸存者偏差罢了，鸡汤最大的问题就是在于在冷酷的物质世界中总是最大化地画着大饼，让你相信很多不可能发生的事情容易发生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没错！真是这样。区别仅仅是，印度人觉得这辈子吃多少苦，下辈子享多少福。中国人觉得年轻时吃多少苦，老了以后享多少福。一个不知道有没有下辈子，一个不知道累病了老了以后得吃多少药。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"印度也是宣扬这一套，你这辈子吃多少苦，下辈子就享多少福，但是从中国人的角度来看，这就是赤裸裸的宗教洗脑，让底层人民认为吃苦是应该的，吃苦是好的，吃苦是福报，那么从从外国人的角度来看我们，是不是也是这样？估计是的，外国人追求的是享受，事实上人家确实比我们过的好，吃苦在中国已经成为了一种政治正确，每个人都必须吃苦，你吃甜你就该死\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACNA,EAAE,CAAC,QAAQ,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,CAC/C,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACA,EAAE,CAAC,QAAQ,EAAE,CAACD,GA