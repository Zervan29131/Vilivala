": _vm.$parent.slotKey } },\n    [\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"一个致力于研究社会现象的学者，是不需要考虑他的想法是否会触犯到一些利益的。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"群体的时代\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#群体的时代\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 群体的时代\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体的某些特征，如冲动、易怒、缺乏逻辑推理能力、不具备判断和批评精神等，我们注意到在仍处于进化的低级形式的生命中同样可以看到，比如女人、野兽和孩子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"群体心理\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#群体心理\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 群体心理\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"群体的冲动性、多变性和易怒性\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#群体的冲动性、多变性和易怒性\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 群体的冲动性、多变性和易怒性\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体是由他的潜意识来指导其从事各种活动的，他的行为更多的是受其情感冲动影响，而不是理性控制的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"群体所屈从的情感冲动是多样的，能根据外物的刺激作用而变化，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在群体事件中，任何事情都不是预先策划好的，他们总是能从感情的一端走向另一端。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群体的多变性是他们很难被管理，尤其当他们掌控一部分公众权力的时候。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"群体的暗示性和轻信盲从性\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#群体的暗示性和轻信盲从性\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._