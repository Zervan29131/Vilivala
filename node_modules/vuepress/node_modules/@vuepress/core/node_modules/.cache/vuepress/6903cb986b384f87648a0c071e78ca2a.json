_vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"几条言灵讲出了一条社会主义核心价值观\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_003言灵-弑君\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#_003言灵-弑君\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 003言灵：弑君\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“我猜你这辈子就没见过什么真正的贵族吧。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“是的，毕竟君主制不能永恒。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"言灵发动时产生一把元素之剑，将对一切实力超越自己的一切君主造成巨大的伤害，实力差距越大，伤害越大。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"敌人实力越弱攻击的力量越小。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"被动:  当自己成为新的君主时，此言灵将自主发动毁灭自己，一把双刃剑，一面对着敌人，一面对着自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"此言灵可继承，使用者死后，将会由使用者交给被指定的人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_002言灵-信仰\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#_002言灵-信仰\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 002言灵：信仰\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的幸福将属于千百万人，我们的事业将默默地、但是永恒发挥作用地存在下去，面对我们的骨灰，高尚的人们将洒下热泪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"发动时你将燃烧生命得到一个坚固无比的护盾，这世上一切的伤害都不能作用于你，不能阻止你的行动，直到你生命的终结。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在历史上该精神系言灵发动的人数最多，因该言灵而死的人也是最多的。言灵不能通过先天得到，必须后天才可拥有。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_001言灵-平等\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#_001言灵-平等\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 001言灵：平等\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"王侯将相，宁有种乎？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"言灵发动时产生场域将把一切所谓血统至上的存在压制到与你一般的层次，一切依仗外物的存在都将被剥夺掉光环而与你平等一致。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"此言灵将永久的压制剥夺场域内的存在血统，无论血统等级多高，都将压制到与自己一般的层次，曾在历史中多次出现过。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_000言灵-幽灵\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#_000言灵-幽灵\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 000言灵：幽灵\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一个幽灵，不可知的幽灵，在欧洲游荡。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为了对这个幽灵进行神圣的围剿，旧欧洲的一切势力，教皇和沙皇、梅特涅和基佐、法国的激进派和德国的警察，都联合起来了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这是目前可以观察到的最伟大也是最强大的言灵，不同于弑君、信仰、平等的能力，这种言灵是之前一切言灵的总和。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"言灵本身就是幽灵，这种言灵由几百年前的弗拉基米尔发动，化身为幽灵使用弑君砍掉法国君主的头颅，又在俄罗斯使用弑君毁灭沙皇的统治，使用信仰让前苏联的战士战无不胜，攻克柏林。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最后一次观察到幽灵的存在是在中国，发动弑君、信仰和平等之后便消失不见，历史上也曾有过消失的时刻，但总是又会出现，我们认为幽灵或者说言灵，寄生在大量生命体中，因此总是可以死灰复燃般的出现。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种幽灵最大的能力除了以上几个之外，是可以将一切生命体的思想转化为自己的思想，被转化的生命体将自动拥有以上三种言灵。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们曾有机会阻止这种言灵的发动，但却因为很多原因没能阻止，我们曾对它发动围剿，反而使它变得更加强大，我们中内部，一定有被言灵寄生的人，必须要清除出来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这三个言灵中任意一言灵的人，一经发现就要被绞杀，甚至还等不到成长就扼杀在摇篮里。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"资本家们靠无穷的财力和优越的血统在战斗中占尽优势，金钱，权力，包括像舆论这样超级武器都掌握在他们手里，不被外界知晓，肆无忌惮的垄断，无比风光。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是有一天，言灵拥有者出现了，告诉他们在这个世界里，不单纯倚仗血统，靠自己的努力也能向无穷无尽的高处奔跑。他们一定会慌张，绝对不可能任由这样的事发展。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"世界上或许还会存在力挺这种言灵拥有者的人，但他们再厉害，也斗不过那么多被动了利益核心而疯狂绞杀那个人的资本家。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而且言灵的拥有者也大多来自大资本主义上层社会的小姐和少爷，为了家族利益和自身发展也一定会有大部分人和家族里应外合，共同对抗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"甚至不给那个人成长机会就扼杀在摇篮之中，不敢说所有人都会这样做，但大部分资本家都不会容忍阶级秩序重组的事情发生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就算不绞杀力保的，也不排除有自己的心思和想法，想要利用那个人。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,EAAE,EAAE;IAAY;EAAE,CAAC,EAAE,CACvCN,EAAE,CACA,GAAG,EACH;IAAEO,WAAW,EAAE,eAAe;IAAEL,KAAK,EAAE;MAAEM,IAAI,EAAE;IAAa;EAAE,CAAC,EAC/D,CAACT,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDN,GAAG,CAACM,EAAE,CAAC,WAAW,CAAC,CACpB,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,gBAAgB,CAAC,CAAC,CAAC,EACnCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,C