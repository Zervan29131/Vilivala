this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"在所有浪漫中，关于「宇宙」的浪漫总是史诗级别。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"其实分别也没有那么可怕。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"65万个小时后，当我们氧化成风，就能变成同一杯啤酒上两朵相邻的泡沫，就能变成同一盏路灯下两粒依偎的尘埃。宇宙中的原子并不会湮灭，而我们，也终究会在一起。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在遇见你之前，我觉得世界上最宏观的美好就是宇宙，从本质上来说，我们和这些星尘没有差别，我们都是恒星的孩子，也是宇宙的孩子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但是遇到你之后，我发现，一朵沾染泥土的玫瑰也是美好的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"微观之美，同样震慑人心。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我终于等到这一天的时候，我开始纠结了，因为无论是宇宙还是玫瑰，我都想给你。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"NGC2237号玫瑰星云，一朵永远不会枯萎的玫瑰，是藏在这宇宙中我对你永恒的浪漫。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这朵世间最好的玫瑰，星辰为泥，银河滋养。永远不会枯萎，永远在沉静宇宙中盛放。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"今天春天的发现：一只宇宙蝴蝶正在用星际气体和尘埃组成的翅膀振荡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"天文学里有个定义，叫洛希极限。行星和卫星会因为万有引力不断靠近，但他们之间有个保持安全的最短距离，一旦超过洛希极限，潮汐力会把那颗卫星撕碎。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然后那颗已经粉碎崩塌的星球会.化作星尘，渐渐地聚拢在那颗行星身旁，演变成一个环，将那颗行星环抱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个很有趣的知识点，地球上的贵金属元素大都来自超新星爆炸，也就是说，我们身上穿戴的贵金属装饰品，其实是宇宙报废掉一颗至少比太阳大八倍以上的恒星换来的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们不过是宇宙中的尘埃，而我们佩戴着的却是璀璨的星辰。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的故作深沉，我们想象出来的自我重要性，我们以为自己在宇宙里有什么特权的错觉，一直被这颗发着微弱蓝光的小点挑战着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的这颗星球，是一粒孤孤单单的微尘，被包裹在宇宙浩瀚的黑暗中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在我们有限的认知里，在这一片浩瀚之中，没有任何迹象表明救助会从别处而来帮助我们救赎自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们抬头看时，总是觉得星星遥远，但其实宇宙大爆炸时形成的原子就是形成我们身体的原子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以星星并不远，因为我们就是星星本身。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于某人来说，你就是宇宙的中心一就像小麦哲伦星云一样，你散发着整个宇宙的光芒，帮助他们找到方向。虽然你可能并没有意识到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你身体里的每一个原子都来自一颗爆炸了的恒星。形成你左手的原子可能和形成你右手的来自不同的恒星。这是我所知的关于物理的最有诗意的事情“你们都是星辰”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也许几亿年甚至几百亿年后我跟你都化作尘埃在另一个星球上遇见在广袤的宇宙空间里我们其实很近很近。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“我们与那些遥远星系息息相关，无论它们是如何与我们天各一方，那些经过数十亿年旅行到达地球的光线，终究会把我们联系在一起。” 想到这里，好像孤独也没有那么可怕了，反而还有点浪漫，真好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"最后一句，“宇宙这个词什么也不加就很浪漫。”\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,yBAAyB,CAAC,CAAC,CAAC,EAC5CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8EACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,+