key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"人们经过长期的科学训练，思想高度同化，在前沿科学的领域中，灵感就会被大幅度抑制。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这似乎是一条悖论。如果你感到自己很有天赋，想接触前沿科学，那你就要接受长期科学训练，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而科学训练可能使得你的灵感抑制了，等你成为科学家时已经没有灵感了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"目前的科学界已经意识到这个问题，所以鼓励批判性思维，鼓励不迷信权威，这能够在很大程度上减小抑制。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"至于是否能够彻底解决抑制，那可能是无法做到的，而且做到似乎也没有太大意义。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即使不是研究前沿科学的人，普通人也不可避免地受到科学思想的影响（在生活中接触科学思想、科技产品等），这些思想也可能会抑制人们各个方面的灵感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"更恐怖的是，科学已经深刻改变了整个世界，要想完全摆脱科学的影响是不可能的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"再进一步，我们其实面临很多抑制，这些抑制其实都是我们改变不了的，我们更应该做的是反思如何看待它们。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"既然科学思想能够成为主流也就不会过于抑制发展。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"换句话说，抑制是发展过程的一部分，我们不必担心由于抑制而陷入绝境。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"宇宙的发展就是这样，不会使一种思想完全统治世界，然后造成无法摆脱的抑制。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就像爱因斯坦学习了经典力学，按理说思维已经高度同化了，所以想不到不同的理论。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"事实是，即使学习了也不会完全同化，他仍然保持着一定程度的客观的怀疑态度。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"统治者的专制无法长久也是如此，总会有一些人不认同专制。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这也表明了社会达尔文主义是不可取的，因为人类不知道哪种