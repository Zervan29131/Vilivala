trs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"「报效国家，服务社会」\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"报效国家，服务社会，报效的是哪个国家，服务的是哪个社会?\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在顶级学府学就一身本领， 然后报效美国吗?\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"社会污浊不堪的时候，譬如汪精卫政府，你也要去服务吗?\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"自然，我们现在的国家和社会是值得报效和服务的，但是我们一味倡导报效国家和服务社会，可以确保遵守这一条的人有足够的辨识能力吗?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"「人生苦短，及时享乐」\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人生苦短是说我们的人生是有限的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而快乐是什么？是唱k蹦迪吗？这是低级趣味，是虚假的快乐！\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真正的快乐是在劳动和实践中获得的充实感，是为了共产主义事业、人类解放而奋斗终生！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因此，及时行乐就是在有限的生命里，追求自己的理想与最高的价值，从而达到发自真心的愉悦。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"「马克思主义、中国特色社会主义是否正确」\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"马克思主义、中国特色社会主义是不对的吗？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我不这么想，可是那些西方媒体正在质疑这件事。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你们只会用政治正确来压制这些质疑，却不曾回应过其他理论对它的质疑。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们的理论体系要怎么创新和发展呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的理论之所以能向前发展，不正是在回应像这样的质疑时，展现它的深度、焕发了它的活力吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们不是来分对错的，是来向大家展示我们理论文化制度的优越的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果没有这些，我不明白，我们之间的辩论，你要干什么，我们要干什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"追求真理\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#追求真理\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 追求真理\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"两个聪明人一起讨论问题，彼此很快就能意识到哪些认识会出现分别是因为讯息的不充足，哪些是因为价值的取向不同。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果是把讯息归入自己的知识框架内进行二次诠释，往往就依赖自己的专业知识，心理学、经济学、逻辑学、社会学...以及个体的社会实践所总结出来的经验，这种诠释就有了附加的价值，可以让人从更高的角度来审视现象。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而进一步，两者能迅速放弃下游阶段的讨论而迅速攀升去探索元命题，重新从源头处梳理彼此的分歧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这就到了哲学的层面。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是有意义的，可以理解为在追求真理。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但这种讨论对双方的默契要求极高，我要懂得你在说什么，你也要懂得我在说什么，我们默契地不打断，互相梳理问题展开更广阔的图景。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这就不是辩论了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"辩论更像是拳击比赛，在击倒对面的同时自己站得稳当则获得比赛胜利。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"纯粹的技击观赏性一般不如意，追求的只是最快地打倒别人，谈不上追求什么真理。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,aAAa,CAAC,CAAC,CAAC,EAChCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,8BAA8B,CAAC,CACvC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,