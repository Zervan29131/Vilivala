{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/12.疯子人设.md?vue&type=template&id=56271806","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/12.疯子人设.md","mtime":1768579404271},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/12.疯子人设.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"‘疯子’在所有人设中都是一个很特殊的类型。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在所有的人物塑造中，疯子人设是最特殊的一种类型。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"首先要明确一点，疯子并不是单独的某一种人设，而是一个宽泛概念。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"最简单的划分：病理学疯子’和‘思想性疯子\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"病理学的疯子很简单，因为某种精神亦或者是生理疾病而产生的疯子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这一类疯子人设是从精神病学的案例中寻找模板，然后进行艺术性的加工（夸张处理）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"举个简单的例子，‘创伤性应激障碍’算不算疯子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"单纯从行为表现上来看，只能说他有一定的心理疾病，但距离文学作品中的疯子还相去甚远。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但如果我们将其进行一定程度上的夸张处理呢。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如一个和平的市区中住着一个总是身穿军服，家里常备重火力，会在自家小院里埋反坦克地雷的退役老军人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果这个角色每晚会定时巡视，遇到人总是一副‘命令’的严肃口吻，早晨散步时会跟邻居敬礼。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个时候一个大致的疯子人设就建立起来。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"剩下的只是给他一个故事，加深这种印象，甚至根据他的人设特点安排一些过激的反应。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种利用模型进行艺术性加工的人物塑造方法，基本适用于所有病理性疯子的塑造。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但你需要记住，精神疾病只是诱因。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"小说中的重点应该是表现人物行为，以及行为带来的结果。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要想着只要提一嘴这个人有精神分裂，就能塑造好一个疯子了，这只是给角色打上了一个标签。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你要具体的表现出来，比如这个人物会在卧室里自己跟自己对话，比如在生活中突然翻脸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"思想性疯子的塑造则要从另一个方向找模型，这个方向是人物背景。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"一个人的思想不可能是无根浮萍，一拍脑门就在菩提树下悟道。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这么去塑造人物，读者不信，人物也没有行为的支撑点，让人无法代入，无法认同。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所以如果你要展现一个人思想，就要先从这个人的经历去入手。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"假如我们要塑造一个理想主义的疯子，最简单的方式就是让这个人物的精力充满黑暗色彩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"遭受过霸凌，暴力，威胁，生存简单，命运不公。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但不能只有黑暗，完全的黑暗是没有方向的，是混乱的，相比于理想主义者，更容易塑造强盗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以在黑暗的遭遇中你要给这个人一丝希望。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"可以是母亲，可以是恋人，可以是朋友。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这能让角色看到一条名为理想的方向，他才能有憧憬，有动力。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但至此，他还只是一个有行动理由’的‘理想主义者，不够疯狂。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这里插一句题外话，另一种理想主义的塑造是虚假的理想主义，简单的说就是何不食肉糜。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虚假的理想主义者人物在小说中是一般用来‘梦想破灭’的，反差呈现现实残酷性的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"话归正题，一个纯粹的理想主义者想要疯狂起来，最常见的方式就是让他极端化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这在剧情中我们需要设计一个爆点，反转整个人物的形象。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如让这个人物遭遇巨大的不幸，希望的破灭，由此走向一种极端化的理想主义。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"能够做到这一步时，一个理想主义的疯子形象便已经成功得以塑造了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"接下来的重点同样是行为的刻画，利用情节交代新人设。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这里的重点是突出前后反差表现人物疯狂，作者要找到一个感觉这个人被逼疯了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"想办法将这种感觉传递给读者，哪怕利用其他人的对话进行直接的告知都可以，但一定要传递到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"通过上述所述，可以看到这里面反复在提一个关键词模板。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这里可以用更通俗一些的说法，人物原型。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"疯子的人设跟其他普通人设的最大区别在于反常识，这对作者来说也是一件难事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"因为既然是反常识，那必然是普通人无法理解的行为。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"除非作者本人就是一个疯子，否则很难去理解一个疯子的心理变化和行为逻辑。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以在疯子的塑造过程中，找到人物原型便是重中之重。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人物原型可以不是单一人物，而是许多形象的缝合，融合出一个全新的人物模板。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不过从实际操作角度上来说，缝合怪属于玩花活。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"单一原型更容易刻画，更容易写出真实感，更容易获得读者的认同和代入。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"简单的东西不意味着效果就会差，复杂东西不一定效果就好，这是根据剧情需要来决定的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"确定一个原型人物之后，我们要研究这个原型。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"注意，不是研究这个人的心理变化，思想内涵，而是研究他的行为，动作，眼神，语气。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们要从中找出一些‘正常人不具备’的行为特点。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如，这个人物如果是在笑的话，他的笑声会跟常人有什么区别，他会有哪些罕见的习惯性动作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果这个人物身材矮小，却总喜欢站在高出，居高临下的看人，这会给读者怎样的联想。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果这个人物看起来很温和，但却重视在交谈时对方是否与他对视，这又表现什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人物喜欢舔手指会怎样，一个人物话语中总是引用一句莎士比亚的诗句会产生怎样的观感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果更具体一些，一个人在路边捡回来一只受伤的小鸟，悉心照顾，等到小鸟康复后经常带在身边，但有一次他跟主角交谈中，主角说错了一句话，他毫无征兆的突然掐死了手里的小鸟。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这些行为，动作，神态特点，往往会更深刻的体现出一个人物的形象。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果要设计一个疯子，不管什么类型的疯子，首先要设计的便是他的习惯动作和口头禅。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们需要通过一些反逻辑反常识的特点，表现这个人物的疯狂。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这不是为了故意耸人听闻，而是要借助耸人听闻去向读者传递人物身上的关键信息。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你得重点描写一些表现疯子特质的行为，比如这人喜欢鞭打尸体。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"让读者意识到这人是个人疯子而不是这人有神经病吧。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"前者是一种观感，后者是在骂人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这两种联想之间的区别还是蛮大的，他们的区别在于一个取信了读者，一个则是完全不认同。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"反常但合理，才是疯子，反常但不合理，就是脑子有问题。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"寻找原型，提炼特质，夸张处理，表现行为，阐述疯狂，这些便是塑造一个疯子的步骤。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他不需要你一口气全写出来，而是穿插在剧情中，发生在场景里，表现在对话中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他们特立独行,他们桀骜不驯,他们惹是生非,他们格格不入,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他们用与众不同的眼光看待事物。他们不喜欢墨守成规,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他们也不愿安于现状,你可以认同他们,反对他们,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"颂扬他们或是诋毁他们,但唯独不能漠视他们,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"因为他们改变了寻常事物,他们推动人类向前迈进,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"或许他们是别人眼中的疯子,但他们却是我们眼中的天才。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"因为只有那些疯狂到以为自己能改变世界的人才能真正改变世界!\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"送给那些疯狂的家伙们\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他们特立独行，他们桀骜不驯，他们惹是生非，他们格格不入;\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们用与众不同的眼光看待事物，他们不喜欢墨守成规，他们也不愿安于现状。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以赞美他们，引用他们， 反对他们，质疑他们，颂扬或是诋毁他们，但唯独不能漠视他们。因为他们改变了事物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们发明，他们想象，他们治愈，他们探索，他们创造，他们启迪，他们推动人类向前发展。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"也许，他们必需要疯狂。你能盯着白纸， 就看到美妙的画作么?\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你能静静坐着，就听见美妙的歌曲么?你能凝视火星，就想到神奇的太空轮么?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们为这些家伙制造良机。或许他们是别人眼里的疯子，但他们却是我们眼中的天才。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为只有那些疯狂到以为自己能够改变世界的人，才能真正地改变世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"好，希望未来的某一天，你也能有机会成改变世界的人，引领着我们这个时代的前进。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAA