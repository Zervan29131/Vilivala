his,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"投资是认知的变现\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#投资是认知的变现\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 投资是认知的变现\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以，要赚钱，不是要靠信仰，而是要靠认知。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"关于认知，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"《好奇心：保持对未知世界永不停息的热情》（作者：伊恩·莱斯利）\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"《知识大迁移：移动时代知识的真正价值》（作者：威廉·庞德斯通）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这两本书，严肃地讲，是在关注“低水平认知者的自我认知问题”。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"低水平自洽\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#低水平自洽\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 低水平自洽\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我有一个朋友，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个女生什么都不会，也不知道学习。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人也不白，也不甜（脾气倒不小），傻白甜三个字只能占1/3。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"说实话，我对她几乎没有好印象，学历不高不是问题，但是有一种摇头摆尾的无知，永远在原地踏步，人生所有问题都要依靠别人来解决。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"总结一下，就是：\"),\n        _c(\"strong\", [_vm._v(\"无知，但不知道自己无知，而且自我感觉良好\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不成长，是所有可能出现的问题里最严重的一个。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"阻碍好奇心的重要原因之一是过分自信，也可以理解为“无知而快乐效应”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"它让人以为自己知道事物的答案，从而不再对其他可能产生好奇。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我对傻子有一个工作定义：沟通成本极高的系统不健全者（俗称“傻逼”）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这里仍然延续这个比较写意的有关这种人的定义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"需要指出的是，这种人在人群中的分布并与阶层、学历的关联性不大。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在“低水平自洽”这个洞察中，又有两个惊人的推论：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"傻逼从来不知道自己是傻逼。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"知道自己傻逼，是变牛逼的开始。\")])]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"人贵有自知之明\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#人贵有自知之明\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 人贵有自知之明\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很多人都有这样一个观察：越是已经很厉害的人越有一种害怕落后的危机感，会通过学习不断自我提升；\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是越是蠢笨落后的人，越是摆出一副牛逼兮兮的样子，在洋洋自得中停步不前，始终无法走出傻逼的乐园。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多人还听说过这样一句俗语：人贵有自知之明。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这话的意思是说：正确的认识自我，是一件有着很高认知成本的事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以至于，那些本身认知匮乏的傻逼，付不起这种自我认知的成本。他们往往无知而快乐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"学习者必须掌握足够多的事实，才能对自己掌握的知识及欠缺部分心中有数。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你蠢到一定程度，你根本不知道自己有什么盲区；你必须有相当的智力，才能够意识到自己有多蠢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"大智若愚-大愚若智\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#大智若愚-大愚若智\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 大智若愚，大愚若智\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"罗素说：这个世界的问题在于聪明人充满了疑惑,而傻子却坚信不疑。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"只有在自身认知产生飞跃的前提下，才能意识到自己曾经是傻逼。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"把视野展开了说，生活就是一个不断发现自己以前是傻逼的过程。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"意识到自己是傻逼是一件值得庆幸的事情，真正的傻逼从来不知道自己是傻逼。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有一句清新隽永的名言，是这样讲滴：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"在牌桌上，假如你不知道谁是傻逼，那你就是。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"很多人终其一生的命运，都是\"),\n        _c(\"strong\", [_vm._v(\"在低水平认知的世界里难以破局\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"意味着那人终其一生，没有考虑过“你认为多长时间之前的自己是个傻瓜？”这个问题，没有过这种自我革新的强烈感受，成为一个至死不渝的傻逼。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"格物致知\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#格物致知\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 格物致知\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我们被迫把时间花在乏味的事物上时，是否想过，把这些平常的事，变为能激起好奇心的事？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一方面，如果我们必须投入时间，那么别轻易浪费了时间，让自己在无聊中度过。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"另一方面，如果我们开始对它们感兴趣，就会更乐意投入时间。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"质疑司空见惯的事情，这其实就是儒家一直讲的格物致知\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"其次，是对很多司空见惯的概念保持敞开和自我代入的状态。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"概念是我们展开认识和逻辑思考的基本材料。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"首先是对基本概念的深入认知，做到这一点的前提，是假定每一个底层观念都与自己有关。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不仅要“只字不差地阅读”，还要“反复阅读”，因为最底层的观念常常披着“简单”的伪装，以至大多数人觉得无所谓，觉得自己已经理解了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为觉得很多重要观念与自己无关，而生生错过自我升级的机会，这样的事情在我们每个人身上都不知发生过多少次，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很多道理我们以为自己都懂——比如努力、奋斗，比如不抱怨，比如与人为善。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但其实根本没有写入我们自己心智的底层代码，在知行合一的角度上，如果做不到，说明根本不知道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"仅仅是“以为某些观念于己无关”，就可能让一个人永远生活在另外一个“自洽的世界里”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这样的底层观念其实有很多，四书五经、宗教经典、先哲语录里的很多凝练表达都是这样，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"格物、致知、诚意、正心、修身、齐家、治国、平天下\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"孝悌忠信礼义廉耻\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"布施、持戒、忍辱、精进、禅定、般若，佛教六度\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"主意、明理、信实、响亮、柔和，王树桐五词\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最要命的是，很多重要的观念会伪装成“让你觉得它和自己没有关系”的样子，使你生生错过且不自知。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，你不仅要读，还要反复读；不仅要反复读，还要先假定每个观念都和你有巨大的关系，再调动所有的感官为自己创造“带入感”，去琢磨、去研究、去想象：这个观念若被你吸收，你应该变成什么样子？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，即使这样苦口婆心、掏心掏肺，很多人依然会觉得，这和我无关。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAW;EAAE,CAAC,EAAE,CACtCL,EAAE,CACA,GAAG,EACH;IACEM,WAAW,EAAE,eAAe;IAC5BJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAY;EAC7B,CAAC,EACD,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,WAAW,CAAC,CACpB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,OAAO,CAAC,CAAC,CAAC,EAC1BT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CAAC,iCAAiC,CAAC,CAC1C,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,kCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,IAAI,CAAC,EACRD,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAQ;EAAE,CAAC,EAAE,CACnCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAS;EAAE,CAAC,EAC3D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,QAAQ,CAAC,CACjB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,SAAS,CAAC,CAAC,CAAC,EAC5BT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAA