 = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"米鸿光\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#米鸿光\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 米鸿光\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一个社交能力很强但是讨厌社交的人，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"可以对一个素不相识的人伸出援手，甚至可以说是爱心泛滥。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为了使自己不会很特殊，来使自己变得合群，甚至是积极主动的和人交流。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是从未有人能够走进他的心里，渐渐的，米鸿光伪装不起来了，开始变得不想讲话。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有精神洁癖，会不注意的去关注社交圈子里的细节，即使某个人的举动并没有打扰到他，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如只是让他觉得这个人的行为很不礼貌，但这个人不自知，就让他很不舒服，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但因为和这个人平时在学校里走得相对来讲比较近，害怕突然的不理睬会伤害到他，所以一直在克制自己，强迫自己接触。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他又开始不自觉的去观察身边人不太好的方面的举动，越观察越觉得难受，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为他发现身边的人在公共场所内比如寝室里，走廊里不为其他人考虑，为所欲为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这些可能对其他人而言非常细微，但却在他眼里被无限放大。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"米鸿光并不想与这些人接触，因为这会让他觉得常不自在。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他不想和这些人交流，但这不现实。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他每天都想毕业，远离这里。然后去做一份社交非常少甚至不需要社交的工作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他越来越沉默，话越来越少。不熟悉他的人甚至会觉得他很反常。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他开始偷偷的单独行动，不去约任何人一起做事情。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他又开始了像以前一样的生活，一个人的时候占了大部分时间。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他可以坐在那里十几个小时不和人交流。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这并不是他突然变得冷漠，只是在他看来，目前身边的人没有值得结交的人，那些被称作朋友的人，也仅仅只是“朋友”而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"米鸿光回归到了最开始的状态，这并不是突然变得冷漠。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAM;EAAE,CAAC,EAAE,CACjCL,EAAE,CAAC,GAAG,EAAE;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAO;EAAE,CAAC,EAAE,CACjER,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACZ,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,MAAM,CAAC,CACf,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CAAC,6BAA6B,CAAC,CACtC,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,wDACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,C