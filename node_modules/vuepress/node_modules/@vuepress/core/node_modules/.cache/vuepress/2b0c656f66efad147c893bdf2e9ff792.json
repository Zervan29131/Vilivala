{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/11.短篇的张力.md?vue&type=template&id=040f259e","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/11.短篇的张力.md","mtime":1768579404252},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/11.短篇的张力.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"短篇的张力\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#短篇的张力\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 短篇的张力\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要提及故事人物背后的动机，当你尝试解释人物的动机，你的读者就出戏了。\\n你只要把人物展示出来，让读者自己去理解人物。\\n设计主人公时，其他人物会引出主人公不同的性格维度（冲突，内在的心理冲突）。\\n但必须要知道，配角的性格维度不能和主角一致。\\n当一个人物评价另一个人物时，读者会把他放在口袋中，然后等着观察，这是吸引读者的一种方式。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"好的人物创造都是来自自知，都是从自己身上发现的，越能了解自己，就越了解人性，就越能创造出好的人物。\\n作者要热爱自己笔下的每一个人物，但是你永远不会像了解自己那样了解别人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"写作是非常困难的事情，需要有极高的智慧。\\n作者需要了解这个社会的方方面面，必须能够讲故事，能够进入人物的头脑。\\n而人物的情感是触发故事戏剧张力最重要的因素。\\n情感有快乐感和痛苦感两种。这两种情感的转折则来自价值的转折。\\n首先读者要对人物认同，产生有情感时，人的身体也会有反应，达到顶点后会放松然后回到平衡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"情感是短暂强烈的，情绪却是一直存在的。\\n感觉把我们的生活具体化，感觉把情感具体化。情绪就是感觉并让情感具体。\\n但情绪不能代替情感，表达情感要把人物放在选择中，但如果选择太简单，仅是善恶、对错等，读者会比人物更快知道他的选择。\\n要让人物从自身的角度去选择，就要从人物的人性去思考，无论人们做什么都会认为从自己的角度来看是正确的。\\n当把人物置于两难的选择，让他从自己的视角去两害选其轻时就会让故事具有戏剧张力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"好的故事往往会在两个选择之外设置另外一个。\\n故事进展的节奏要像性爱一样，张弛有度，统一性和丰富性相结合。\\n如果想要通过重复来积累情感，只会适得其反，多样性要靠调查来积累。\\n重要时刻要缓慢得展现，营造张力，强调接下来的转折。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而让故事具有戏剧张力的秘诀在于故事中的负面力量。\\n负面力量并不特指某个坏人，而是是生活中所有力量的总和。\\n在故事开始前，把所有主人公的力量：意志力、创造力等等放在左手，把所有负面力量：社会、人际、自然等放在右手。\\n这样可以看出我们的主人公总是在下风，他的机会在负面力量的对比下显得微不足道。\\n如果负面力量不强大的话，主人公就没有必要变成另外一个人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"犯罪是在告诉你这个世界发生了很多不好的事情，世界上最大的罪是由政府犯下的，邪恶的社会会让人祈求自己死亡的来临。\\n把负面力量隐藏在故事线后或隐藏在人物内心中来实现冲突。\\n越深入人性，越有可能制造强大的反抗力量，就越有可能把故事推向极致。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"要在高潮本身中制造期望和结果的鸿沟，制造转折点，让主人公不断面临选择。\\n选择比行动困难，而变化让选择变得更难。\\n故事就是要讲述生活的变化，所以我们要从深层次理解变化。\\n这个变化往往就是故事的核心价值。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人物的每一个设定都要给它一个回应，要给读者他们期望的东西，但不是用他们能想到的方式。\\n读者真正想要的是情感的满足体验，而不是什么类型的结局。\\n意淫的意思是隐藏事实，这并不是转折，转折是要发生变化，隐藏事实的做法并没有让事实改变。\\n最后的高潮要结合两个东西：奇观和真相。用情节而不是解说来能揭示故事的意义。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAQ;EAAE,CAAC,EAAE,CACnCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAS;EAAE,CAAC,EAC3D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,QAAQ,CAAC,CACjB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,0KACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,wFACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,+JACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,iNACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,oHACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,oLACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,yHACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,yGACF,CAAC,CACF,CAAC,EAC