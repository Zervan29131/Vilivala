{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/13.林嘉文传.md?vue&type=template&id=11fbb9ac","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/13.林嘉文传.md","mtime":1768579404266},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/13.林嘉文传.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"叹未遇弦音而又入轮回，愿在六道得闻此弦\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"—— 一弦者，孤弦独抚\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“相信有不少拒绝虚伪、庸俗和丑陋的人，会与你们惺惺相惜。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但我实在害怕你们这样可爱的人一个接一个的赴死，反倒留下那些丑陋存在于世。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我不敢说我能形而上地说服你们活下去，我只能说一说我为什么还要活下去。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理想主义的殉道，将其解释成玻璃心本就是证明了今天我们这个社会已经容不下任何的理想主义者了，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"就犹如一堆杂草中的一朵“奇葩”，不被这个社会所容纳，所理解。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一切美好的价值观都只能被这个所谓的美好社会践踏，普通人明知自己所作所为，但却无力无心去改变，选择苟活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"绝大部分连基本的是非观，对错观都已消失，甚至连思考这些价值观的能力都已丧失，而我们连对这种巨大的荒诞迷惘的心情和时间都没有了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个理想主义者，虔诚的基督徒和真正的爱国主义者，在道德上追求完美之人，最后只能选择肉身自我毁灭，与这肮脏世界彻底割裂联系，令人扼腕。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一位理想主义者看到自己生命的激情已经燃尽，一位虔诚的教徒看到自己的信仰受到了玷污，一位爱国者看到自己所爱之国无比腐烂，死前将其比作最后衰落瓦解的奥斯曼土耳其，想必心已冷，生无所恋。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们活的这个时代，既没有传统中国儒家的士大夫精神，没有克己复礼的自我克制能力；没有毛时代对乌托邦的无畏追求，更没有西方的契约精神。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于一个追求无限和完美的人来说，无论怎样都无法在一个现实的世界里实现这一完美目标。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们虽然仍旧可以且应该尽量去争取更好的社会与个人生活。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但同时却还应该能够容忍缺陷，容忍不足，也包括对生活、对他人、对社会、也对自己作出一些妥协。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这个时代、这个世界可能已经有点不太适合有些人的存在，甚至可能越来越不适合。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"少了这样一些人，目前的世界外表可能会更热闹，但内心也会更寂寞。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"的确，有些人的弃世并不是一时的、草率的轻生。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而是一对人生压抑的沉重推动人们思考生死去留。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们最终的离去不仅是感性地对抑郁、孤独的排解，也是种变相地对理性思考之成果的表达。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人一定要赴死，大概是因为这个世界已经没有多少让他感到能够留恋和向往的东西了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有些人会突然看到自己职业的尽头，知道它最好也不过是一种什么样的生活，于是可能放弃某些利益而改变自己的职业。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但有些人则是看透了自己人生的尽头，而这尽头处的景色完全不能吸引他了，于是他放弃了人生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"林嘉文写道：“未来对我太没有吸引力了。仅就世俗的生活而言，我能想象到我能努力到的一切，也早早认清了我永远不能超越的界限。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他认为他的自杀是对他自己理性思考之成果的表达，未来对他没有吸引力，仅就世俗的生活而言，他能想象到他能努力到的一切，认清了自己无法超越的界限。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从后面的描述中，他的自杀大概还有两点主要原因：对周遭社会的厌恶，不能接受自己的庸碌。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即使是做自己唯一钟爱的历史研究，在他眼里也将是庸俗的。原来这一切都源于对丑的排斥。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"除了外在的世界，世俗的世界，也还有内在的世界，有思想、学问的世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但这方面在他看来最终也还是绝望：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“无用的研究曾让我底气十足……每当我为活着感到疲惫、无趣时，对比之下，我总会自然地想去缩进历史研究的世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即便是做研究，也并非能让我拥有尽善的生活感觉，因为有太多虚假的‘研究’，还因为本质上少有其他人会对研究爱得纯粹。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人喜欢追索，哪怕是对任意领域的，都会受到现实的阻挠和精神的压迫。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他是接近高维的灵魂，是很难融入社会这个浑浊道场的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所有人都言其苦，但我猜想从孤独中看到了自我丰盛的人，总是不后悔来世间走这一遭的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“来世界转了一圈儿，不喜欢，很清醒的不喜欢，就先走了，就像默默离开一个没意思的饭局。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还好，他仍有随自己喜好做选择的自由。所以这并不是一个青年苦大仇深的一生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们从他的作品中真实地感受过他为此所倾注的热情和快乐，这是他对自己的成全。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他的灵魂是丰盈美满的，我们也因他留下的这些作品而富足。有损失的，是这个世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这里有对学历史研究的内在的限制：即很少有人会纯粹地爱这一学问；也有对历史研究的外在限制：即有现实的阻挠和虚假的研究。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是从事历史研究仍然不能拥有“尽善的生活感觉”，甚至拘泥在一门学问中的事业生活也是“很庸碌的”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他感到了内外的限制，看到了人生的尽头。 问太多、想太多是种折磨，因为这样的情况下人会很难活得简单肤浅起来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实仅就对做历史研究的想法而言，我只是想明白了心有天游，拘泥在一门学问之中，那样活着也是很庸碌的。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我想不只是林嘉文和我，很多人都有过这样消极的想法。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"就说我自己，很久之前，就已经有了对很多事情的厌倦。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"后来看到叔本华的书时，才会有那么强烈的共鸣。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"之后很长一段时间，我都在努力寻找活下去的意义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但如果真要为此而谈谈对他的印象，大概就是「纯粹」——对自己的衷爱燃烧所有热情和全付身心的投入。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"曾经读到过一句话：所谓纯粹，并非是未经世事的简单，而是饱经磨难却不曾毁损的灿烂。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我的确不知道，林嘉文抑郁症的形成和这种完美主义是不是有一种关系。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但至少从他的遗书可以看到，用这种完美主义的标准来衡量他的事业、学问和生活是他放弃生命的一个重要原因。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么，是不是可以反过来这样说：要保有生命，也许就需要放弃一种完美主义？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"社会不宜追求完美在这里不多说了，而个人可能也要慎求完美。人类是一种有限的存在，而个人更是如此。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"虽然可以追求对这种限制的一些突破，但人还是达不到无限和完美。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有了这一基本认识，我们虽然仍旧可以且应该尽量去争取更好的社会与个人生活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但同时却还应该能够容忍缺陷，容忍不足，也包括对生活、对他人、对社会、也对自己作出一些妥协，这种妥协并不一定就是负面的，甚至也可以说是生命的一种坚忍和顽强。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"或许我们可以更准确地说，放弃完美主义——这并不是指放弃理想主义，而只是指放弃一种完美主义的理想主义；\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"甚至也不是完全放弃这种完美的理想主义，而是不将生命——无论他人的生命还是自己的生命——放在完美的标准面前来进行衡量和取舍。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大多数人可能对完美主义是天然绝缘的，他们知道自己的有限性，乃至也满足于这种有限性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但的确还有少数人，甚至很少数人是有这样一种完美主义倾向的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而且，他们之中的不少人又特别敏感，可能还富有天才。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个异常聪明的孩子看到了生命的远方，看到了一生的尽头。而人生的尽头最确凿无疑的自然是死。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"或者如鲁迅所说，都是坟，而坟也最终都要湮灭的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们几乎再也不敢说什么事情是必然的了，但死亡永远是一个必然。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人们可以因其必然的到来而恐惧死亡，但也可以因此不畏惧死亡——但仍然不要去加速死亡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人们可以有各种选择，可以让事务或者享乐填满生活，也可以从容和安静地做自己喜欢的事情而等着大限的到来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正如史铁生所说：死亡是一件最不需要着急的事情。我们还是可以在此之前做许多事情，有许多经历\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，比较具体的一个建议就是：如果一个人决心赴死，先列出你采取这个行动之前要做的一件事情\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"——比如说你最想做的一件事情，或必须做的事情，甚至哪怕是看来没什么意义的一件事情——至少一年为期。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在你做了这件事之后，如果你还是执意要走，可能的确就没什么办法了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但你也有可能、甚至很有可能改变你原来的主意。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我相信生命力、尤其青春的生命力的丰盈，相信它的无孔不入和不期而至。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它已经创造了无数救人于溺、起死回生的奇迹，它还会继续创造奇迹。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"类似的，探求人类的正义，即哲学的目的，也是水中捞月。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在反复阅读了罗尔斯的《正义论》、《正义新论》以后，我发现最基本的正义原则找不到逻辑基础。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所有一切的政治哲学争论到最后都是自由与公平之争，而自由和公平，都只是写在基因里的需求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"个人的行为，也同样没有绝对的对错，道德只是一种心理需求，一种与大脑前叶有关的心理模块。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没有所谓的价值，只有价值感，没有所谓的绝对意义，只有各种各样的心理需求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"广览中外书籍的我亦在孤独、困惑中参悟生死。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那时下一句话：一个正常人想要在疯子群里存在，就必须得把自己装得像个疯子，才能正常生活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"啥都被琢磨完后，我走上了修证的路。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"随心在世俗与传道之间尝试找到一条通往茫茫众生的路，然茫茫众生多如荒草，奈何过往圣人悲天悯人中只能付诸于一句随缘。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人总是追寻着存在的意义，从亚里士多德的“目的论”，及其衍生的对理性灵魂的追求，到基督教的侍奉上帝的生活，人们都在追求一种“灵魂”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人始终愿意相信人不只是一团物质而已，更有精神。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而对这种自由意志，人类需要为其找到一个安放之处。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"哲学家们努力用理性探寻着某种绝对的价值，例如康德的绝对命令。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理性真的能告诉我们存在的意义吗？无论如何，理性是我们拥有的最后的武器了，所以我们如此依赖它。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理性让我们接受了进化论，进化论告诉我们人类只不过是基因复制的一种形式。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"理性让我们不得不接受：存在没有意义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"于是，探求人存在的价值一如探求石头的价值。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我们有一个目的比如造房子，那么石头就有了价值，但如果没有人去提出这个目的，那么石头只不过是在那里存在着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果人想要有一种超越物质的存在的意义，那么这个自然界必然需要有一个上帝，它给万物以目的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然而这个“不动的推动者”并不需要存在——霍金《大设计》中的模型依赖理论已经使得上帝这个最初的规律设计者和推动者不必要存在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"理性让我们无法彻底相信上帝这样一个存在。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"浪漫主义、存在主义哲学就要在此基础上回答人如何存在的问题。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"尼采提出的“权力意志”似乎是“上帝死了”之后，驱使人继续前进的一剂良药。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"尼采说，自由使我们对自己的角色负责，就像艺术家对自己的作品负责，人格就像一个艺术家的创作物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们就像不知如何落笔的画匠，在未来这个画布前，构思着自己的画作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这样的创作者身份非常吸引人，但仍然无法就此宣布，这就是人生的终极意义，也只是另一个活下去的动力而已，心理学中称之为自我实现的需求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但还有一种人，目的就不只是为了兴趣这么简单。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们通常都有强烈的同情心，例如民权运动领袖伦道夫，例如对底层妇女处境不满以替女工维权为己任的弗朗西珀金斯，例如马歇尔，例如马克思。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们想为他人做一些事，或者大到想为人类做些事，为此不断地思考，行动，锻炼自己的能力，锤炼自己的品格，努力把事情做成。这样的人就叫英雄。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们看到了他人的不幸，发现自己似乎有能力去帮助他们，于是就去做了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一般人没这样的能力，当看到他人的不幸，只能唏嘘感叹一番现实的残酷和无情就回到自己的生活中面对自己的小烦恼了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即使有能力，一般人也不会像一些伟人那样殚精竭虑，或者拿出所有财产（就像空想社会主义先驱们那样），甚至豁出性命去做一些事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果能留住你们，以你们的才智和境界，这个社会也许会多一些英雄，如果有英灵殿，你们将与那些伟人同列。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,aAAa,CAAC,CAAC,CAAC,EAChCN,G