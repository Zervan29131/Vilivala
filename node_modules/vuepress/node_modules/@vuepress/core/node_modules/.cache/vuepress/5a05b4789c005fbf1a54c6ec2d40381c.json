"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"为什么光速不变？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"没有为什么。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"目前为止，也没人知道为什么，这是一个很诡异的事。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"光速不变是被发现和反复验证的事实。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"即，从观测结果上看，无论你是面相光源运动，还是背向光源运动，光的速度对你没有发生任何变化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在光速不变的前提下，向前射出一束光，无论你的速度有多快去追赶，光的速度对于你，永远是30万千米/秒，你无论如何也是追赶不上的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为什么光速不变，为什么这么神奇，现在是众说纷纭，没人能给出标准答案。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"既然无法解释，就假定了光速确实不变。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"爱因斯坦假定了光速不变之后，用数学模型进行反推出了钟慢效应。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"当然，钟慢效应经过验证，也是对的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所以，GPS全球定位，必须加入钟慢效应修正才可以实现精准定位。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"钟慢效应数学模型是这样的(为便于理解，不讲概念化的东西，也不套用任何公式）:\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"从A点到B点是30万公里距离，光需要1秒钟时间到达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '从观测上，你从A点到B点，无论你的速度是多少，光速相对于你都是30万千米/秒，也就是光永远比你快30万千米/秒，不会有任何变化，即\"光速不变\"。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么，假设你从A到B需要1小时，即光速的1/3600\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"即如果B点有个人，他1秒钟后看到光到达，1小时后看到你到达。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你的表显示，你也是1小时到达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这很好理解，感觉好像没什么不对。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实已经不对了，只是你的速度还是太慢，不对的痕迹非常微小，你没有觉察到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你加快速度，也是以30万千米/秒的速度，从A点到B点，即可得出，你也是用时1秒钟。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"好像还是没感觉哪里不对。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是，不对已经很明显了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那就是你真的达到光速了吗？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"光速对你来说，它还是比你快，因为它的速度相对于你，还是30万千米/秒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也就是说，B点的人，他会发现，光到达了B点1秒钟后，你是第2秒钟才到达的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你和光并不是同时到达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"进而得出，从B点的人观察，你实际平均速度只有光速的1/2，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，从你的视角，明明你是光速(30万千米/秒），你带的表也只走了1秒钟，就到了B点。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但B点的人带的表，此时已经走了2秒钟，第1秒，光到了，第2秒，你才到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"无论你把速度提高有多快，即使已经是光速的10万倍了，消耗的时间已经是十万分之一秒了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但B点上的人，总是先看到光1秒钟到达，你总是在1秒钟之后才到达。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从A到B点这段距离，光需要1秒钟到，你是绝无可能等于或小于1秒钟的，无论你的速度有多快。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"变化的只是你和B点的人的相对时间，就是说，你的表会比B点的人的表慢，当然，1秒的误差还是感知不明显。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么，现在把这个推理再套进仙女星系的例子，进行大尺度环境下推演，感知就极其明显了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"众所周知，我们距离仙女星系是254万光年，也就是说，仙女星系发出的光，经过254万年的时间，才能到达地球，才能被我们看到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"假设，仙女星系的人，科技非常发达，已经制造出254万倍于光速的飞行器，来拜访我们(你甭管人家是怎么制造出来的，反正就是制造出来了）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"正常理解下，该飞行器到达我们的地球，需要1年左右的时间。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"距离/速度=时间，没毛病。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，诡异的一幕发生了，1年后，我们并没有等到飞船的到来，254万年后，还是没等到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么，这个飞行器是什么时候到达地球的呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们要等待254万年，看到仙女星系的光到达的1年后，我们才会迎接到仙女星系的客人。(光速不变)\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但飞行器里的人，从仙女星系到达地球的时间，他们的表显示，真的只用了1年就到了地球。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"两者一对比，飞行器里的人1年=我们254万年+1年。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"也就是说，飞船里时间相对于我们的时间，慢了254万倍。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"也可以说，我们的时间相对于飞船里的时间，块了254万倍。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们换算成速度，距离/时间=速度。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"相对于仙女星系到地球的距离，该飞船只是到达了光速的99.99996063% ，并没有超越光速。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很神奇吧。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"无论仙女星系飞船有多快，最多也只是无限接近于光速，只会引发相对时间变化，即钟慢效应，却无法超越光速。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"本文假设超光速飞船，是为了便于理解光速不变下的钟慢效应，实际上，即使假设超光速存在，实际上也只是钟慢效应引起的假象，其本身并没有超越光速。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"返回头再看，就是该飞船达到了99.99996063%光速，时间就会从254万年减慢到1年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"也就是说，接近光速飞船上的人，一年的时间，等于地球254万年。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果继续推演就更加神奇了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"即仙女星系的人的飞船，速度快到只需要1秒钟就能到达地球。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么，我们也是在254万年+1秒钟后，才能看到飞船到达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没错，仙女星系的人，1秒钟到达地球，然后和你握了握手，立刻返回，然后1秒钟又返回他们的星系，等他们下飞船的时候，发现他们的星球已经过去了508万年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这种情景模式经常出现在科幻小说和电影里。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理解了钟慢效应，那么，对于尺缩效应的理解就是顺水推舟的事了，很简单的逻辑推理就可以得出。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"还是套用仙女星系的例子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"本来呢，仙女星系的飞船应该1年后到达地球，飞船上的人也是真是用了1年到达了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但是我们在254万年+1年后才等到该飞船到达，这里就有个问题，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"仙女星系距离我们确实是254万光年，既然仙女星系飞船已经是光速的254万倍了，我们就应该在1年后等到飞船到达才对。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"是什么问题导致的呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在光速不变的前提下，那就只有一种解释了:\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"飞船的飞向地球的长度的物理空间缩短了(飞船的长度），缩短了254万倍。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"也就是说，与之相对的仙女星系到地球的距离，增加了254万倍。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"本来可以1年到达，结果还是需要254万年后才能到达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但在飞船之内的人则表示，飞船长度空间还是原来大小，没有发生任何变化，没有被压缩，因为从飞船为参考系，仙女星系到地球的距离空间，同时也缩短了254万倍，两者这样一对比，飞船飞行的时间还是一年，也没发生变化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"由此可以得出:\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"1.不同参考系下的物理时空是相对不同的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2.同一参考系下的时间和空间不能单独存在，不可分割，所以，叫四维时空(时间+三维空间)，即如果时间发生变化，那么空间也必然发生变化，而空间发生变化，时间也必然同步发生变化。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果你要问，为什么会有神奇的钟慢效应和尺缩效应？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很好回答，是因为光速不变。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但为什么光速不变，不能被超越？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不知道。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们所有的理论都是基于观察，而基于观察的就会所限于人类作为生物的底层逻辑。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还是那句话，我们所看到的世界，是能够被我们看到的世界，但不等于世界本身。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有一个滤镜，滤镜前是真实，滤镜后是存在，而我们的观察，就是这个滤镜。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大白话就是：因为我们是人，所以看不到真实。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,UAAU,CAAC,CAAC,CAAC,EAC7BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,QAAQ,CAAC,CAAC,CAAC,EAC3BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,+CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,C