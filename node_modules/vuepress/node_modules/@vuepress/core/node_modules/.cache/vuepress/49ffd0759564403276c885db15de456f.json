self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"理性思维的弱点是消耗太多卡路里。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"理性思维的过程需要大量的运算和记忆，消耗太多能量。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为理性思维是一种高耗能的思维模式，大脑才会逃避，理性思维才显得稀缺。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人理性思维时间越长，就越容易疲惫，疲惫之后意志力就会下降，意志力下降之后就会误判。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有时我们看到自诩理性的人，有的偏执乖癖，有的优柔寡断，恐怕就是这个原因。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"分析完理性，再来看感性。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"感性是一种直观的、抽象的、扁平化、发散式的运算。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它是高效节能的运算，可以在很短的时间内返回结果。因此它常常被人与冲动、偏见、任性等等词汇关联起来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"事实上，它在科学研究中同样居功至伟。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你能理解矩阵运算背后的坐标系变换的含义，如果你理解求矩阵特征值对多维度系统的解耦意义，如果你能发现“傅立叶变换”等等数学工具背后的直观意义，提升感性认识，你就不会被公式吓到，不会轻易疲惫，你的科研之路就会更加顺畅。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"感性认识可以大幅节省脑力。\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"爱因斯坦甚至说：\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"The only real valuable thing is intuition.\\n唯一有价值的东西是直觉\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"理性与感性都是人类的思维工具。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"让理性引导感性，提高正确性。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"让感性辅佐理性，提升功能性。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"使他们并行不悖，相得益彰，这才是我们应该努力的方向。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在自律领域，通过理性判断让自己自律的方法多半都会失败，通过感性方法保持对自律状态的喜爱和不自律状态的厌恶，这才是王道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这就是古人所强调的修心的意义之一。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有科学研究表明：理性思维和感性思维耗能并没有差太多。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"国际象棋大师在比赛时候的大脑能耗跟一个发呆的人大脑的能耗相差很小。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这也证明了大脑并非堆元器件形成的并联结构\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很少有人做到，能做的不用教，不能做的也不能教。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"感理性思考太难了，傅立叶变换后的直觉意义如何理解？完全的理解类似于创造，除了傅立叶几乎没有人做到了，直觉理解傅立叶变换既需要天赋又需要训练。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而变换就别想感性认识了，广泛思考变换需要原始材料的有效组织，这需要理性，而变换思想的原发产生不依靠变换本身，这就是所谓直觉理解和数学家原发创造的区别。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"直觉是有某种趋势的潜意识架构，直观对应一种存在，傅立叶不可能通过直观想到傅立叶变换，在直观上这东西并不存在，想要直观理解就必然不是傅立叶变换的创造者，主动意识调动直观去理解，类似于用手去把两个物体放在一起，被称之为组合，和创造时大脑中的组合没有可比性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没有任何敌意，只是我作为数学思考者的一些实践出的经验。在脑中做，用手做，和看别人做有很大区别\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACA,EAAE,CAAC,QAAQ,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,CAAC,CAAC,EACrDN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM