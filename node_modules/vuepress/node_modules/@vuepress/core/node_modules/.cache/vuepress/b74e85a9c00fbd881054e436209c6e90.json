tentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"apache许可证\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#apache许可证\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" Apache许可证\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"Apache Licence是著名的非盈利开源组织Apache采用的协议。该协议和BSD类似，同样鼓励代码共享和尊重原作者的著作权，同样允许代码修改，再发布 (作为开源或商业软件)。需要满足的条件：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"需要给代码的用户一份Apache License。\\n如果你修改了代码，需要在被修改的文件中说明。\\n在延伸的代码中（修改和有源代码衍生的代码中）需要带有原来代码中的协议，商标，专利声明和其他原来作者规定需要包含的说明。\\n如果再发布的产品中包含一个Notice文件，则在Notice文件中需要带有Apache License。你可以在Notice中增加自己的许可，但不可以表现为对Apache License构成更改。\\nApache Licence也是对商业应用友好的许可。使用者也可以在需要的时候修改代码来满足需要并作为开源或商业产品发布/销售。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"商业软件可以使用，也可以修改使用Apache协议的代码。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"bsd许可证\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#bsd许可证\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" BSD许可证\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"BSD License与其他自由软件License相比，如GPL，限制更少。但是请注意到BSD License两种版本之间的差别：New BSD License/Modified BSD License 和Simplified BSD License/FreeBSD License。它们两者都是于GPL兼容的自由软件License。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"New BSD License (”3-clause license”) 可以用于任何作为版权声明和保证许可的免责声明的目的，可以通过无限长的再分发来得以维持，也就是说如果再发布的产品中包含源代码，则在源代码中必须带有原来代码中的BSD协 议。它还有一个特殊限制条款，不用特别的许可就是限制使用派生工作的工作者名字，也就是说不可以用开源代码的作者/机构名字和原来产品的名字做市场推广。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"New BSD License和Simplified BSD License的主要区别是，后者忽略了非认可条款。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"商业软件可以使用，也可以修改使用BSD协议的代码。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"gun许可证\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#gun许可证\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" GUN许可证\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个有两个，一个是授权多的，一个是授权少的：\")]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"GNU General Public License （GPL）的可能是开源项目最常用的许可证。GPL赋予和保证了开源项目开发者广泛的权利。基本上，它允许用户合法复制，分发和修改软件。 这意味着你可以：\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"复制软件\")]),\n        _vm._v(\n          \"\\n复制软件到自己的服务器，客户端的服务器，你自己的电脑，几乎任何你想要的地方，而且没有数量限制。\\n\"\n        ),\n        _c(\"strong\", [_vm._v(\"发布软件\")]),\n        _vm._v(\n          \"\\n发布你想要的软件，例如，在你的网站提供下载链接，刻成光盘，打印出来等等。\\n\"\n        ),\n        _c(\"strong\", [_vm._v(\"收取费用\")]),\n        _vm._v(\n          \"\\n如果你想在向别人提供软件时收费，如设置在别人的网站上或者其他用途时。GPL允许你这么做，但是你必须给客户提供一个GPL副本，告诉他们可以在其他地方得到免费版本。当然最好在此之前，告诉客户，你为什么收费。\\n\"\n        ),\n        _c(\"strong\", [_vm._v(\"可以任意修改\")]),\n        _vm._v(\n          \"\\n如果你想添加或删除功能，没问题。如果想在其他项目中使用部分代码，也是可以的，但是唯一的限制是此项目也必须按GPL发布。\\n商业软件不能使用GPL协议的代码。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"还有另一个GNU License：GNU Lesser General Public License （LGPL）。比起GPL它授予的权限较少。一般来说，LGPL比较适合连接到非GPL或者非开源文件的库文件。由于GPL的规定，使用到部分GPL代码的软件，必须也使用GPL，开发人员不能使用GPL来开发收费软件或者专有软件。LGPL则没有这方面的要求，不要求使用与部分代码相同的 License。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"商业软件可以使用，但不能修改LGPL协议的代码。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"mit许可证\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#mit许可证\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" MIT许可证\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"MIT是和BSD一样宽松的许可协议,作者只想保留版权,而无任何其他了限制.也就是说,你必须在你的发行版里包含原许可协议的声明,无论你是以二进制发布的还是以源代码发布的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以使用，复制和修改软件\\n你可以免费使用软件或出售\\n唯一的限制是，它是必须附有MIT授权协议\\n商业软件可以使用，也可以修改MIT协议的代码，甚至可以出售MIT协议的代码。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"mozilla-public-license-1-1-mpl\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#mozilla-public-license-1-1-mpl\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" Mozilla Public License 1.1 (MPL)\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"MPL协议允许免费重发布、免费修改，但要求修改后的代码版权归软件的发起者。这种授权维护了商业软件的利益，，它要求基于这种软件得修改无偿贡献版权给该软件。这样，围绕该软件得所有代码得版权都集中在发起开发人得手中。但MPL是允许修改，无偿使用得。MPL软件对链接没有要求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"商业软件可以使用，也可以修改MPL协议的代码，但修改后的代码版权归软件的发起者。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\n        \"h2\",\n        { attrs: { id: \"common-development-and-distribution-license\" } },\n        [\n          _c(\n            \"a\",\n            {\n              staticClass: \"header-anchor\",\n              attrs: { href: \"#common-development-and-distribution-license\" },\n            },\n            [_vm._v(\"#\")]\n          ),\n          _vm._v(\" Common Development and Distribution License\"),\n        ]\n      ),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"CDDL（Common Development and Distribution License，通用开发与销售许可）开源协议，是MPL（Mozilla Public License）的扩展协议，它允许公共版权使用，无专利费，并提供专利保护，可集成于商业软件中，允许自行发布许可。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"商业软件可以使用，也可以修改CDDL协议的代码。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"eclipse-public-license\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#eclipse-public-license\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" Eclipse Public License\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"EPL是一个与CPL相类似的许可证，任何扩展自Eclipse源码的代码也必须是开源的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"以上就是opensource里的许可证书\")]),\n      _vm._v(\" \"),\n      _c(\"hr\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"还有两个很重要的协议\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#还有两个很重要的协议\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 还有两个很重要的协议：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"creative-commons\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#creative-commons\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" Creative Commons\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"Creative Commons（CC）的许可证不太开放源代码授权，它们通常用于设计项目。 CC许可证有着宽广的定义，每个定义都会授予一定的权利。它有四个基本部分，可以单独或者组合使用。下面是部分概述：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"署名\")]),\n        _vm._v(\n          \"\\n作者必须是作品的原创者。 除此之外，作品可以修改，分发，复制和以其他方式使用。\\n\"\n        ),\n        _c(\"strong\", [_vm._v(\"相同方式共享\")]),\n        _vm._v(\"\\n工作可以修改，分发等等，但必须在一个许可证下。\\n\"),\n        _c(\"strong\", [_vm._v(\"非商业\")]),\n        _vm._v(\n          \"\\n可以修改，分发等，但不用于商业目的。 关于什么是“商业”，说法比较含糊（没有提供明确的定义），因此您可能需要在自己的项目中澄清这一点。\\n\"\n        ),\n        _c(\"strong\", [_vm._v(\"禁止修改\")]),\n        _vm._v(\n          \"\\n这意味着您可以复制和分发许可工作，但你不能以任何方式修改，或在原有的基础开发。\\n商业软件的使用要遵从CC协议的具体规定，最严格的许可证将是“署名，非商业，不能修改”的授权。这意味着你可以自由共享的工作，但不能改变它，你必须把它归功于原创者。\"\n        ),\n      ]),\n      _v