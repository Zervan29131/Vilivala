tributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"马太效应\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#马太效应\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 马太效应\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"穷者愈穷，富者愈富，最终穷人被淘汰，富人通吃。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"然后开启下一轮循环。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"直到最后剩下两个人，依然如此。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"只剩一个，彻底垄断，赢者通吃。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"世界就是在这一轮轮淘汰中前进。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果相信这个，那么没人会接受失败，没人会接受排第二。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"只有第一，才能生存下去。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"马太效应对应的是西方逻辑，是“人之道损不足奉有余”，除此之外，还有“天之道损有余补不足”，也就是我们的东方传统。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"修昔底德陷阱\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#修昔底德陷阱\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 修昔底德陷阱\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"修昔底德陷阱基于古代雅典历史学者和军事将领修昔底德的一段话，修昔底德认为雅典和斯巴达之间的伯罗奔尼撒战争是不可避免的，因为斯巴达对雅典实力的增长心生恐惧。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果说马太效应是本质，修昔底德陷阱就是外在的表现。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"老大通吃一切，老二一无所有。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以老二要想生存，必须搞死老大。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么对于老大来说，无论老二要不要搞死自己，老大都认为他有这个心。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而对于老三老四老五来说，老大虽然可能搞死所有人，但老二也没安好心，搞死老大之后还会搞死所有人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以宁愿看戏，自己找机会捞好处，也不会真心帮老二。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中国古代那种歃血为盟，同舟共济，有福同享，有难同当，一人得道，鸡犬升天的心态，西方世界不搞这一套。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你斗我，我斗你，都得天昏地暗，最后剩下一个。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"修昔底德陷阱属于巴别塔那一系，就单从商业上来讲，各行各业的双寡头模式已经持续了上百年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但修昔底德陷阱对应的不只是商业，更是你死我活的战争模式。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们要如何应对呢？就要走出那种你中有我我中有你的战略来对抗这种陷阱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"社会达尔文主义\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#社会达尔文主义\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 社会达尔文主义\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"和黑暗森林不同。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虽然同样都在讲丛林法则，黑暗森林更多的是一种自然自发的现象，而社会达尔文主义则是彻底的人为结果。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"社会达尔文主义曾被其拥护者用来为社会不平等、种族主义和帝国主义正名，理由是赫伯特·斯宾塞所说的“适者生存”。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"如果说达尔文主义是自然的进程，社会达尔文主义则是社会的借口。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一帮因为运气上位，甚至自己都不能重复自己成功经验的人，把一切归因于能力和血统并加以正名，将一切失败者打为“应该淘汰的劣等人”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"甚至否认那些历史上优秀的民族，只是因为一时的落后而显得弱小。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"社会达尔文强调“适者生存”，但君以此始必以此终，昨天让你胜利的也恰恰会是今天让你失败的包袱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其理论早已被证伪，但你不能否认有大批西方精英就是以此为借口煽动种族仇恨。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"马尔萨斯陷阱\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#马尔萨斯陷阱\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 马尔萨斯陷阱\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _c(\"strong\", [_vm._v(\"马尔萨斯陷阱\")]),\n          _vm._v(\n            \",又称为“马尔萨斯灾难”，以政治经济学家托马斯·罗伯特·马尔萨斯命名，认为对大部分人类历史来说，收入停滞的原因是因为技术的进步与发现仅仅造成人口的增加而没有提高人类的生活水平。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这套理论从根本上否定了部分人类的生存权。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"它给人类定了符合当下生产力的人口上限。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"超越上限，一定会发生经济停滞，从而导致社会问题甚至混乱。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“人类”的定义，也有区别。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于一个美国人和一个非洲人，显然在马尔萨斯的理论中，不能等同于一个人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"同样能养活100个非洲人的资源，也许只能养活半个美国人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以对于这个世界来说，发达国家的人，越少越好。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"十分之一个人，甚至百分之一个人，这样的国家越多越好。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"马尔萨斯陷阱完全建立在农业社会人口增长受限土地出产和气候周期，以及财富增长受限于金本位。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其对应的是生产力停滞。如果可控核聚变不成功，现代社会进入马尔萨斯陷阱也是迟早的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"以上一切理论，都可以在星空中找到对应的关系。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"假设给宇宙足够的时间。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有极大可能性，会出现一个统一全宇宙的超级文明。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"它已经在长期斗争中，消灭了所有竞争对手。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"它还会消灭每一个可能给自己造成威胁的新文明，从源头上消灭。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这样就可以避免自己再次遇到以上四个理论，再次遇到混乱和争斗。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这和黑暗森林最大的区别，是黑暗森林里面仿佛各种动物，同级相争。而这个宇宙中，只有一个拿着猎枪的人，不停巡视，打死每一个被他看见的，超过5公斤的动物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这也算是大过滤器的一种吧。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你觉得不可能，那么请回过头去，看看智人是怎么一路走来，灭绝尼安德特人、海德堡人、丹尼索瓦人……独霸星球的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果给人类足够的时间，人类不会在宇宙中继续这样做？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"既然人类能做，那么外星人呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这4个不过是人类社会部分现象的归因，本身就受限于一定的时代和技术效率的假设，而且还有更上一层的通用法则。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAO;EAAE,CAAC,EAAE,CAClCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAQ;EAAE,CAAC,EAC1D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,OAAO,CAAC,CAChB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,yBAAyB,CAAC,CAAC,CAAC,EAC5CT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,YAAY,CAAC,CAAC,CAAC,EAC/BT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACS,EAAE,CA