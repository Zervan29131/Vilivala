{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/77.享受孤独.md?vue&type=template&id=2934cb1f","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/77.享受孤独.md","mtime":1768579404257},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/77.享受孤独.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"有一天我在图书馆坐了一整天。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我记得我进去的时候太阳正从东方升起，天空中显露出鱼肚白，阳光很温柔。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"后来我不知道过了多久，时间走得浑浑噩噩。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"书里说，王子与公主最后幸福地生活在了一起，插图里男孩与女孩幸福地依偎在一起，他们的身后鲜花绽放，大树林立，小河潺潺。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我心满意足合上书，却突然愣住了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"巨大的落地窗外是是缓缓沉入地平线的夕阳，渐渐黯淡的天空有群群飞鸟掠过，偶尔匆匆走过的人渐行渐远，化作道路尽头的一个小黑点，消失不见。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"夕阳在这一刻照进图书馆，将整个图书馆映得火红，它热烈地将余晖洒向人间，大厅变得金光灿灿，仿佛现实与画卷交汇，世界静谧而温柔。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"夕阳的光渐渐退散，最后变成一条线，消失在目光的尽头。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"夜幕在夕阳消失的那一刻终于降临，夜色如潮水翻涌上来，空气里仿佛笼罩上了一层淡淡的薄纱，远方的白烨林沉浸在暮霭中，斜斜的枝头指向苍穹。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我走出图书馆的大门，它巨大的轮廓在路灯下投影成一片阴影，周围的灯还没怎么亮，一片黑漆漆的虚无。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大路的尽头是食堂，那里是一片灯火通明，每一扇窗户后，或许是一桌丰盛的佳肴，热热闹闹的人群，喧嚣吵闹的歌声。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只隔着一条几百米的路，两座庞然大物的建筑相对而立，一边是灯火通明，而另一边是长夜漫漫。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"图书馆里已经没有几个人了，还剩的几个也收拾东西，三三两两地从我身边走过。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我看到一个女生甜甜地挽着男朋友的手，男孩宠溺地摸摸她的头。夜晚已经起风了，男孩走在女生的前面，把她裹得严严实实。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"旁边两个兄弟打打闹闹地跑过，带起一阵风。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我站在门口，寒风贯进衣服里，灯光下是一个长长的影子，形单影只。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"孤独在一瞬间如潮水涌来，好像深不见底的漩涡，要吞噬世界的一切。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我疲倦地坐下，突然有一种被世界抛弃的错觉。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真实的大学生活是怎么样的呢？这实在是说不清楚，因为有太多的生活方式。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"有的人在这四年里选择用自己的方式去度过，体验一种不同的人生。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有的人继续努力学习，希望奖学金与保研。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"有的人爱上了游戏，希望在这青春的尾巴里最后一次放浪形骸。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所有的方式都是自己的选择，其实没有对错，只是不同的选择。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你或许是在一节无聊地晚自习点开手机，想听我描述大学可以如何玩乐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"是啊，你可以每天睡到很晚，可以不去上课，可以一直打游戏。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你可以去参加许多有意思的社团，遇见许多有意思的人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你可以冬天里在热气氤氲的火锅旁慢慢涮羊肉，可以慢条斯理地吃烤肉......你可以做太多的事情了，做你高中时候想做的一切。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是你首先要学会的，是忍受孤独。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那年高三深冬的时候我看着窗外挂起的红灯笼，就着纷扬的大雪，空气里已经有过年的氛围了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我咬着笔百无聊赖地问同桌你说大学生活会怎样？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他认真地想了想说我们不用上晚自习了，然后还可以一直玩手机不会有人来管我们......\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那些年我们就是这样一厢情愿地成天幻想，并以此度过那些枯燥的岁月。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"后来我真的读大学了，日子开始变得不一样。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我可以翘课，可以不上晚自习，可以谈恋爱。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然而当那天我站在黄昏图书馆清冷的台阶上的时候，才明白毕业时候班导意味深长的那句话。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你们的高中结束了，从此一个时代结束了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"是啊，一个时代结束了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从此不再有人一起和你朝着一个目标努力挣扎，不再有坐在同一间教室的人们，甚至没有人再给你说那些你曾经很不屑的鸡汤。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"取而代之的是下课后匆匆离开的陌生人，无数张模糊又相似的面孔。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人们在无数个黄昏里错身而过。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你也有自己的路要走，而这条路只有你一个人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"在这条路上，你开始学会一个人欣赏日落，也学会一个人直面风霜。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大学里永远是熙熙攘攘，可是你要知道，这只是表象。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"隐藏在热闹盛宴下的，是一个人的大学，在一条似乎是笔直的路上，日落的余晖温柔洒下，路上的人啊，都会去向不同的远方。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"曾经看过一个很火的问题，主题是关于大学生的孤独。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多答主说，不必去融入圈子，提升自己就好了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人们总是喜欢小心翼翼地将孤独隐藏在自己的圈子里。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但其实我更认为，一个人孤独久了是会出问题的，毕竟人是属于群居的生物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在大学里有一个能力使我们一定要学会的，那就是找到与自己志同道合的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"知乎上还有一个问题是，和室友格格格不入怎么办？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"然而事实是，很多时候，室友仅仅是室友，未必是同行之人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他要睡懒觉而你要早起，他要打游戏而你要看本书，其实是生活方式不一样而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"真正的同路人是在彼此奔跑的路上遇见的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而相遇的那一刻，你就走出了迷宫，仿佛高墙轰然倒塌，久违的阳光从缝隙里照射进来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"因为写作的原因，我常常需要去图书馆，而有时候一呆就是一整天。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我习惯泡一杯茶，看着它从热气氤氲，到毫无波澜的冰凉，就如同从晨光初生到月上柳梢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"开始的时候就像文章开头一样，我经常会在傍晚走出图书馆的时候很失落。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我曾和一个很好的朋友聊过这个问题，他笑笑说找个女朋友吧。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我竟不知道如何回答他。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以有时候我会胡思乱想，想在一场场推杯换盏的热闹中，在一张张谈笑风生的面孔下。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"是不是都藏着一颗寂寞孤独的心。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在越来越远，越来越广阔的人生路上，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"锲而不舍地寻找另一个契合的灵魂。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"或许从某个角度来说，我们都是深夜寒灯下彷徨着孤独的人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个世界是沉默且孤独的\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但总会遇到一团火点亮你的心灵\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"总有一份喜悦将你的一切变成潜意识去爱\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是一场永不休眠的相遇\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所谓的孤独可能只是这个世界的守门人\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"它能选择让谁进入我们的小世界\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们保持着心脏震荡 等待有人来共鸣\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你一个人去吃饭，一边划拉筷子一边偷偷撩起头发观察周围有没有人给你鸣锣开道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你一个人去图书馆，翻开书本的同时眼睛不断的四处乱瞟有没有姑娘觊觎你的美色偷偷坐在靠你很近的位置上。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你一个人上课，一边装模作样听讲一边高度警惕有没有想抱大腿的过来跟你套近乎。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"…………\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你那是一个人吗？你那是装的一个人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人家真正的一个人独来独往的原因就是不想跟外界打交道，不想在乎别人怎么想，世界跟我无关压根不会放在眼里更不会在心里。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我当年走路看书被班主任撞了一个屁股墩，我压根没看是谁，捡起我的小说继续去看了，因为我的眼里只有它，如果不是班主任自习课上揶揄我眼睛长到屁股上了，我这辈子都不知道有这件事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"喜欢一个人的人眼里只有一个人，根本不会管其他人怎么想怎么看，动不动跟风装成一个人好像很冷酷很高傲内心里却不停的祈祷周围人看看我看看我我是不是很吊的？！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"事实上，如果你不是裸奔，根本没有人会在意你在干什么，即使你在裸奔，也就关注两分钟谈论半小时，大家都有自己的生活，都很忙的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"孤独不丢人，戏多才丢。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,gBAAgB,CAAC,CAAC,CAAC,EACnCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,EACrCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,C