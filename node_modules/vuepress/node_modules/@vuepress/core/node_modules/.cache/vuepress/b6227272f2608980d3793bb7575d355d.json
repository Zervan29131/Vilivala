    _c(\"p\", [_vm._v(\"我个人觉得大概这样设置CS课程更为合理:\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"大一上: C/C+ +程序设计、高数1 (初等微积分) 、离散数学\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大一下:数字逻辑、数据结构、汇编语言、面向对象编程(Java/C++)、 高数2、线性代数\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"大二上:软件工程、数据库、Java/Python Web开发、组成原理\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大二下:操作系统、计算机网络、系统级编程(CSAPP)\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"大三:软件测试、软件安全、课程设计、密码学、图形学等选修方向\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"大四:实践、毕设、实习\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"黑客如何利用社会工程学\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"每年我参加网络攻防演习的时候，也就是护网行动，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有些时候，某些攻击队进不去某单位，就会采取去单位门口扔∪盘这个办法，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"基本百试不爽，总会有手欠的员工，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"捡到∪盘，违背公司规定，在公司内网上，插入∪盘,然后就给渗透了!\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人如果在购买一款商品时，不基于需求去衡量商品的作用，而是狭隘的通过售价来区分高低是一件极其愚蠢又不值当的事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不仅如此，就算能宣传也未必有用，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"清理掉资本主义意识形态流毒之后，还得确定路线，确定完路线，还得按计划付诸行动，计划还得与时俱进因地制宜，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"故而每过一段时间都要确定一次路线，每次确定路线都是血雨腥.... .\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这还都只是资本主义不还手的情况下。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空镜头具有特定的象征意义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"绿色象征生命；红色象征热情；白色象征纯洁；黑色象征哀伤。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是人们从生活体验中得出的感受。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空镜头能够增加画面的情感效应。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“一切景语皆情语”（王维语），环境是人物内心感情变化的外化物，人的情感可以在环境内蔓延伸展，并与观众情感契合进而产生共鸣。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空镜头是一种以画面语言为主、有声语言为辅的艺术形态。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空镜头在表现过去的事件时，具有突破时空的表现力。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在一些反映老一辈革命家战斗生活的影片中，经常会看到朱德的扁担、红军长征时用过的破旧粮袋以及毛主席住过的延安窑洞等空镜头，很自然地产生一种客观实证的效果，有很高的可信度。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空镜头的权威性，具有见证作用。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有这样一组镜头：坑坑洼洼的农村小路，布满裂缝的小学教室，荒废的排灌设施，使用了几十年的老水井等，这些“物证”使人感觉在这个小村庄里时光似乎凝固了，几十年来几乎没有变化，人民贫困的生活状况依然没有得到改善。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真实感就产生于事实的发生、发展和变化之中，看似简单的空镜头反映了真实，造就了它的权威。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"疾风态，量子态，重光态，涅槃态，虔罪态，幻想态\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"疯无道，梦逆天，花无名，夜未央\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"水无痕\\t火无行\\t金无心\\t木无情\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"时瑟，时迁，时仇，时年，时致\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"熔焰火龙， 海啸章鱼 ，飓风苍鹰，绝峭蝎子\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"潜龙勿用，见龙在田 ，终日乾乾 、或跃在渊、飞龙在天、 亢龙有悔\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"金成法，木呈象，火释能，水映空，土载物\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"金成物，木呈象，火释能，水映法，土载空\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"金物，木法，火能，水象，土空\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"秩序，守护，奇迹，时空\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"御 恒 散\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"暮 雪 炎\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"谦卑、诚实、怜悯、英勇、公正、牺牲、荣誉、灵魂。八大骑士精神\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"酒是穿肠毒药，色是刮骨钢刀，财是惹祸根苗，气是雷音炮仗\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"潜龙勿用、见龙在田、终日乾乾、或跃在渊、飞龙在天、亢龙有悔\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"奥特五大誓言\\n第一条 不要饿着肚子上学\\n含义：做任何事情都要准备充分了再去做,如果没有做好准备,很可能会导致功亏一篑,前功尽弃\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第二条 天气好的时候要晒被子\\n含义：抓住一项特长发扬光大，不要错失机遇和良机\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第三条 过马路时要注意来往车辆\\n含义：做事情时要注意任何一个细节,不能漏过一只漏网之鱼,还要小心谨慎.细节注重成败\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第四条 不要依靠别人的力量\\n含义：自己的事情自己做,无论如何都要靠自己的力量,用自己的力量完成事情以后那种满足感是别人帮助你完成时无法体会到的\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第五条 不要光着脚在地上玩\\n含义：做任何事都要做好防备,防人之心不可无\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"量诗——闻 浩 南\\n鵺酱——刘 星 宇\\n小理——王 宇 轩\\n小五——李 博 川\\n坊主——李 传 昊\\nMr.Z——原 至 夏\\n折纸——张 书 磊\\n狂三——孙 运 梓\\n未寒——彭 天 敏\\n柚子——梁 超 凡\\n魔法少女——滕 政 赟\\n沐雨——贾 雨 桐\\n老周——郭 育 辰\\n老滕——滕 志 涵\\n小爱——杨 秀 干\\n小洛——杨 秀 干\\n格林奈尔——杨 秀 干\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,mCAAmC,CAAC,CAC5C,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,+CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,qCAAqC,CAAC,CAC9C,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CA