{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/03.独立思考.md?vue&type=template&id=2d0d764c","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/03.独立思考.md","mtime":1768579404262},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/03.独立思考.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\n        \"h2\",\n        {\n          attrs: {\n            id: \"因为他们首先要成为人-成为独立、健全人格的人-然后才有资格去谈论成败。\",\n          },\n        },\n        [\n          _c(\n            \"a\",\n            {\n              staticClass: \"header-anchor\",\n              attrs: {\n                href: \"#因为他们首先要成为人-成为独立、健全人格的人-然后才有资格去谈论成败。\",\n              },\n            },\n            [_vm._v(\"#\")]\n          ),\n          _vm._v(\" 因为他们\"),\n          _c(\"strong\", [_vm._v(\"首先要成为人\")]),\n          _vm._v(\"，成为独立、健全人格的人，然后才有资格去谈论成败。\"),\n        ]\n      ),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从小到大，学校，家庭，教育，其实最追求的就是，教育出省心的孩子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"省心，省事，听话，不添乱，听指挥。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"孩子从小被驯化，管束，生活在迷茫和恐惧中，缺乏引导。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很容易成为浑浑噩噩，随波逐流，老实内向，但是不自律，没有能量的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从小到大一直生存在他律之中，习惯了依赖别人，习惯了有一条既定的路径，从来没有完成过自律。因为自律的前提是自信。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个一直被约束，被打压，从来没有自己独立办成过什么引以为豪的事，怎么会有自信，有自律。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"长大之后，往往就是最可怜的那种人，从不犯错，但一无所有，也从不抗争。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是仔细想想，从小到大的父母，老师，上司等等。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们其实也是身不由己，他们也是忙碌庸碌疲劳的苦命人，他们能怎么样呢？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"只是不知不觉的，环环相扣地，大家就变成了这样。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但如果所有人都“不再老实”，从小开始，那么或许秩序就很难存在，一个班级，一个公司，一个社会，甚至会崩溃。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"规则的建立，就是为不守规则的人创造利益。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人人都在体制中，环环相扣，积重难返。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"因此\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#因此\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 因此，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们首先要成为人，成为独立、健全人格的人，然后才有资格去谈论成败。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"自主做出选择，是拥有独立、健全人格的关键一步。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人格于人，就好比植物的根，若是人格健全，人生有很大几率会枝繁叶茂，若是人格不健全，那就不知道会长成什么样子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人在一次次自己的选择和承担中，不断完善和健全自我，健全人格。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"放弃选择看起来是在避免失败，实际上，是在阻止自己人格的健全，是在酝酿一个很大的失败。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这就是人生的\"),\n        _c(\"strong\", [_vm._v(\"微妙之处\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人的成长有它的规律，不以人的意志为转移，要尊重，而非违反，无论你有多上心付出牺牲有多大，违反了规律，就要受到惩罚。如果只靠热情和付出就有效，那大跃进早就成功了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人之所以为人，是因为选择权，或者说自由。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"选择权当然不是绝对的，正如自由不是绝对的一样，但是，对于自己的人生没有选择权，就等于失去了做人的权利，自然没有做人的滋味。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"没有做人的权利和滋味，就是行尸走肉。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很多很听话的好孩子为什么看起来呆呆的，没什么灵性，就是因为没有自己选择的权利，没有自己选择的意识，就像一个\"\n        ),\n        _c(\"strong\", [_vm._v(\"机器人\")]),\n        _vm._v(\"，他们的活力被压抑了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是活力不会真的被压制，它们只会越积越多，最后决堤，冲毁一些什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们当中的一部分，总有一天会意识到自己其实是拥有选择权的，但是不知道如何去行使，加上外部的压力，最后选择用错误的方式行使，比如毁掉现有的一切，作为反抗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"年轻人不听劝，是因为他们要成为人，要行使自己做人的权利\"),\n        ]),\n        _vm._v(\n          \"，通过行使，也许暂时犯了错误，但是长远来看，他们健全了自己的人格，同时也会从中吸取教训，不断探索和清晰自己行为的边界和意义，最终成为人格完善、性格健全的理性人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"某种更长远的意义上，此时的失败，避免了彼时的失败；小的失败，避免了大的失败；局部的失败，避免了整体的失败；表面的失败，避免了根本的失败。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最根本的失败，是人格的失败。它会在之后漫长的人生中以种种形式表现出来，但根源，都是人格的失败。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你要划定界限，然后在界限之内，自由生长。这是放手的智慧，你要有勇气，也要有担当。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人生很长，目光要长远。首先要成为人，才谈得上成功与失败。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这也是最根本的成与败。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"但是\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#但是\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 但是，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果从整个人类文明的角度来看，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"假如每个人或者大部分人都拥有独立思考能力的话，那这个世界会变得更美好，使得人类文明发展吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"答案其实相反，它会阻碍人类文明的发展。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人类是一种拥有高等智慧的社会学动物，需要高度发达的可组织性和规约来进行社会活动。如生产活动、政治活动、社交活动等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在这些活动中，如果大部分人都拥有独立思考能力，那组织的难度将会难以想象，因为在一定意义上，独立思考就意味着服从性差。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"社会规范就将需要建设得足够完美以此容纳他们的独立思考。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"社会规约包括但不限于道德、法律、传统习俗、等级制度及领导制度，作为一个独立思考的人，在生活中面对这些时时限制自己活动的规约时，很难不去思考它们的合理性，如果在他们的独立思考中发现其不合理，那便会质疑并寻求改变。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因此如果无法建设出足够完美的社会规约迎合大部分人独立思考的能力，那社会的矛盾一定会无限扩大并爆发。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但其实，如果大部分人的思考觉悟达到足够高的层次，他们便会意识到，在独立思考后，他们只有对自己的独立思考能力进行一定的克制，才能更好地组织起来并进行和谐且更高效率的社会活动，这才是更为理性的行为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以及每个人也都需要开拓自身对不完美规约的包容性，为此，他们必须要认识到人类文明自身的绝对局限性—即不可能建设出绝对完美的社会规约。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么现在的问题便是，如何使大多数人拥有独立思考的能力，却又让他们达到足够高的思考层次以至于可以克制自己的独立思考能力，以及包容处处制约自身的不完美规约。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果把握不好这个度，那对于人类文明的破坏将是毁灭性的，毁灭的是人类的一切道德、文化、法律和物质文明。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"经过自然选择后的人类通过两种方式来避免大多数人拥有独立思考的能力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一、使乌合之众成为人的天性和本能，而不是独立思考。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人生来就具备一部分的理性特性。但对于大部分人来说，他们的理性只沦落为了情绪的附庸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"普通人在获取信息时，更倾向于验证其是否符合自己的直觉、喜欢的答案或者某种已建立起的观念，习惯于先预设立场，然后再试图在信息中找到和自己观念想法接近的内容，而不是用理性思考、深度思考和逻辑思考的能力探究信息本身。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在这一过程中他们的主要目的是验证自己的正确性，追求情绪上的满足感和认同感，而非知晓事实和真相，以及透过现象看清本质。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以当他们见到观念相同的人，便称赞上一句“三观正”、“品味不错”，仿佛也称赞了自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"若大致相同便可配得上他们的一句“还可以嘛”。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"若完全不同那便是一脸的无法理解了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人类远比我们想象中更需要情绪价值的满足，这里的情绪价值不仅仅是指恋爱中的女性需要的那种罗曼蒂克式的情绪价值，而是指一切的情绪的满足感和认同感。即使是物质利益的满足，表现出的直接特征也是情绪的满足。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"刷短视频，运动到大汗淋漓，权与钱，女权运动，爱国主义，自由主义等等等，人类沉浸其中，或多或少，都是在追逐某种情绪价值的满足，追求某种意愿和欲望的满足。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"同时，在追随权威或是大众时，也能够获得情绪上的依赖感、安全感和满足感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"二、人类文明中阶级出现后的统治阶级及其统治思想。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如《商君书》中的驭民五术：壹民、弱民、疲民、辱民、贫民。其中的壹民是指统一民众的思想。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"统一的思想，在另一种意义上，就是统一的无知。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"奥威尔在《1984》里也曾说等级社会只有在贫困和无知的基础是才能存在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在封建社会，极其劳碌的生产活动已经扼杀了大部分人的独立思考能力，至于该如何对剩下的一部分知识分子解释统治与被统治的关系，统治者往往借助等级文化如“改造儒学”、宗教、种姓来压抑普通人的独立思考能力，统一思想，以此维护自身统治。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在资本主义社会，资本家作为社会的实际统治者，通过增加劳动者的工作时间和工作强度减少他们的思考时间和精力，尽可能支付微薄的薪水，制造出奶嘴乐侵占普通人的思想，控制教育体系和思想言论进行洗脑。八小时工作制的本质是资产阶级妥协和维护统治的产物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"以此来看，大部分人只是统治阶级的统治思想的附庸。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"此外，在家庭教育、社会文化和历史沿袭中，大部分人也都受到了深远持久的影响，即大部分人也是家庭、文化和历史的附庸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对于目前的人类文明来说，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"独立思考、理性逻辑只能是一部分人的追求，也只有这部分人能体会到独立思考的无穷魅力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是还有一点需要知道的是，独立思考的魅力并非来源于思考本身，而是来源于真理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"相较于群众，独立思考者往往更接近真理，不是因为什么“真理往往掌握在少数人手里“。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而是上面提到的，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大部分人的理性是情绪的附庸，大部分人是统治者的统治思想的附庸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真善美，最古老的三个人类永恒追求的精神价值。只有“真”拥有着宇宙最原始的魅力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其中，关于善与恶、美与丑的辨别，人类与人类之间没有绝对的统一，人类与自然也没有绝对的统一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但真与假，这个说法或许不够准确，应该说是真理与谬误，与前两者不同。在一定的客观条件下，真理便是绝对的。于是，在真理面前，人类与人类之间有了绝对的统一，人类与自然有了绝对的统一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是宇宙最原始的魅力。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CACA,IAAI,EACJ;IACEE,KAAK,EAAE;MACLG,EAAE,EAAE;IACN;EACF,CAAC,EACD,CACEL,EAAE,CACA,GAAG,EACH;IACEM,WAAW,EAAE,eAAe;IAC5BJ,KAAK,EAAE;MACLK,IAAI,EAAE;IACR;EACF,CAAC,EACD,CAACR,GAAG,CA