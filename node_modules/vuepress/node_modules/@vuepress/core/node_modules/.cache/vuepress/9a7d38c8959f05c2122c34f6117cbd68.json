unction render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"ol\", [\n        _c(\"li\", [_vm._v(\"忌讳频繁看盘\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"买时，强支撑位买入。\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"卖出，用斐波那契划线，同时参考之前的压力位。\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"要有耐心，相信自己的判断大多时候都不会亏钱，很多时候都是亏损跑路，然后大反转。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"学会止盈，看自己博的是大趋势还是小趋势，大趋势就贪一点，小趋势盈利回撤就跑。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"寻找周线级别阻力位，周线级别往往可以可以给我们更为精确的反馈。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"一旦近期均线钝化甚至下行，或MACD指标出现背离意味着应当考虑减仓甚至卖出。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"比特币呈现周期性的螺旋形上升，如果稍加注意规避牛熊转化的大瀑布，收益会大幅上升，同时也一定程度的降低了风险。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"当恐慌指数fgi于0～20入场买入，当fgi于80～100卖出\"),\n        ]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"以kdj，rsi双指标为基准，均低于20入场开始定投；kdj，rsi均大于80抛售。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"在1h级别，MA30均线上穿MA60均线，买入；MA30下穿MA60，卖出。\"),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"中长线\\n\"),\n        _c(\"strong\", [_vm._v(\"rsi+kdj同时小于20入场\")]),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"均大于80离场\")]),\n        _vm._v(\"\\n短线\\n\"),\n        _c(\"strong\", [_vm._v(\"1h级别\")]),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"ma30上穿ma60，买入\")]),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"ma30下穿ma60，卖出\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当黄色的 D 线出现在右侧 80 数值以上，则出现超买现象，当出现在 20 数值下方，代表进入超卖现象\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当 RSI 数值超过 70，预示着进入超买区，超过 80，是严重的超买。市场可能会调整或下跌。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当 RSI 数值超过 30 以下，预示着进入超卖区，超过 20，是严重的超卖。市场可能会调整或上涨。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"根据市场的变化来控制自己的仓位，是非常重要的一个能力。如果不会控制仓位，就像打仗没有后备部队一样，会很被动。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果市场比较危险，随时可能跌，就不应该满仓。万一市场跌了，你卖期货可能亏，但是你也没有钱买期货，这就会很被动。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"通常，在市场比较危险的时候，应该半仓或者更低的仓位。\\n这样，在市场大跌的时候，你持有的期货跌到了很低的价位，你可以入仓；等它涨的时候，再进行出仓，这样就可以赚一个差价。\\n一般来说，平时仓位都应该保持在半仓状态，留有后备军，以防不测。只有在市场非常好的时候，可以短时间的满仓。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"由于 KDJ 线本质上是一个随机波动的观念，故其对于掌握中短期行情走势比较准确。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"KDJ 指标也是摆动指数里的其中一个，KDJ 也是是常用的指数，作为指导作用的，不具备严格意义的决定作用。通常这些摆动指数都是要辅助使用，单独使用有时会滞后，失灵。要运用在流通量比较大，交易比较活跃的币种会比较实用。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它主要是利用价格波动的真实波幅来反映价格走势的强弱和超买超卖现象，在价格尚未上升或下降之前发出买卖信号的一种技术工具。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在实战过程中，对于整个超买超卖点位的判断相比 RSI 要更加的敏锐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当黄色的 D 线出现在右侧 80 数值以上，则出现超买现象，当出现在 20 数值下方，代表进入超卖现象\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"KDJ 的使用只是作为一种辅助手段而存在，投资者应参考币价的 K 线组合，量价关系，趋势形态与 KDJ 指标一起研判，当它们发出的买卖信号趋于一致之时，这样的买卖信号比较可靠。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在众多的图表技术分析中，强弱指标的理论和实践极其适合于股票市场的短线投资，于是被用于股票升跌的测量和分析中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"该分析指标的设计是以三条线来反映价格走势的强弱，这种图形可以为投资者提供操作依据，非常适合做短线差价操作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"RSI 不建议使用金叉死叉，实际运用中不是很好用，而且会导致盘面看起来更加的复杂。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所有的摆动指标都是作为指导作用的，不具备严格意义的决定作用。通常RSI摆动指数都是要辅助使用，单独使用有时会滞后，失灵。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"运用中的注意事项\")]), _vm._v(\"：\")]),\n      _vm._v(\" \"),\n      _c(\"ol\", [\n        _c(\"li\", [\n          _vm._v(\n            \"当价格趋势处于极强或极弱状态下，RSI 经常会出现超卖后继续超卖，超买后继续超买，也就是所谓的指标钝化，这时要结合其他技术指标来分析，比如，均线，MACD 等。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\"RSI 对价格波动比较敏感，属于短线技术指标，中长线不适用\"),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"RSI 的超买超卖现象不是经常发生，但在超买超卖的中间区域，指标的高低也可以预示价格的转向，结合指标的背离来辅助判断。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"macd指标的应用\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#macd指标的应用\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" \"),\n        _c(\"strong\", [_vm._v(\"MACD指标的应用\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"MACD指标\"),\n        _c(\"strong\", [_vm._v(\"属于趋势跟踪指标，不适用与横盘行情\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"零轴以下为空头强势。如果\"),\n        _c(\"strong\", [\n          _vm._v(\"柱状图在零轴下持续增长幅度由大变小，则表示跌幅变小\"),\