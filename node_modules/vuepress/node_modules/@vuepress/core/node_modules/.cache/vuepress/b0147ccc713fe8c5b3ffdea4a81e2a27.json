{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/01.网文梗概-序.md?vue&type=template&id=684bea85","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/01.网文梗概-序.md","mtime":1768579404249},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","id","staticClass","href","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/01.网文梗概-序.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"我想可以做一个关于写作的专题，让和大家一样喜欢写作、热爱生活、想表达同学们一起进步。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"来了只是讨论经验，不是为了寻找绝对答案。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"要说小说怎么写还真的没有定法，又或者这个问题定得太宽了，所以我们从最基础的重新开始。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如：怎么组织场景？怎么描写场景？怎么详略得当？肖像描写有哪些技巧？场景描写有哪些技巧？怎么烘托气氛？怎么分析并表现人物性格？等等等欢迎补充\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"小说类型特点\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#小说类型特点\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 小说类型特点：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"玄幻小说。玄幻是网文的第一大类，纵观全网，玄幻题材拥有非常庞大的作品数量和读者数量。网文中的玄幻，是东西方幻想文学的杂糅，它是以中国的东方幻想元素为基础，主要融合西方魔幻、科幻、动漫、武侠等元素，从而形成的一种所谓的玄幻小说。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"仙侠小说。在传统文学上，并没有仙侠这一题材类别，事实上，仙侠小说可以说是网文独有的一种门类。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"都市小说，故事背景设定为现代都市的小说，这种类型的小说有着贴近生活、取材方便、读者容易接受等优点，近年来涌现了大量的都市小说，也很受广大读者的喜欢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"历史小说、历史传记是基于原有的历史人物写的一种类似野史的人物传记，在原有的世界背景和人物背景下，以戏说或者其他方式来重新塑造该历史人物的人生经历与性格特征。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"科幻小说大多属于软科幻，并且没有太过专业的物理知识，只是在其中加入了一些科幻的元素。比如未来背景、末世背景等等。科幻小说其实本质是玄幻的一种延伸，并不要求作者本人有极其扎实的理工底子，而只是将背景转化，讲述的是在未来、末日、大星际时代这些背景下，人物的故事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"灵异小说虽然相对小众，但是读者的忠诚度很高，以道士、驱魔人之类的职业偏多，结合传统的鬼怪故事，大都发生在现代都市当中，也算是现代都市的一个变种。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"竞技类小说的特点是，主人公大都是职业运动员，包括田径、足球、篮球等热门的，受欢迎的运动。其实这也是一种期待，越是没有，就越期待。这种小说也属于小众，同样有一群忠诚度高的粉丝在追。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"网游小说大致分为两种，网络游戏与电竞游戏。网络游戏就是传统的，类似于ARPG一类的游戏，分为PVE（玩家对系统）、PVP（玩家对玩家）两大类。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"军事小说相对而言的要求就比较高，也属于偏小众的类型，需要作者本身对于军事知识有一定的了解。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"简单分析网站收入\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#简单分析网站收入\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 简单分析网站收入\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"晋江网\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#晋江网\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 晋江网\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"新人榜，在一个月内发文积分排行，一个月下榜。也就是说要比你同期注册的人，发文积分多才可以上榜，基本上要保证每天更新2000到3000字左右，一周大概15000字，这样才有可能上榜，进入下一波季度排行榜。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"季度排放榜，是发文时间在第31至90天内的积分排，91天后下榜。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"以此类推，月榜，季榜，年榜，都是要有一定的积分，才可以上榜。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而积分的数量，主要取决于文章的内容和字数，和相关的点击率，评论，还有收藏，这都是要看人气的，其中最重要的就是不要断更！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"另外，在晋江抄袭的处理非常的严重，也尽量避免雷同的文字，文字雷同超过25字，就很可能会被黄牌清理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"除此之外，就算新手“生存”下来了，但是要签约的话，并没有那么容易。而且并不是签约后就收入就一飞冲天了，也有许多作者签约后，收入仍是零。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为频道不一样，作者的地位也不一样，晋江没有底薪，只有分成，所以收入一定是和文章的质量成正比的，不要产生侥幸心理，好好写文才是王道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"番茄\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#番茄\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 番茄\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"签约成功就有广告收入、听书收入、打赏催更收入等等；\\n10万字有网站的大推荐，10万字前后保持日更4千字；\\n10万字后日更4千，有全勤600，可以一直拿，不存在拿几个月这种限制；\\n20万-140万字，还有星火奖励，每月800-200030万-70万字；\\n还有魁星奖励，千字20-千字100块。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在番茄上的签约率，相对还是比较高的，而且也是比较容易出爆款，只要坚持写够10万字，就会有收益，当然收益多少是跟文章质量成正比的，文章写的好的，收益自然就多。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"作品达2w字时可在番茄作家助手App内申请签约，但签署流程仍需在电脑端进行，如果2万字没过的话，一定要继续发作品，发到5万字或者20万字时，再次进行签约申请，就很容易过了，申请签约机会一共有三次。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"签约之后需要注意数据的变化，尤其是读完率（X万元字读完率＝阅读完此字数累计人数/首章阅读人数）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还有新人必须要注意的是，一定不能到处打广告宣传，也许你的宣传就影响了智能推书的判断，导致你的受众与你的风格不符。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果写满10万字，也够 50章了，会有网站的大推荐。10万字前后的时候，一定要保持日更4千，同时还要关注作品在读人数和作品评分变化，如果没有达到预期，就要调整内容和更新了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"说来说去，最主要还是要看作品质量，内容一定要多，一定要多制造看点，有了看点，才能吸引读者，这样点击率才能够上来，再有就是故事逻辑性一定要强，情节要丰富，这样才能抓牢读者，就是那个读完率才能高。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果新人不在乎收入，也可以试着去混个全勤\")]),\n      _vm._v(\" \"),\n      _c(\"table\", [\n        _c(\"thead\", [\n          _c(\"tr\", [\n            _c(\"th\", [_vm._v(\"平台\")]),\n            _vm._v(\" \"),\n            _c(\"th\", [_vm._v(\"优势\")]),\n            _vm._v(\" \"),\n            _c(\"th\", [_vm._v(\"劣势\")]),\n          ]),\n        ]),\n        _vm._v(\" \"),\n        _c(\"tbody\", [\n          _c(\"tr\", [\n            _c(\"td\", [_vm._v(\"番茄小说\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"签约率高，容易出爆款\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"稿费低(我那一本只有0.05一章)\")]),\n          ]),\n          _vm._v(\" \"),\n          _c(\"tr\", [\n            _c(\"td\", [_vm._v(\"知乎盐选\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"文笔提升非常快，稿费多\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"过稿不容易，文笔要求高\")]),\n          ]),\n          _vm._v(\" \"),\n          _c(\"tr\", [\n            _c(\"td\", [_vm._v(\"公众号付费阅读\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"可以积累自己的粉丝，写的内容看自己心情\")]),\n            _vm._v(\" \"),\n            _c(\"td\", [_vm._v(\"前期变现比较难\")]),\n          ]),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"收入\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#收入\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 收入\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我身边写小说的许多朋友里，刚开始写小说的时候，最差的收入是0，好一些一般的收入在2000元-5000元左右，收入好的有1万元左右的。在2000元-5000元这个阶段的人还是比较多的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果想赚更多的钱，主要还是和小说内容与平台有关。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"新人写小说的月收入，还是要根据写作能力和小说的阅读量来定的，具体的金额是没有办法估算准确的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"新手在刚开始起步没有签约的情况下，收入主要是读者打赏的礼物，和保证每天的更新字数，来换取少的可怜的出勤保底，一个月下来可能只有几百元到一千元左右吧。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAA