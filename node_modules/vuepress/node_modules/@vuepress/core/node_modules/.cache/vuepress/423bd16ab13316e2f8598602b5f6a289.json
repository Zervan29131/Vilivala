{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/01.关于大脑.md?vue&type=template&id=80fabe7e","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/01.关于大脑.md","mtime":1768579404259},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","id","staticClass","href","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/01.关于大脑.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"人的大脑经历了几百万年的演化，在进化过程中获得了许许多多的能力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不过大部分为我们所津津乐道的能力，比如社交，推理，感知什么什么的，都是到了很晚才出现的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"早期大脑的功能十分简单粗暴，就是使用一切可能的手段活下去。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以那个时候人脑的一大部分工作是执行基本的生理过程，监控人体状态，清理体内垃圾，诸如此类。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"操控这些基础功能的是小脑和脑干，有时候也直接统称为爬行脑，意思就是很原始。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而那些新出现的功能大多集中在大脑皮层，即“新皮层”。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"或许有人会觉得爬行脑和新皮层会团结一致，互帮互助，再怎么说也是相安无事\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然而并不是，这俩家伙每天都会从早吵到晚，给我们的生活带来一大把的麻烦，接下来我们就看看人脑会如何干预我们的生活\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\n        \"h3\",\n        { attrs: { id: \"人脑为什么会晕车、晕船-以及为什么晕车了会吐\" } },\n        [\n          _c(\n            \"a\",\n            {\n              staticClass: \"header-anchor\",\n              attrs: { href: \"#人脑为什么会晕车、晕船-以及为什么晕车了会吐\" },\n            },\n            [_vm._v(\"#\")]\n          ),\n          _vm._v(\" 人脑为什么会晕车、晕船，以及为什么晕车了会吐\"),\n        ]\n      ),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在人的耳朵里面，有一套前庭系统，其实就是一组内含液体的管道，用来探测身体的平衡和姿势，里面布满了神经元，感知其中的液体变化以及位置。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人的各项行为都会产生一套独立特殊的信号，所以大脑可以准确的判断人正处于什么状态，比如走路的时候你会看到周围的东西在运动。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"同时你的前庭系统也感知到了一定规律的信号。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"于是得出结论：正在走路\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但是你正在坐车，你多半是感觉不到周围物体（车子）的运动的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是你的前庭系统清晰无误地告诉你，你在运动着。你的系统就出现了混乱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在新皮层看来，这只是坐车而已，很正常。但是在爬行脑看来，这是个大问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"爬行脑觉得，只有一种可能的情况会导致两套系统信息不对等，那就是中毒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这次爬行脑占了上风。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"于是人脑开始释放大量激素，激活呕吐反射，让你把毒素吐出来。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"当然也有可能是上厕所，但在车上我估计是没法上厕所的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"总之你会吐个没完，直到你把自己的胃酸都吐出来。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以晕车的时候，可以靠窗，打开窗户，看看外面的风景。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"打开窗户能够让人脑接收到的信息更接近自然界，比如说风声，气味什么的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"大脑对于进食的控制\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#大脑对于进食的控制\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 大脑对于进食的控制\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们在吃东西的时候，随着食物进入，胃部慢慢膨胀，胃部的神经就给大脑发信号。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"让大脑抑制食欲，这的确很合理。这也是那些减肥奶昔的原理。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"减肥奶昔是种浓稠的物质，吃下去之后体积会膨胀，这种奶昔的膨胀会快速填满胃。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所以要减肥还是多运动，影响人的食欲的不仅仅是胃部神经。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"比如刚刚说的心情，又或者是甜品之类的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"众所周知，甜品中的碳水化合物会刺激大脑的奖励回路，会让人心情愉悦。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而这种感觉人脑十分清楚，并且明确的想获得，其实主要是新皮层想获得。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"爬行脑对这种生存以外的东西抱有相当的警惕。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但这次是新皮层赢了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人脑直接驳回了胃部发来的信号，并且告诉胃部：你还装得下，吃吧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"人脑以及睡眠\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#人脑以及睡眠\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 人脑以及睡眠\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"首先要说明：我们目前还不知道睡眠到底是为了什么。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人们几乎在所有动物身上都观察到了睡眠（采取比较宽泛的定义）\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"当然也有不睡眠的，比如水母，海绵之类的，但它们都莫得大脑。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"现有理论很多，说说比较有名的几种\")]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"治愈说\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#治愈说\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 治愈说\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们可爱的小白鼠，如果不睡觉的话，伤口愈合会慢很多。\\n对于人而言，除了可以让伤口愈合更快，还可以缓解负面情绪，有时候心情不好可以通过睡一觉来解决。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"防止被捕形成的习惯\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#防止被捕形成的习惯\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 防止被捕形成的习惯\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的祖先以前是生活在荒郊野岭之中的，随时都有被吃掉的风险，很多捕食者都在夜间活动，要是这个时候到外面瞎晃悠，那被吃的可能性也会大大增加。\\n而睡觉的时候，人体活动减少，体温降低，被发现的概率就大大降低了，拥有这种习惯的祖先就活了下来，另外一些，大部分挂了，少部分欧皇活到了现在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"晚上不睡觉是会出大问题的，过长时间不睡觉会导致身体器官衰竭\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"睡眠并不是为了休息，至少不仅仅是为了休息。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不然的话为什么我们不论是裹着被子追了一整天的剧，还是在太阳底下搬了一整天的砖，睡眠时间都差不多呢\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"大脑如何保证你的安全\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#大脑如何保证你的安全\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 大脑如何保证你的安全\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们先来描述一个场景：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你躺在床上，睁着眼睛感觉睡不着，觉得墙上树投下的光影越看越别扭，越看越像某种怪物的爪牙\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"接着，你看见卧室门背后一个身着斗篷的人影，接着你满头汗的打开灯，打算跟那个人殊死搏斗，拼个鱼死网破。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"发现那只是你睡前挂在门背后的一件睡袍，还是那句话：我们的祖先生活在荒郊野岭之中，随时都有可能挂掉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那些发现动静之后觉得“有危险，赶紧跑”的祖先，比那些觉得“让我看看是谁来了”的祖先更有可能活下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人脑的这种反应我们称之为“战或逃反应”，顾名思义，发现危险，要么跑，要么干一架。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"来自感官的信号到达脑，进入大脑中心枢纽-丘脑，到达丘脑的信息有时候很令人不安。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有可能是陌生的信息，也有可能是熟悉，但很不妙的信息。比如说你在森林里迷路，一声吼叫就属于陌生信息。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你在家里偷偷摸鱼打游戏，突然出现的上楼梯脚步声就属于熟悉但是不妙的信息。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"接着这些信息被插成两半，一半送往大脑皮层进一步分析，接着进行判断“是否需要担心？”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"主要依据是人的记忆，另一半被送到一个专门处理强烈情感情绪——尤其是恐惧——的脑区，杏仁核。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"杏仁核的做法也十分简单粗暴，感觉什么东西不对就直接亮红灯，速度远远快过大脑做复杂分析的速度。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"信息处理完之后，人脑就知道该怎么办了，组织信号发到下丘脑。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"下丘脑的主要任务就是让身体动起来，也就是真正启动战或逃反应。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"首先瞳孔会放大，让更多的光线进入眼睛，看清周围状况，设计路线逃跑，其次增加心率。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"调动周围一切可能的器官、系统向肌肉输送血液，那直接吓晕的属于什么？（包括消化，唾液分泌什么的，所以会口干）\\n直接吓晕可能是因为血压过高。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这么做是为了让我们有充足的能量战斗，或者跑路，所以会觉得全身紧绷。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然后，所有的身体感官也会被放大，听觉，嗅觉，触觉等等，也包括对自己身体状况的察觉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而且，战或逃反应还会促进肾上腺素水平暴涨，让体内到处充满肾上腺素。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"产生一系列反应：胃抽筋、紧张、呼吸急促、喘不上气，甚至排便。\\n因为身体并不想带着额外的体重战斗或者跑路，吓尿更可能是因为括约肌的血液被弄走，失去了控制能力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大脑的情绪处理也会上紧发条，面对威胁我们需要收到激发，把自身各种能动用的资源都用上。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以我们会感到强烈的害怕或者愤怒，而强烈的害怕和高度敏感的身体感官则会让人产生幻觉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"都是大脑自己脑补出来的\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GA