{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/14.少用副词.md?vue&type=template&id=4d000a02","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/14.少用副词.md","mtime":1768579404253},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/14.少用副词.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"斯蒂芬·金的名言“通往地狱的路是副词铺就的”，这句话我先是在一篇网文中看到。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我当时极其的不明白，为什么是副词？凭什么是副词？后来看了斯蒂芬·金《写作那回事》，我感觉斯蒂芬·金他自己也没有说完全说清楚，这是为什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"直到后来，学习了解了海明威的“冰山理论”后，我想，我应该明白了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"海明威的对话描写极其强悍，尤其是《老人与海》中的对话非常有力量，如下：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '​     “圣地亚哥，\"他们俩从小船停泊的地方爬上岸时，孩子对他说。\"我又能陪你出海了。我家挣到了一点儿钱。”\\n　　 老人教会了这孩子捕鱼，孩子爱他。\\n　　“不，”老人说。“你遇上了一条交好运的船。跟他们待下去吧。”\\n　　“不过你该记得，你有一回八十七天钓不到一条鱼，跟着有三个礼拜，我们每天都逮住了大鱼。”\\n　　“我记得，”老人说。“我知道你不是因为没把握才离开我的。”\\n　　“是爸爸叫我走的。我是孩子，不能不听从他。”\\n　　“我明白，”老人说。“这是理该如此的。”\\n　　“他没多大的信心。”\\n　　“是啊，”老人说。“可是我们有。可不是吗？”\\n　　“对，\"孩子说。\"我请你到露台饭店去喝杯啤酒，然后一起把打鱼的家什带回去。”\\n　　“那敢情好，”老人说。“都是打鱼人嘛。”'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你看，海明威在写对话的时候，很少在“他说”“我说”之前加上一些修饰语。假如加了修饰语，可能就会像这样：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“不，”老人\"),\n        _c(\"strong\", [_vm._v(\"坚定地\")]),\n        _vm._v(\"说。“你遇上了一条交好运的船。跟他们待下去吧。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为什么海明威没有加修饰语？因为，任何一篇小说，都有三个要素：作者，小说的人物，读者。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“小说中的人物”如果与“读者”的距离越短，就越有展示力，就越真实。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可是，就像上句对话中的【**坚定地】**这个词，很明显，他是作者的主观描述，得，这下问题来了，读者是根据作者的主观来了解人物，而不是人物的对话，这中间多了一个中介（作者）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而中介越多，读者到人物的距离就会越长。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"另外，我自己的另一个理解是，如果在“我说”“他说”之前加上很多修饰语，其实是一种偷懒的做法，这很不好。为什么？我们举例来说一说。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果作者要表现一个角色的愤怒，比如，他可以这样【他愤怒地说：“你给我滚开！”】\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你看，你直接在“他说”里面加上了“愤怒”这个修饰语，那么你会认为，你已经充分表达了人物的愤怒，从而，你不会再搜肠刮肚地找一些更适合人物的对话。总而言之就是这样，要想办法用对话表现人物，而不是偷懒地加上一些修饰语来表现人物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还有一个，这才是最重要的。同样一句话，每个人都会有不同的理解，如果作者强制加上一些修饰语，就把这种蕴含在背后的美妙感觉锁死了，这会造成挂一漏万。比如这句话：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“不，”老人说。“你遇上了一条交好运的船。跟他们待下去吧。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"假如你改成：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“不，”老人\"),\n        _c(\"strong\", [_vm._v(\"坚定地\")]),\n        _vm._v(\"说。“你遇上了一条交好运的船。跟他们待下去吧。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这好吗？这是相当的不好。原因如下：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"一、难道老人说那句话时，内心只是“\"),\n        _c(\"strong\", [_vm._v(\"坚定”\")]),\n        _vm._v(\n          \"？可能海明威还会认为，老人内心应该还夹着一种期盼，期盼孩子跟他一起捕鱼，同时还夹着一层对孩子的关心。那么，你说海明威现在应该怎么做？难道他应该这样写对话：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“不，”老人\"),\n        _c(\"strong\", [_vm._v(\"坚定地、期盼地、关心地\")]),\n        _vm._v(\"说。“你遇上了一条交好运的船。跟他们待下去吧。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"显然，这是不可能的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"二、假设，这是可能的，这是读者喜欢的，那么，你能说海明威的描述已经完美了吗？也没有，小说写出来后，有时候作者甚至都难以百分之百地把人物的内心猜透。人物说那句话时，可能还有别的心里，但作者不知道，这就会导致挂一漏万。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"三、现在再假设，任何时候，作者都能百分之百地猜透人物的内心，并在“他说”里面加上5个副词来描述。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这样就完美了吗？显然，这也不完美，一千个读者就会有一千个哈姆雷特，作者怎么可能完全猜得透读者读到这句话时，会怎样琢磨人物？这是不可能的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，结论是，无论你用多少个词来描述“他说”，都是不完备的。既然不完备，何苦做无用功，而且还让读者看上去就像王大妈的裹脚。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因此，最明智的做法，就是一个副词也不加。哪怕加上一个，都是不好的。因为这会限制读者的想象。比如\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“不，”老人说。“你遇上了一条交好运的船。跟他们待下去吧。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"假如你加了一个“坚定地”来描述老人说，那么就等于是宣告了老人此刻的内心只有“坚定”。但其实，人物的内心是复杂的，读者看到这句对话时，内心也是复杂的，可是因为你的臭水平，擅自加上“坚定”，一切便都没有了，只剩下了“坚定”这个感觉。这不就是捡个芝麻丢个西瓜吗？很愚蠢，不是吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"一篇小说，如果读者没有想象的空间，那就不是一篇好小说。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最后，小说的本质是一种展示，而不是一堆形容词的描述。你要说人物此刻很恐惧，那你不能只是找几个关于“恐惧”的形容词来告诉读者，人物此刻很恐惧。而是要用人物的行动和对话向读者展示出来，让读者就像看电影一样。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最后，关于冰山理论，要求作者只写出八分之一，留八分之七给读者去想象。想象是美好的，每个读者都会有自己专有的想象，好小说就是要让人回味无穷，假如作者把八分之八全写了出来，这其实是一种不自信的做法，而且很没有技术含量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这就是我对“通往地狱的路是副词铺就的”这句话的理解。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这句话要想发挥效力，对话必须是短小精悍，极富信息，如果对话就像王大妈的裹脚，又臭又长，那，再谈什么副词，就没有意义了。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,sEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kCACF,CAA