{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/03.柏拉图谈爱情.md?vue&type=template&id=5f8a9584","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/03.柏拉图谈爱情.md","mtime":1768579404254},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/03.柏拉图谈爱情.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"爱情是什么\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#爱情是什么\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 爱情是什么\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"自古以来人们不断问着同样的问题，爱情却似乎未曾变得容易，不论意愿或理性与否。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也许正是因为爱情的无厘头与不可预期，直到今天爱情的概念仍如爱情本身一般神秘，不愿被理性或知性捆绑框限在概念之内。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"爱，展现为一种吸引力，拼命地让一物靠近另一物。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"柏拉图的对话录里面，爱不管谁来定义都无法不将它所引发的吸引力考虑进去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正因为这种吸引力如此强烈，在物之间形成了强而有力的连结，古希腊哲学不仅用爱来说明两人之间的吸引力，更用来说明物体之间的物理运作，柏拉图更将它视为巩固社会连结的充要条件。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在理想的城邦中，如果每个成员相互爱恋，那么人们不忍为自己所爱之人为恶，更不容忍所爱之人遭受危险，城邦因此团结无法分割。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们不断寻找、建构更多理性的社会机制来巩固社会团结与其功能。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"早在古希腊，柏拉图就注意到了情\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"感比理性更能联系两个不同的个体。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"「没有爱的爱情，才是最好的关系。让人不沦于所爱之人的奴隶，让人不丧失作自己主人的权力。」\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"柏拉图的〈费德罗篇〉以这样一个爱情论证开头，道出苦苦单恋之人的痛，痛得让人把矛盾当真理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"爱让人疯狂，让人在所有理性计算中放弃把自己摆在优位，让人做出错误判断。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"爱情的难题\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#爱情的难题\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 爱情的难题\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于柏拉图来说，爱情，就是冲动，如果理性可以驾驭，那么「不可能」就不会成为「可能」\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"仅凭信念放胆一跃，不管谁都不会认为这属于理性，但多半却会同意这是爱情所引发的效应。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们的灵魂，宛如双头马车，一匹代表着理性，安稳温训；另一匹代表着欲望，狂傲难驯。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"爱情，不管带来的结果是好是坏，爱只发生在欲望凌驾理性之时，否则爱就不会体现出超越理性计算的冲动与动力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但如果不管结果好坏，爱都属于欲望而非理性，那么要如何解释有些爱开出勇敢美丽的花朵，有些爱只引来自我毁灭？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"「爱情的对象决定了爱情的结果。」\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们渴望、所爱的总是让我们觉得美的事物，然而美的事物却包含那些「美丽却稍纵即逝」以及「美丽且永恒」的事物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我们渴望的，是那些稍纵即逝的美好，那么自然而然，爱情所给的回应也是稍纵即逝、瞬息万变。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"反之，若我们渴望的美好本身恒常稳定，那么爱情自然展现出恒定美好的状态。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"若我们爱的，是对方面孔身材之美，那么不用等人落黄花，只要巧遇更美的脸孔，也不必惊讶自己见异思迁。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"爱情的对象即是欲求的对象，而我们之所以欲求因为想要得到我们尚未拥有的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因此，爱情的对象如果可以实际取得且满足欲求，那么所爱之人不仅只是满足欲望的工具，爱情更在欲望满足的当下就失去它的吸引力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"反之，如果爱情欲求的对象，不是所爱之人的脸孔、身体、甚至不是这个人，而是对方同时正在追求成为更好之人的德行，那么与其相互在对方身上寻找填满自己空虚之物，爱让两人看着同一个想要自我实现的远方，并肩走去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"爱情的规范\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#爱情的规范\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 爱情的规范\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"「怎么解释精神出轨？」\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"现代的爱情将太多本来不相干的事物混杂在爱情里面，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"催眠让大家相信爱情就是要走进婚姻、就是要忠诚、要温柔体贴浪漫乖巧贤慧相互支持耐心等待服侍伺候孝顺诚实。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"古希腊时代，爱情跟婚姻毫无关系，爱情发生在成年男子与少男之间、婚姻则在男女之间用来巩固家庭为单位的经济个体。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这里不是想要鼓励大家以爱情为名出轨，而是在为情而苦的时候回头想想，那些自己强求的东西跟爱情之间到底有没有什么必然关系？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"如果没有，那么剩下的也许是选择，而不是怪罪爱情的不完美。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人的有限，看似原罪，却也是让每个人展现出独特存在的条件。\"),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAQ;EAAE,CAAC,EAAE,CACnCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAS;EAAE,CAAC,EAC3D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,QAAQ,CAAC,CACjB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,