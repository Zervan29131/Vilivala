() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"文艺复兴为什么能够催生现代自然科学？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"刘慈欣在《三体》中，讲述文明发展的黑暗森林理论时候，其中技术爆炸是最重要的论据之一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"文明进步的速度和加速度不见得是一致的，弱小的文明很可能在短时间内超越强大的文明。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对于人类文明来说，最近400年的技术发展超过之前10万年人类技术进步的总和。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"文艺复兴之前，思想者和劳动者一直是相分离的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而文艺复兴的伟大成就使这两者联合起来。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人类社会中的匠人通过观察和试验，逐步改进自己的技术，使得他们的技术达到很高的水平，不过这样的进步受到了明显的限制。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其根本原因在于，匠人仅仅对于制作罐子，建造房屋的技术感兴趣，而不会去研究因果现象之间的关系，例如化学原理或者机械原理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"通过实验和观察发展起来并引起进一步实验和观察的一系列互相联系的概念系统。而概念系统便是构成科学的基础。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"匠人们缺乏“概念系统”。相反，这样的系统历来是哲学家们所关心的。但是哲学家们对日常生活不了解，也无力处理。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"实际知识和了解潜在原因的结合，奠定了科学的基础。推进了科学的发展，使得科学成为今日的支配力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"文艺复兴的人文主义思潮，使得人类开始把宗教上的注意力转移到人类和自然界自身。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们通过接触柏拉图、亚里士多德、欧几里得和阿基米德来促进物理学和数学的进步。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们不希望通过宗教和哲学家的嘴来看待历史，而是直接通过原始资料来阅读原文。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"更重要的是从各类科学中受到了极大的鼓舞和启发，使得医生们研究了希波克拉底和加伦的全部著作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而文艺复兴的人文主义学术成就则使得学者和艺术家强烈反对中世纪的生活方式，努力创造尽可能与古典时代的生活方式相似的新生活方式。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"由于资本主义开始萌芽，工匠的地位得以提高。人们尊重纺纱、织布、制陶术、玻璃制造、尤其是日益重要的采矿和冶金术方面的实用工艺。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"工匠们不会再像古典时代和中世纪时代那样受鄙视。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"并且在这个时期的行业都是由自由民经管而不是奴隶。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而工匠的地位的提高，使工匠与学者之间自文明开始以来一向非常脆弱的联系能得到加强。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们各自都作出了重要贡献。工匠拥有古代的旧技术，并在旧技术上添加了中世纪期间发展起来的新发明。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"同样，学者提供了关于被重新发现的古代、关于中世纪的科学的种种事实、推测及传统做法。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这两条途径的融合是很缓慢的，但最终，它们引起一个爆发性的融合。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,