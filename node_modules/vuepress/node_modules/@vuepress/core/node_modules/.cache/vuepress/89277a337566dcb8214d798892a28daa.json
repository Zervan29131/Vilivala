{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/17.伍小天（内向）.md?vue&type=template&id=609dc9de","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/17.伍小天（内向）.md","mtime":1768579404271},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《人物设定集》/17.伍小天（内向）.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"性格看上去大大咧咧的，对很多事情都不在乎。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"平时也不怎么爱笑，在陌生环境就不太爱说话。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"看上去总是沉默寡言的，很冷淡，也有些敏感，总是宅在自己的小空间里。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在人群中，总喜欢戴着耳机，安静地待在那。遇见出风头的事，也从不争不抢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多人说他是个冷漠的人，甚至不合群。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是在路上遇见流浪的小猫，他总会蹲下来，喵呜喵呜的围着小猫转。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他会安静地听别人诉说，却不愿说出自己的心声。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他已经好久没发朋友圈了，却会点开好友分享的音乐。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"有时在网上看见素不相识的人水滴筹，他也会偷偷的伸出援手。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他的心思细腻，比较注重生活里的小细节。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如某个人的言行举止有打扰到他，他也不会当面吵吵说出来，只是让自己尽量不与她接触。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他曾在别人开口之前，先说自己情商低，冷傲不好接触，只是为了不让自己从别人嘴里先说出来是那么地难堪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他很内敛，不喜欢去表现自己，但是很在意尊严。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"注重良心、道德、礼仪，好像身上有着文人与生俱来的风骨，从不去做谄媚迎合的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"多数时候他并不会主动，如果是的话，肯定鼓起了莫大的勇气。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有的时候，为了让自己看起来合群，他会主动地走进新环境，其实他的内心深处是渴望与人交流的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是渐渐，他发现无意义的社交太多，乱七八糟的小事总是起起伏伏，他讨厌惺惺作态的样子，虚情假意、装腔作势也让他很是疲惫。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他又开始变得沉默了，就像是之前一样，一个人就是一支队伍。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他甚至可以好几天不与人说话，因为没人愿意真正了解他的内心。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我曾问他为什么突然变得冷漠了，他说只是回到了自己最初、最舒服的状态。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生活中也没有那么多值得深交的人，他不想把时间和精力都浪费在并不持久的关系上，麻烦事最好少一件是一件。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我了解他，知道他并不是不会社交，相反他知道怎么很快和人打成一片。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"大场合他也从不畏畏缩缩，在人多的时候也可以整出新花样来。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"虽然和女孩说话有些羞涩，但是也是敢爱敢恨，敢说敢做的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他其实很早就知道，没有人会真正希望你好。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"别人只会匆匆瞥一眼你的成果，给你贴上一个标签或是印象，然后满是羡慕或是嫉妒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多人看他总是独来独往，觉得他是那样地孤独可怜。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我曾问他，他说请收起你的怜悯，别他妈多管闲事。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他从不觉得孤独，他有着自己的归属。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虽然有的时候，也会羡慕别人成双成对，但是他也会大方地和异性朋友出去玩，没什么拘谨。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只是他经常会沉浸在自己的世界里，心中自有一方天地，也许冷漠刚好可以让他与这个纷乱的世故隔开。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他的骨子里有着天真的东西，比如他曾看着天上的浮云发呆，幻想着自己成“大”字样挂上去，就像是巨大棉花糖似的柔软。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他不喜圆滑，也不够务实。虽然不是聪明，但是忠于自己的选择，也一直在为自己的小小梦想而努力着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他喜欢日落之际，走在小镇的黄昏。看远山的余晖成林，透过一线街边冒着热气的小摊，落在出来弯腰买熟食的大爷大妈银发上。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"傍晚的风恬静轻谧，天空挂着一层深色的云霭，宛如天河映照在人间的色彩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"光影追着欢声笑语的孩子跑，最后变成丝丝缕缕的人间烟火散向行色匆匆的路人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"看着眼前光景汇成一片斑斓，他的脑海里闪过许多关于从前的记忆，这让他想要流泪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很多人说他是个冷漠的人，但是他的感触细腻，笔触柔情。其实他的温柔是有棱角的，只在乎真正关心他的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他懂得尊重，懂得感恩，他知道这世上有许多的不幸，但没法与太多的人共情。他是个清醒而自知的人，也有着自己的故事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他最喜欢天上的月亮，独立灿然于人间。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他告诉我突然冷漠，哪怕是一直冷漠也没什么，可怕的是失去了自己内心的追求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"每个认真活着的人都是独一无二的，精神不死，永远丰盈着我们的人生。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只能说现在有很大一部分人会这样，很大程度上是因为小时候和自己的性格原因，或许那类人从小就是不善言辞的也内向，长大后会故意显得不那么内向，但是时间久了总会意识到该做回自己了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不喜欢麻烦别人，很多事都是自己一个人独立去完成，实在不能实现会寻求帮助，也会在意别人的看法，但是没以前那么强烈，也学会了自愈，不喜欢找别人来倾诉，第二天又会好了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"其实这个没什么不好，至少在接触这方面，自己舒适了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实是善于言辞的，但是任何沟通都基于一定东西的，比如专业或其他……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"交一个这样的朋友，最好的方式就是留有空间，给对方选择的机会。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如你想和他吃个饭钓个鱼，你应该说：“如果哪天你觉得一人钓鱼没意思，可以来找我，我还认识家不错的餐馆。”而不是“周末去钓鱼好不好？”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"既使你内心思想再丰富，写的再细腻，再觉得自己与众不同，再善良，也无法消除人的本性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"是人就要吃饭，就有虚荣，就有劣根性，无论他的成就多高，都一样，人只有智商的高低，没有本性的区别。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"情商是高的，不代表处事圆滑。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"本性虽趋近，在抉择面前反映出的不止智商，还有个人修养和价值追求，也能侧面映照生存环境和当地人文，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人从不是个体存在的，社会的意识会映射在每一个人身上，钥匙或在浩瀚宇宙，或在意念信仰，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有一点很可疑，智慧除了给人类带来文明科技，也使人类异于其他动物，暴虐和贪婪，这是毁灭的预兆，全因地球的封闭性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"某些人得热情，对他来说也是多余，你未入他眼，他只会觉得烦躁，虽不会说什么，但那里都能看到敷衍，因为他知道他能和那些人聊的来\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他不在乎失去或得到什么，失去会难受，叹口气，得到能看到眼睛在放光，没有表情，没有话语\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他听到别人说自己好像一根木头，他笑笑走了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“面具已毫无意义，放下伪装做最单纯的自己！”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"孤独是一个人的主观感受。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"所谓孤独，只是你亲近的的人没有满足你的索取时你的不满罢了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"偶有几次良心发现，遂高高兴兴给自己贴上孤高标签\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"能独立于这个人情社会之外，他还是幸福的，但更多的人是为了生活必须融入为自己所不向往的环境，最烦听到什么那你就别在这啊，换个舒服的地方啊。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有时候表现内向的人，是因为对别人没兴趣。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在我父母眼里，我就是一个闷罐子，做什么都不积极，喊人也不会，祝酒也不会，平时也不爱出去玩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在同事眼中，我相对慢热，在聚会上也不多说话，平时也没什么社交。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在我自己眼里，我真的不关心别人发生了什么，也不想听别人吹牛逼，有些人无论说什么，我都会在心里默默吐槽“与我无关”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在聚会上有些人相谈甚欢，我可能已经思绪飞到天边了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"别人说的话，其实我根本没有兴趣，所以回复也是敷衍。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我觉得与别人交往的前提是，要对这个人感兴趣(这里的兴趣可能是各方面的)。兴趣产生动力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果没有兴趣，连敷衍我都懒得敷衍。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"总有人说，内向的人善于倾听，其实根本不是，内向的人更容易沉浸在自己的世界中。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,8BAA8B,CAAC,CACvC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,C