{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/05.「谈恋爱」这件事.md?vue&type=template&id=b22fd116","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/05.「谈恋爱」这件事.md","mtime":1768579404254},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/05.「谈恋爱」这件事.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"「谈恋爱」这件事，不只是为了休息日能一起去哪玩，那只是附带的东西罢了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"「互相支撑着对方的生活」才是交往的本质。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比起在一起的时候，倒不如说在不能在一起的时候，两人互相能成为对方的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这才是最重要的一点。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它是让人在工作很辛苦的时候，只要想起对方的脸，就能再努力一把的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它是在自己快要败给其他人的诱惑的时候，只要想起对方的脸，就能纠正自己的感情，下定决心“还是回家睡吧”这样的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它是能成为在自己房间乱糟糟的时候，只要想起对方的脸，就能决定“还是整理一下吧”的原动力的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"能互相给予对方“在看不见的地方让自己的生活变得丰富”这样的力量，这才是“交往”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就算不在一起，但却能带给自己仿佛在一起时一般的存在感的人，这才是“恋人”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"泽米很喜欢和泽万相处的感觉，说白了就是强者之间那种特有的张力很吸引人，彼此可以激发出对方的暗藏属性，但是我们不能将这种强者之间的惺惺相惜就定义为爱情，或者庸俗的友情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真正的爱情首先产生于一种感觉，是不讲道理的，是不受理性控制的，因此它的产生在世人看起来才会有不可思议的特点。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而现代社会中人们想到爱情，其实忽略了爱情的本质，不把爱情当作是在特定情境下产生的特殊情感，而是先用理性分析两人是否相配，按照符合逻辑的路线去安排爱情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是爱情的萌芽恰恰是不符合人类逻辑的，如果非要说爱情也是讲道理的，那么它所讲的也是符合事物本性的规律，而不是世人自以为是的逻辑设定。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"爱情是不可以去特意设计的，它总是发生在当事人经历的一系列机缘巧合之中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"按照世人的理解，他们之间的爱情毫无道理，也没有铺垫，从世俗角度两人也并不相配。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是大家回想一下，伊兹出现在泽米身边的时候，泽米本人是什么状况？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可以说，那是泽米目前为止人生中的至暗时刻，对于泽米自己来说是一个彻头彻尾的失败者。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他因为自我的严苛和执念，产生了无法排遣的压力和负面情绪，而这一切都没人能帮他化解。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也许一开始，他就是只想通过逗一逗伊兹来缓解自己的压力，后来发现这个人或许是能够理解自己的，并且也是和她呆在一起真的能放松许多，那么就想和她倾诉更多，甚至可以放心地对她将自己全盘托出。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也许目前为止，他只能、也只敢在伊兹面前承认自己的失败和不堪，在其他人面前光鲜的一面、伪装的一面终于可以卸下来了，这个人至此对他产生了无法言说的意义。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"也许就是在这一刻，他发现自己真的爱上了这个人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也因此，他放心的将自己交给她，让她给自己守关，甚至闯关失败了可以将自己托付给她。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你们看，不论世界怎么看伊兹，或者伊兹怎么看自己，在那时那刻伊兹对他来说就是这么重要。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"爱情本身就是一种关系态，并不是世人所想的，某人多好多优秀才会获得别人的信任和情感，而是在某时某刻，你对我来说产生了无与伦比的意义，我对你迸发出不可名状的情感，这种无与伦比和不可名状，我们将其称之为“爱情”。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人之所以被称为撩妹高手，其实不是因为他渣他浪，本质上是因为他在感情上是没有过多欲望的，也就是所谓的“无欲则刚”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这似乎有些违背常识，因为人们认为感情产生于欲望，有了感情就是有欲望。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"其实这是人们对于感情和欲望的误解。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"感情是什么？感情是人自然而然对人和事产生的感觉和情绪，说白了感情从根本上是自己的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"纯粹的感情和欲望毫不相关。但是问题就出在感情在对象化的过程中产生了欲望，欲望看似是自己的，但“感情”转变为“情欲”实际上就脱离了自己的掌控，开始向外索取了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种对情感对象的索取可以是情感的、精神的、物质的等等，总之这时候人被情欲控制就不自由也不自然了，自然就不能很好的表达自己，在情况不对时也不能抽身而退了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没体会过那种能够荡涤灵魂的强烈心动感，不得不说是一种遗憾。这种感觉也不是想要就能遇见的呢。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而泽米，面对感情时就没有对绝学的那种执念，也不会患得患失，因为他的情感是自满的，他不匮乏，他没有想着通过感情换取什么，他喜欢谁，只要给出他的喜欢就好了。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,sCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,YAAY,CAAC,CAAC,CAAC,EAC/BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iDACF,CAAC,CACF