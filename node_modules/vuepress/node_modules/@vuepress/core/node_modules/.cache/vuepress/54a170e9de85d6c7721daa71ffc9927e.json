   \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"大学是提升自我，打开格局的地方\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"悲喜自渡 他人难悟 你又是谁的救赎\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你永远也不可能真正了解一个人，除非你穿上他的鞋子走来走去，站在他的角度考虑问题，可当你真正走过他的路，你连路过都觉得难过，所谓的感同身受不过是隔岸观火\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"必能忍人不能忍之触忤，斯能为人不能为之事功\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"论众人看你的眼光多么怪异，无论别人对你的评价多么低俗，都要昂头挺胸，勇敢地走下去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"套用一句佛家的话，就是:“难忍能忍，难行能行。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"忍辱是一种“胜固欣然败亦喜”的平常心，是一种走自己的路，不在乎他人非议的勇气。能忍辱的人往往愈挫愈勇、百折不挠。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他们拥有抱负远大、志在高远的胸襟，还有志在必得的自信。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正如南怀瑾先生套用清代金兰生《格言联璧》中所说的那样:“必能忍人不能忍之触忤，斯能为人不能为之事功。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在人生的历程中，学会忍耐，便像“退一步海阔天空”般，忍一次天便更蓝，海便更宽，心也变得更加包容和宽大。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生命的历程中存在着无数的苦难，身处苦难的过程需要忍，度过苦厄的过程也要忍。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"忍过万般痛苦，你的人生也就如海如山，境界无涯，成功便不远了\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"嘴里的云淡风轻落到谁的身上又何尝不是一场锥心之痛，道理谁都懂，情绪难自控。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人行大道，号为道士。身心顺理，唯道是从，从道为事，故称道士\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"当你穿过了暴风雨 你就不再是原来那个人\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理智到极端，可以亲手毁了自己在乎到不行的感情，可以承受任何代价，默不作声，及时止损，不联系不打扰，我不强求，即使我很在意\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"秋天是凋谢的季节 玫瑰花也不例外\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人为钱犯罪，这个人有罪;一个人为面包犯罪，这个社会有罪;一个人为尊严犯罪， 世人都有罪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"跑步分泌的多巴胺仅次于谈恋爱，3公里专治各种不爽，5公里专治各种内伤，10公里跑完内心全是坦荡和善良\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"欲成大树 莫与草争 将军有剑 不斩草蝇\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没有经济上的独立，就缺少自尊；没有思考上的独立，就缺少自主；没有人格上的独立，就缺少自信。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"富在术数不在劳身，利在局势不在力耕\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"超过了别人的认知时，阻力成倍增长，所以要偷偷努力\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"剑客要有无限的求生意志，只不过既然选择了剑，就要有必死的觉悟。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人们的幸福感取决于他们是否走在符合自己价值判断的道路上\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果禁止人民吃饭，那么人民是会偷偷吃饭还是去吃屎\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"马克吐温说：首先你要掌握真相，然后你可以根据需要任意地歪曲它！ 这个世界总是充满各种目的的正确的谎言！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"其实不管你读什么书，量多了以后，都走向严肃文学\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不立文字，教外别传，直指人心，见性成佛。得自己悟\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读书多为内化，而不外显\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"了却生前天下事，赢得身后功与名\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“男人永远不会长大，只是他们的玩具变得越来越贵了”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他年轻的时候也曾意气奋发的想要征服世界，现在的他被世界征服的服服帖帖！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你在阳光下发现了一只蟑螂，那么它们在阴暗处已经多的挤不下了\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"世事洞明皆学问，人情炼达即文章\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我非常爱我的国家，但我非常讨厌那些统治他的人\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“一切有为法，如梦幻泡影；如露亦如电，当作如是观……”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"乔治马丁：读书可以经历一千种人生，不读书的人只能活一次。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"余秋兩：读书最大的理由就是想摆脱平庸。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"蒋方舟：一个人不读书，那他的价值观就只好由亲朋好友来决定\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"龙应台：孩子，我要你读书，是为了你有选择的权利，而不是被迫\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"莎士比亚：书籍是全世界的营养品，生活里没有书籍就好像没有阳光；智慧里没有书籍就好像鸟儿没有翅膀。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当所有人都把欲望当理想，把世故当成熟，把麻木当深沉，把怯懦当稳健，把油滑当智慧，那只能说这个社会的底线已被击穿，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以你们没有资格说我的勇敢是莽撞，执著是偏激，求真是无知，激情是幼稚\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"哪有什么自由，一生不过是挣扎出一个人的样子罢了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“名义上我拥有自由，可是现实中，种种束缚着我的脚步\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所谓的自由，不是随心所欲，而是自我主宰。除非一个人觉悟出生活的意义，否则他的能力或天赋便会用来强调自我及其欲望\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以说爱恨真是奇怪的东西，有的早早腐烂入土，有的刻骨——《全球高考》\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“月光还是少年的月光，九州一色还是李白的霜。”——余光中《独白》\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你在桥上看风景，看风景的人在楼上看你，明月装饰了你的窗，你装饰了别人的梦。——卞之琳《断章》\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“当你感觉自己渺小的时候，可能已经成为了别人的太阳.”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“晚风又吹谁人发，又是一年起风时”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“我从小到大都是优 你让我怎么从良”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人出生以后，在幼年的时候他被各种谎言所填满。当他觉醒的时候，当他成长起来的时候，他所做的第一件事就是呕吐，把这些谎言都呕吐出来，重新开始。\\t\\t罗曼罗兰\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"太执拗了，我的精神，生来带着荒蛮之力，我看见地平线上羞赧半露的红日弧度，心想那是我乌托邦的城门，拼命跑，也不觉得累。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"小确幸和大野心可并存，换我，最佳方式:前者用来做梦，后者用来战争。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"十八岁的我，已经迫不及待缱绻二十八岁的灵魂，去索取新世界怪思潮。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"穷极一生，不落俗套。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"基本上，年纪越大，你就越难疯狂迷上一个人，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为你的自我系统已经越来越完善了，很难再在其他人身上找到梦想的寄托，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"只有当对方像一个梦想般存在时，才会沉迷不可自拔。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我空旷的一生，因为学会与自己和解而被治愈，这是一种自我关怀，不幸时，幸福能救命。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"缘起，在人群中，我看见你。\\n缘灭，我看见你，在人群中。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你猜我怎的从没想过当一个作家，因为用文字和感情较劲总是乏力的，非要较出高下把喜乐写出来，可这发酥的幸福感的后劲，我写不出来呀，写不出来的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你的背影是可可西里的地平线，我是追着落日碎屑的羚羊，我依然还未抵达我盛年的湖泊，太阳，却快被地平线淹没了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大概念散点攻击部分心理靶点，引起共鸣。你以为在说你，其实是说大部分人，因为普通人就是这样\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人们总觉得未来很远，他曾经也是这样认为，却不知道什么时候未来就到了眼前。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"糟糕的世界往往最锻造出扭曲的意志\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"偏执的为了理想，行，疯狂之事\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"也许老天从没有忘记我们，又一次降下了灾难。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"为天地立心，为生民立命，为往圣继绝学，为万世开太平\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"位卑未敢忘忧国\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"怪不得书读的越多对很多东西越没欲望。现在支持我们前进的真的是希望和理想，而不是物欲\"\n     