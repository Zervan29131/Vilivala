{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/10.philosophy/06.柏拉图的理念论.md?vue&type=template&id=5e70bdf6","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/10.philosophy/06.柏拉图的理念论.md","mtime":1768579404265},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/10.philosophy/06.柏拉图的理念论.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"柏拉图的理念论：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图认为:思想永远是宇宙的统治者。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"爱因斯坦认为:纯粹的思维能够把握世界。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"柏拉图通过洞穴比喻来区分现象和本质，前者被称为真实世界，后者被称为理念世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图哲学的核心概念是理念。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图的理念具有多重含义\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"首先，理念是事物的共相。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理念是通过对事物的抽象而形成的普遍共相，亦即事物的类概念或本质。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"其次，理念是事物存在的根据\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"个别事物由于分有了理念而成为这一事物，离开了理念就没有事物。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"再次，理念是事物模仿的模型\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理念是事物之完满的模型，事物则是理念的不完满的摹本，事物是因为模仿了它的理念而成其为事物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"最后，理念是事物追求的目的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理念是事物的本质，事物存在的目标就是实现它的本质，从而成为完满的存在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理念不仅不会受事物的影响，而且理念与理念之间也没有任何联系，因为理念是绝对的自身存在而不可能变为他物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"把事物的本质——理念，与个别事物的分开，并且以理念为存在的根据，是柏拉图哲学的基本原则。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"世界由 “理念世界”和“现象世界”用组成。理念世界真实存在，永恒不变。而人类感官所接触到的现实世界，只不过是理念世界的微弱影子，它由现象所组成，而每种现象是因时空等因素而表示的暂时变动，自然界中有形的东西是流动的。但是构成这些有形物质的形式或理念却是永恒不变的。一类事物有一个理念，各式各样的事物有各式各样的理念。不同的事物组成了事物的世界，而由它们的理念所组成的总体就是柏拉图所谓的理念世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们对于那些变换的流动的事物不可能有真正的认识，我们对他们只有意见和看法。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们唯一能够真正了解的，只有那些我们能够运用我们的理解来了解的形式或者理念。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"由此而发，柏拉图提出了一种哲学的核心概念是“理念”，他的哲学亦因此而被称为“理念论”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图通过两种方式来说明理念是如何派生事物的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他用“分有”说明个别事物与理念之间的隶属关系。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一是“分有”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"具体事物之所以存在是因为它们分有了同名的理念。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果在美自身外还有美的事物，那么它之所以美的原因不是别的，就是因为它分有美自身，每类事物都是如此。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"二是“模仿”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"造物主是根据理念来创造事物的，所以事物因模仿理念而存在。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"木工是根据理念来制造我们所使用的床和桌子，按照床的理念来制造床，按照桌子的理念来制造桌子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"以桌子为例，柏拉图认为有三种桌子存在。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"1，作为理念的桌子自身\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"2，因模仿理念而存在的可感的桌子\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"3，因模仿可感的桌子而存在的画家所描绘的桌子\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"理念所面临的问题：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"第一，关于理念的普遍性问题\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"每类事物都有一个同名理念作为存在的依据，但是对，火、树、人等自然物是否存在理念的问题，柏拉图存疑，这样一来，势必否认任何事物都因理念而存在的理论前提。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"第二，关于理念被分有问题\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"柏拉图承认，事物对同名理念的分有只能有两种方式，或者分有整个的理念，或者是分有理念的一部分，但是这两种方式都有困难。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为理念的首要特征是单一完整性，而事物则是多数的。如果每个事物都分有一个整体的理念，那么有许多事物就需要有许多个理念。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这就与理念的基本原则，即多数同类的事物只能有一个同名的理念，发生了矛盾。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"第三，实在世界的重叠\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果有许多同类的事物就需要有一个同一的概念，例如许多大的事物有一个共同的“大的理念”，那么这个“大的理念”与其他大的事物放在一起，也需要有一个同一的理念，这就是第二个“大的理念”，如此类推，可以有无数个“大的理念”，从而陷入了实在世界的重叠。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"第四，有关分离问题\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"理念是在事物之外独立存在的实在，这是理念论的基本原则。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然而，如果理念是独立存在的，那么理念就不在我们中间存在，理念与我们的世界是两个分离的世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么，“主人的理念”是“奴隶的理念”的主人吗？或者是“主人的理念”只与“奴隶的理念”有关。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图的宇宙生成学说三条原则：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第一，要区分那存在而不变动的东西和变动而非存在的东西：凡是有理性和逻辑认知的东西总是自己同一存在的，凡是由意见借助感觉认识的事物总是会变化消灭的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第二，一切变动的东西总是由某种原因作用于它才能变化生成，没有原因就不能生成。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第三，创造者要构造事物的形状和性质时，必须以不变的东西作为模型，才能造出美好的东西，如果以变化的事物为原型，造出来的东西便不能是好的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"柏拉图认为,感性世界是一个不断流动变化的世界，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其中的事物都是既在存在又不存在、既确定又不确定的,我们对它们不能形成任何真理和知识,只能形成意见。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只有当我们凭借逻辑从这些事物上升到确定的“定义”,我们才能说有了确定的知识。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而一切定义不是指称个别事物的,而是指称这些“理念”的,因此只有理念才是确定不移、不变的存在,\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"尽管它们是看不见、而只能被思想到的,但它们是唯一的真理。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"任何具体的东西都只有“分有”了与它相应的理念，才能存在。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但万物和自己的理念相比都是不完善的,它们都必须努力趋近于自己的理念,却永远也达不到理念。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,UAAU,CAAC,CAAC,CAAC,EAC7BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,gBAAgB,CAAC,CAAC,CAAC,EACnCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE