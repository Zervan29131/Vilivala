{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/96.关于故事.md?vue&type=template&id=13b7e82f","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/96.关于故事.md","mtime":1768579404257},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/96.关于故事.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"我开始害怕阅读的人\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#我开始害怕阅读的人\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 我开始害怕阅读的人\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不知何时开始，我开始害怕阅读的人，因为跟他们谈话，我就像个透明的人，苍白的脑袋，无法隐藏，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我所拥有的内涵是什么，你就是人人都能脱口而出的游荡在空气中最通俗的认知吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我害怕阅读的人，他们在知识里遨游，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"空中跃下的猫，都能让他们对建筑仿真理论侃侃而谈，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"相较之下，我只是一台MP3时代的录音机，过气无法调整，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我最引以为傲的论述，恐怕只是他们多年前书架里的某段文字，而且还是不被荧光笔标注的那一段。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我害怕阅读的人，当他们阅读的时候，脸就藏在书后面，书一放下，就以贵族王者的形象在我面前闪耀，举手投足，都是自在风采，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们的血液里充满答案，越来越少的问题让他们恐惧，仿佛站在巨人的肩膀上，习惯俯视一切，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那自信、从容是这世上最好看的一张脸，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我害怕阅读的人，我祈祷他们永远不知道我的不安。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"免得他们会更轻易的击垮我，甚至连打败我的意愿都没有，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我害怕阅读的人，他们的榜样是伟人，就算做不到，退一步也还是一个我远不及的成功者，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我害怕阅读的人，他们能避免我接下来要经历的失败，懂得生命太短，人总是聪明的太迟，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我如此害怕阅读的人，尤其是还在阅读的人，世间大多人都害怕阅读人，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但讽刺的是，每个人都有成千上万次的机会，成为那个阅读的人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"多读小说\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#多读小说\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 多读小说\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他有各种跌宕起伏的人生，各种丑恶和挣扎，各种低劣和媚俗，各种憔悴和不甘，各种无奈和幽暗，各种人世间沉沦的故事，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"从此之后不管面对什么事，都已是内心深处早已体验过的黑暗桥段。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"多读历史\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#多读历史\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 多读历史\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"他有各种大势和被命运洪流裹挟而去的微小个体，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们发现，人的渺小，世事的既定和多变，愚蠢的重复和偶然闪现的微光，那微光如昙花一现，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"以至于毫无信心能在有生之年遇见。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"多读哲学\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#多读哲学\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 多读哲学\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有各种价值观的形成，各种质疑的微妙，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们发现自己原本坚定相信的不过是一场虚妄，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"原本嗤之以鼻的居然蕴含道理，也不再会执着于曾经那些坚守，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"用更思辨的目光来看这个亦真亦假的世界。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"多读社会学\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#多读社会学\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 多读社会学\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那些司空见惯的事情，其实都其由来，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人类社会不过是一张想象中的草图，自以为是的运作，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有些温暖的事情，其实背后都隐藏着冰凉的考虑和目光，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们只是系统的一分子，你轻若浮萍。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"多读人类学\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#多读人类学\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 多读人类学\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"然后发现人类不过就是一种奇特的动物，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们没有什么高尚，没有什么特殊，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们只是披着一张现代文明的外衣，行鼠窃狗偷之事，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们只是一边诉说着一个个虚假的故事，一边满足着各种贪欲。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"不读书也不见得是什么坏事，因为有时读书越多，人世就越冷。\"),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"阅读这件事，就像内心挖掘着大隧道，沟壑纵横，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人们都在寻找通达之路，聪明的人从来不问，读书有什么用，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"他们自然能从书中找到自己想要的，笨的人坚持阅读也有一个好处，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"那就是如果你有一天你开窍了，你就会一通百通，比如，曾国潘，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"哪怕当下无法创造价值，阅读依然可以让人保持足够的学习力和接受度，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以你现在的选择，决定了你将来到底是一个盲从盲信的摇摆人，还是一个通达事理凡事从容的长者，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"可是，\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"读书学不来什么\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#读书学不来什么\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 读书学不来什么？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读书永远学不来的能力，是放下书，走出去行动的能力。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读书是好事，但也容易令人产生这么一种幻觉：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读过某些道理，便以为自己懂了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"读过人心鬼蜮，云诡波谲，便以为自己世事洞明，觉得世上之事不过如此，自己只是没遇上而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们的一生是由无数个选择构成的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而人在作出选择的时候，往往是非理性的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这就是人最大的弱点,\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人是受情感驱动的，因而也是脆弱的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你读了再多的书，学会了再多的道理，在你面对实际的困境的时候，往往派不上什么用场。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你知道要学会投资自己，以期在未来收获机遇，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但当你结束了一天的劳累，你是否真的能关掉美剧和电影，强迫自己好好去读几页英语？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你知道理性人追求边际效益，不考虑沉没成本，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但当你真的面对抉择，要放弃你坚持了两年、三年、五年的东西，你能够放下执念么？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你知道作出决策时要排除情感干扰，权衡各方面利弊，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"可当你真的面对能左右你未来十年的选择时，你是否真的能做到心如止水，还是犹豫徘徊、举棋不定？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你是否有过这样的经历：在身心俱疲、状态极度不好的情况下，还得硬着头皮去做你不愿意的事情？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如，应酬，跑客户，看房子，又或者，面对日常生活里繁重的琐事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而你这样做，只是为了拼尽全力维护你小小的安定的环境，不至于支离破碎？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你是否感受过那种在命运面前、在整个社会面前深深的无力感？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你是否体验过，被朋友背叛的心寒，一个人在深夜醒来的孤独，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"每天奋斗12个小时仍看不到未来的灰暗，肩负着债务、忙到没时间喘息的绝望，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"与机遇失之交臂的遗憾，怀疑自己能力、乃至生存意义的虚无感……\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这些东西，都是读书无法给你的。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"读书可以告诉你很多道理，但永远给不了的，是面对困境时内心的真实感受，以及作出选择时坚决的心境。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这两样东西，只有当你去经历了很多事情，沮丧过、失望过、痛哭过，你才能真正地把握到，也才能真正地拥有。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你会发现，生命中有许多属于自己的寒冷和深渊，只能够自己去面对。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"它们考验的，是你经过千锤百炼、早已刀削斧劈难动分毫的内心。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"没有谁能够代替你去承担，也没有哪本书能够帮你去抵抗。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"知行合一，最难的永远是行。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读书和阅历永远是互补的关系。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"可惜的是，许多读书人，最大的误区，就是以为读书可以代替阅历。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"读书可以给你力量，但造就一颗强大的内心，需要提高对痛苦的阈值。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"也就是说，你必须一次又一次地去经历痛苦，或许是风险，或许是损失，或许是恐惧，或许是你所厌弃和排斥的事物，直到你能够承受痛苦，你才能不被痛苦所左右。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这没有哪一本书能够教会你，一千本书、一万本书也不能。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"然而，这恰恰是读书最大的副作用。读书的本质，依然是一种「舒适区」。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"读书的时候，你是在观看别人的生活，始终没有参与其中。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"书中的悲欢离合，是主角的故事；书中的艰难决策，也是主角作出的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你始终只是一个观察者，永远体会不到面对困境的绝望和无力。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，很多时候，读书，或者说埋头于读书，其实是一种逃避恐惧和风险的行为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"在书里面，你永远是安全的，永远不用被卷入现实的风暴中。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"也因此，你失去了真正磨练自己的机会。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"更甚者，它会给你这么一种错觉：你读过了许多故事，自以为明白了许多道理，但你并不是真正明白，只是自己认为明白了而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当你真的遇到书里的情形时，即使你知道正确答案，你有勇气选择那一条路么？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我感觉到，读书多的人，大多有这么一种倾向：遇到任何一件事情，喜欢先退一步，好好思考，考虑完，再决定要不要前进。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而结果往往是：算了，还是不要前进吧。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"所以，好好去体验身边的生活。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"去做一些平时想做但不敢做的事，去挑战自己的极限，去经历各种不同的经历。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"不要怕风险，也不要怕损失。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"书可以教会你各种各样的招式，但如果你不在实战中用出来，就永远算不上一个高手。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC