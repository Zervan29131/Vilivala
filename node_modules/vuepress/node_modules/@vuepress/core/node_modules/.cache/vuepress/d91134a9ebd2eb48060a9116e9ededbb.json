vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h3\", { attrs: { id: \"老实人\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#老实人\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 老实人，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"呆呆的，傻傻的，完全不懂与异性交往相处的技巧，没有谈过恋爱，面对蝇头小利，不为所动。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"一看就知道是十足的老实人，从小到大老实了许多年，从未改变。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"守规矩，懂秩序，有礼貌，照顾他人的情绪，不懂变通与灵活，世人都叫这种人为\"\n        ),\n        _c(\"code\", [_vm._v(\"傻子\")]),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"老实人不知道自己为什么会老实，一辈子过得很清苦，人间的欢乐都跟他们无关，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个在班里不合群的人，常常独自一人发呆思考，那么他出身社会以后，如果能够适应地了环境的话，必然会有一番大的作为。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在他的同龄人当中，他是第一批开始进行“独立思考”的人群中的其中一个。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为他二十几年如一日，对某些领域的思索深度已经大大地超越了他的同辈了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"可以这样说，几乎没有人可以在这些领域里与他比肩。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那些所谓的天才，其实和我们平常人是没有太大的区别的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们可能会拥有一些天赋，但是最致命的是，他们唯一和一般人有别的地方，是他们拥有可怕的意志力和可怕的行动力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们做出的成就，是经过了七八年乃至二十几年如一日的坚持，才达到的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一般人不是从未开始，就是半途而废。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果天才不努力不坚持，依然难逃泯然众人矣的命运。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们拥有智慧的人提升方式，与聪明人不同，聪明人懂事成熟可以用情商高来解释，这是时间和经验的积累产生的效应。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是老实人他的聪明的提升叫“开窍”。开窍这个过程极其特殊，这种成长似乎可以在一瞬间之内就完成。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"譬如刚才还幼稚的，但好像醒悟了一样，之后立马变得和原来不同了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"说的生动形象些，就像武侠小说里写的，要练武功，先打通经脉，但是修炼功夫做下去了，却没有任何效果显现，随着时间的积累，到了一定的程度，缘分到了，自然地所有的经脉会在一瞬间之内被打通。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"在一群人之中，表现地最安静的那个人，往往实力不可小觑。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"因为你看不透他，他私下里在做什么也不会跟你说。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"世人没几个是真正理解老实人的。待人接物，为人处世，他们都摒弃掉浮华的礼智，抛弃掉机敏的巧智，坚守着“道”的精神。其实他们是具有大智慧的人，如同“大智若愚”那样的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们是看《道德经》会很有感悟，他们是要去悟“大道”的，是被“大道”所选择的人，让生命在痛苦与死亡之间淬炼自己的灵魂，不悟就痛苦吧！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正所谓，朝闻道，夕死可矣。老实人不是让人欺负的，他们真的很聪明，只是善良，不愿意伤害人。但是，到了一定的时候，他们就会出现兵贵右不贵左，不是不用兵，是未到用之时。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"社会人\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#社会人\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 社会人，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"出身社会之后，很多人都是奔着“名利”二字在过活，很世俗，并且他们的价值观被中国文化熏陶地很标准也很单一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“有钱就是大爷”这句话就是他们的其中一条价值观的体现。他们自己被别人认为是怎么样的人，看待别人也认为别人也是那样的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"还说“我是为你好”，“你什么都不懂”。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"倒在拥有独立人格的人看来，他们才是真正的笑柄。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"与一个人初次见面，可以先看她的眼睛，有句话叫“眼睛是心灵的窗户”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人读过的书，走过的路，见过的人，她的世界，她的气质，她的精神，她的理想，她的期盼，她的眷恋，她的困惑，她的痛苦……都会从眼睛里反应出来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当一个人对一个事物发表自己的看法，言辞激烈，手脚并用，可以看出明显带有个人色彩的偏见时，这个人多半很狂妄，自以为是，自傲自大。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"独立人格\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#独立人格\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 独立人格，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"能够一个人承担自己的所作所为带来的一切责任，不转嫁给他人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不管是生、老、病、死，还是爱、别、离、求而不得，都得自己独自承担。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"直面死亡的恐惧，进而看透生死。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"能够清晰地控制自己的欲望与情绪，不会成为欲望与情绪的奴隶。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不会在乎别人的眼光与评论，那些东西，只是早就被抛弃的不必要的存在。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"拥有属于自己的独立的世界观、价值观和人生观，并且不会因为遭受别人的质疑和打击而出现妥协与退缩，进而崩溃。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"善变且接纳新知识的速度非常快。常常被人们形容成离经叛道之辈，但他们根本不需要在乎世人说什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这样的价值观注定不是普世的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"踏过了这三道门槛的人，才是真正的拥有“独立人格”的人。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IA