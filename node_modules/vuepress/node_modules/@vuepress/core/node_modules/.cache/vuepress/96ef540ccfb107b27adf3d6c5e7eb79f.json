_vm.$parent.slotKey } },\n    [\n      _c(\"h3\", { attrs: { id: \"冰龙、微软\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#冰龙、微软\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 冰龙、微软\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你是一条已经沉睡千年的冰龙。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一天，一群小小的人类唤醒了你,他们向你承诺了大量的财富，数量不可思议。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '他们自称为“微软\"，准备把大量黑匣子移入，你的巢穴里来保存数据。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"闪电、湖水、异世界的门\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#闪电、湖水、异世界的门\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 闪电、湖水、异世界的门\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"眼前的湖水突然出现了发光的漩涡，好像是异世界的门。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"中年男人愣了一下，居然驾车冲了进去。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"电流遍布他的全身，他笑了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"心说无论是穿越还是外星科技，总要比现在一潭死水的生活更好一些。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"第二天他被从水里捞了上来，警察不明白为什么这么明显的喷泉电路故障也会有人死在里面。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"死者没有可自杀的地方，唯一跟别的中年男人不同的是，他还有些许幼稚。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"时光机\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#时光机\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 时光机\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"小林同学买了一架时光机，由于科技限制，时光机只能带他回到死前一分钟的时候。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"小林年仅二十，未婚单身，想到未来或许已走上人生巅峰，死前一定有众多显贵前来探望，再不济也能看到自己儿女的成就，想到此处，不禁心痒难耐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"坐进时光机，只听得提示音道：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“您好，请绑好安全带”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“是了，一会机器以光速运行，要固定好自己。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“您好，请关闭手机”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“是了，坐飞机还要飞行模式呢”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"小王想到即将看到未来的自己，连按开始按钮的手都颤抖了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“您好，距离时光机爆炸还有60秒”。\")]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"反乌托邦式的反抗\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#反乌托邦式的反抗\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 反乌托邦式的反抗\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个青少年小说式的故事，讲述一群热血少年们协力与反乌托邦式高压政府对抗、试图推翻邪恶统治的旅程。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在故事的进程中，读者会逐渐意识到:政府根本是对的,主角只是中二二而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"多年前,你把自己的灵魂卖给了恶魔，今天，他突然把你的灵魂还给了你，说:“我需要你帮我个忙。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '你出生在一搜星际移民飞船上,你属于“中间世代\"你从不曾见过地球，也不会有机会见到你们的目的地。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '地球即将被一颗偏离轨道的行星击中摧毁前的一天,时间突然停止了你只是一名平凡的普通人，却在这时可以行动，并拥有了不老不死的力量。你的手臂上出现了一行字: \"不管花多长时间，请教救我们。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在外星人侵地球前，有钱有势者或者高精尖人才都离开了地球，只留下人渣、罪犯和底层穷人在球上自生自灭。几个世纪后，当他们回来“解放地球“时，却发现，这群人已经打败了外星侵略者，并且繁荣昌盛地继续生活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"木剑修仙\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#木剑修仙\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 木剑修仙\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"当孩子刚刚出生，年轻且贪玩的父亲决定给自己的孩子开1个大玩笑。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"当孩子刚刚懂事的时候，父亲就告诉孩子，这是一个修炼的世界，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而他的父亲，也就是自己则是绝世的剑仙，作为剑仙的孩子，一定要好好修炼。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"并且为了骗儿子，父亲教给了儿子一套从网上学的广播体操,只要儿子勤加练习，等到他十八岁的时候就送他一柄飞剑。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"儿子从小被骗到大，对父亲的话深信不疑，即便面对自己同学的质疑，儿子也坚定的相信父亲的话，认为父亲只是隐藏在市井中的绝世高手，并且明天坚持修炼父亲教的广播体操。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"直到十八年后.....\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这天是孩子成年的日子，父亲也郑重其事的拿出一把木剑递给儿子，儿子不知道的是这把木剑只是父亲从网上9.9包邮买来的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"看着儿子一脸期待，父亲实在忍不了，对儿子说:儿子，其实我骗了你。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"结果还没有等父亲说完，儿子竟然踩着木剑一下子腾空而起。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"人妖对抗\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#人妖对抗\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 人妖对抗\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"万族入侵，人族沦为被圈养的家畜食粮\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"妖魔祸世，人命比野草还要轻贱\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人族在这世上苟延残喘\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我誓要将所有的妖魔驱逐出去\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"午时已到，阳极转阴\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"正在咀嚼小儿手臂的鬼怪，我以斩首大刀将其立地正法\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"妖魔头颅冲天而起，死死瞪着我\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"鬼城之中，以活人为傀儡迎亲的鬼怪，我以一剑腰斩\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"凄厉鬼吼声中，唢呐哀鸣\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这一路,我踏着妖魔们的尸山血海\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"扛起人族的大旗\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"诸般妖魔诡怪尽皆俯首\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"高呼人族万岁万岁万万岁\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我人族从此站起来了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"站起来的才配称为人\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"为人族之崛起而读书\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"小兽珂珂，祖龙七踏。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以身化石躯护人族万世，没有无敌踏万族，只有燧人氏，只有神农氏，只有皇帝。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一张裹尸布一颗护人族之心\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"残喘至今，并非怯懦，只是不甘\")]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"计划生育\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#计划生育\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 计划生育\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"凌晨，夜深人静。窄巷口路灯下一个黑影匆匆走过,直走到巷子深处一个小窗口前面停了下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v('“咚\"咚,咚,咚\"')]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v('木板窗后传来低沉的声音\"谁?\"')]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“老板，拿货。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v('木窗后低沉的声音“什么货?\"')]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v('“毓婷一盒，冈本一盒\"')]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“三百“\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"黑影掏出钱在窗缝中塞了进去。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"片刻,窗缝中递出一黑色包装袋。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v('黑影打开袋子一怔,有些急了“怎么冈本是3只装的,不是12只装的吗?\"'),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“这阵子风声紧，能买到货就不错了，抓到了可是蹲大狱的罪。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"黑影正要与老板理论一番。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '这时,巷口一阵嘈杂。听到有人踹门门大喊“私自结扎，三年起判，开门自首，从轻处罚。\"'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"黑影慌忙把袋子揣到怀中紧紧抱着,朝着另一侧跑去\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"夜又恢复了平静。\")]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"对地球人的奴役\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#对地球人的奴役\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 对地球人的奴役\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"外星人入侵了地球， 想要征服和奴役人类。但外星人对“ 奴役 的定义是这样： 每周让人类工作12 小时， 同时会提供健康的食物、住所和娱乐手段。\\n人类抵抗组织遇到了危机， 比起反抗外星人， 大家更想成为奴隶。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"毁灭与重生\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#毁灭与重生\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 毁灭与重生\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"地球将会在几年内毁灭， 但是你被赋予了一把神秘的匕首， 被匕首杀死的人会保持原样， 在另一个不会毁灭的地球上复活。\\n在另一个世界， 你被视为最伟大的英雄。在现在的世界， 你成为有史以来最穷凶极恶的杀人狂魔。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"我是超级反派\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#我是超级反派\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 我是超级反派\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"超级英雄在与邪恶斗争之后， 会抹除相关人士的记忆， 来让大家重新适应社会。\\n今天， 当你浏览旧报纸时， 发现自己曾经是世界上最强大的超级反派。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"创造宇宙\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#创造宇宙\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 创造宇宙\"),\n      ]),\n      _vm._