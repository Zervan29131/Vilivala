{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/11.宇宙开端猜想.md?vue&type=template&id=785b6348","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/11.宇宙开端猜想.md","mtime":1768579404258},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/11.宇宙开端猜想.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"首先，我们已证宇宙是膨胀的。其实不是宇宙本身在膨胀，而是空间的边界在无限膨胀。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"宇宙总质量所产生的引力和空间膨胀的斥力就像在拔河，谁赢谁输决定了宇宙的结局。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而根据客观存在性原理，宇宙在不断扩张，这说明斥力占了上风。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是不论是引力还是斥力，都需要能量。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果斥力大于宇宙引力，那这多余的能量是哪里来的？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"（也可以做一种假定，引力和斥力本身就是宇宙的一种性质，且作为性质本身，斥力就大于引力。这里不作过度探讨。）\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们将能量守恒作为公理。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么造成现在这种情况就只有一种解释。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"就是宇宙能量在宏观上守恒，而在微观上不守恒。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"（微观上不守恒为抽象解释，勿作争论）\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正虚粒子构成实粒子，实粒子构成实物。反虚粒子构成反粒子，反粒子构成反物质。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"二者相遇，发生湮灭。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"在宇宙的边界处，虚空中不断凭空产生正反虚粒子，随即互相湮灭。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这种湮灭相当于不断的在炸开宇宙的边界、扩宽宇宙的范围。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而凭空产生正反虚粒子，进行湮灭爆破，产生的能量是不守恒的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这一部分能量是预支的，也就相当于是借来的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"或者换一种说法，在实体星系周围，一切有质量的天体在对外放出引力，这是在耗散能量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"引力虽然是一种惯性力，但是它确实是耗能的，通过引力波的形式不断消耗出去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而那些耗散出去的能量被拿去宇宙边界“还债”了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在宇宙的边界上，正反虚粒子正在源源不断的“借”能量。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这种能量就是早些年只存在理论中的负能量，他的表现形式是斥力。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而与之相对应的，就是引力。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"（依据下文所述，过大的引力可以等效为斥力。）\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们现在所看到的宇宙中的实物，包括恒星，行星，甚至我们自己，都是由正虚粒子构成的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"只要是有重量的物体，都会发出引力。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而引力产生的原因，即为聚合成星球的正虚粒子与宇宙中游荡的反虚粒子发生湮灭。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种湮灭的级别很小，产生的形式并不是爆炸，而是通过更精细的形式放射出来，最后表现出的形式就是引力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"引力也可以等效为一种能量。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"整个宇宙中的引力也就是整个宇宙在发散能量。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"（正虚粒子与反虚粒子相互湮灭释放能量，不过会产生一种现象就是能量的释放产生引力，会使质量减少，也就是说凡是有引力产生的物体都会减少质量，不过如果根据E=MC²的话，减少的质量与逸散的能量可以忽略不记。）\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而这些能量最终会到达宇宙的边界，把那里欠下的能量填平，以此来维持整个宇宙的能量守恒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"（从另一角度上来讲，引力发散能量至宇宙边界，这股能量产生正反虚粒子，之后两股粒子相互湮灭，产生爆炸，炸开边界。也就是说，边界是由引力散发出的能量炸开的。）\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在宇宙的中心处，正虚粒子产生的引力使得其不断地聚集在一起，而反虚粒子被排斥在外。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"正反虚粒子的湮灭不平衡，从而让正虚粒子聚合成了无数的星球，反虚粒子在不断的游荡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"（这里有一个问题，正反虚粒子是同时同量产生的吗？反虚粒子聚合产生反物质，宇宙中反物质与正物质质量不相等。或者说，反物质的组成部分为反虚粒子，此粒子不进行聚合，而是在宇宙中均匀的分布，不断的与正虚粒子相互湮灭产生引力。）\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而在宇宙的边疆，正反虚粒子大量的不断凭空产生，他们预支了一部分能量，产生斥力，使得宇宙不断扩张。最终形成了一个动态平衡。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"按照这个说法，宇宙本为一片虚无，在空旷的宇宙中，正反虚粒子不断发生湮灭。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而因为一个特殊的原因，正反虚粒子的湮灭变的不平衡了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"（这个特殊的原因有待参考，可以暂时参考《三体》中程心偷走宇宙的5公斤。）\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这便是宇宙的开端。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,G