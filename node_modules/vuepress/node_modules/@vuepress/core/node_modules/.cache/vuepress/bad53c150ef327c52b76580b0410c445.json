{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/22.短句V2.md?vue&type=template&id=5bd9277a","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/22.短句V2.md","mtime":1768579404274},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/22.短句V2.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"天使来到世界上，却被要求摘除翅膀与人类平等\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"拔一毛而利天下不为也，取一毫而损天下亦不为也。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"未知苦楚，不信神佛。半生浮沉，话与山鬼听。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们为什么不选择安稳的生活，因为安稳的生活不得安宁\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"受光于庭户见一堂，受光于天下而照四方。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人生最大的遗憾就是无法同时拥有青春和对青春的感受。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"天堂没有我的位置，但我在地狱也不会和你们站在一起。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"飞蛾扑火的一瞬，飞蛾并不觉得阴暗，它至少享受了短暂的光明\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在变换不定的历史进程中，我需要一个永恒稳固的参照物\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人生是一出戏剧，主要角色是无限，人只是一个次要角色。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"自私者可以吃的更好，但分享者可以睡得更香\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我们短短一世，看不清全貌，很多时候，努力只是暂时看不见成果\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"别傲慢，弱小和无知不是生存的障碍，傲慢才是\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那一刻你的心里有场海啸可你静静站着没让任何人知道\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"世界之大无奇不有，常理只是束缚人思想的枷锁。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"空虚无聊的时候就读书,在低落和空闲的时候，你最能静下心来学习\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"难过时就蹲下来摸摸自己的影子，对不起，跟着我让你受委屈了\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"生活不只有眼前的苟且，还有读不懂的诗和到不了的远方。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"出卖自己的灵魂和原则并不丢人，丢人的是没能卖一个好价钱。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"情之一字，所以维持世界；才之一字，所以粉饰乾坤。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那些以为自己很差的人醒醒吧你们比你想的还要差\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们活着的意义，是让我们活着的地方有不同的含义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"爱，不是索取，不是占有，而是守护他们幸福，哪怕粉身碎骨\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"寻找共识不是通过表现出来的东西，而是通过做一件事专注的眼神。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"到了这里，我的思考就停止了，停止思考，我便死了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"神说有了光，于是就有了光，我说你要死，你就必须死。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"抬头昂望，不一定有星光，胜者，不一定为王\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你会把你妈卖到妓院里去吗？妈妈，我将变成一只萤火虫\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人生的道路虽然漫长，但要紧处只有几步，特别是当一个人年轻的时候。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"广厦万间，夜眠不过七尺；良田千顷，日食不过三餐\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生活中真正的勇士向来默默无闻，喧哗不止的永远都是自视高贵的一群\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只有那些两手空空，脑袋空空的人才喜欢用手指头和舌头去和全世界开战\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"沧浪之水清兮，可以濯我缨；沧浪之水浊兮，可以濯我足。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"错误的推理通常直接作用于人的灵魂，来战胜正确推理\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果因为错过星辰而伤感，那么恐怕也要错过太阳了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你们想让我过你们那样的生活，对不起，那样的人生，我一秒都不想多活\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"胆小鬼连幸福都会害怕，碰到棉花都会受伤，有时还被幸福所伤。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"心里充满苦的人，需要多少甜才可以把他填满，一丝甜就可以\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大多数抑郁症都在等待一场意外带走自己的生命，然而最后痛苦的长命百岁\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果你的今天不能过得比昨天更有意义，那明天的到来还有什么用呢？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你以为你人缘好着呢，你朋友已经替你和一片人绝了交。来呀，把刀全插我肋上。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生于理想，死于欲望。我究竟是活了365天，还是只活了一天，重复了364次\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"普通人之所以普通，是因为他们普遍有一个通病，那就是认为自己永远普通。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我出卖自己的灵魂，换取堕落的永生，只为潜入那无尽的深海，寻找我深爱的人\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"别去劝说那些前路一片黑暗却仍然执着前进的人，你真以为他们是瞎子吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"那时的我会死在席卷天下的战场上，你教我种的那些花，都已枯萎。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果一艘船不知道该驶往哪一个港口，那么任何方向吹来的风都不会是顺风。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"文明就是，老人明知道自己无法享受它的阴凉，却依然植树 。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生与死隔着永远，世界的规则就是不温柔的，但有些事总要有温柔的人去做。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"巷子里的猫很自由 却没有归宿 ；围墙里的狗有归宿 终生都得低头\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果一篇科幻小说能够被作者或读者用几句话总结出来，那这篇小说肯定是失败的\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人是一种很奇怪的生命，只有疼到自己身上时，他们才会知道有些东西到底有多疼。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就因为“上大学”三个字，毁了多少人的青春，思想，失去了好多的自由，错过了好多的人和事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"学易几十年，当天易成，卜一卦，今天必死，但是我知足了。凡人岂可知天机啊\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虚弱时才会发现自己真正的力量—兴趣是最好的老师，但只帮你入门，不帮你赚钱\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"道在心间，万人万解，故老子开篇明义，道理我来讲，怎样理解是你们的事！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我厌恶你们，不因你们聪明或愚笨，只因你们灵魂的单调与肮脏\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这个年代，执着于出人头地并不难，难的是不执着于出人头地\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"感情这事不能证明，证明本身就是对感情的一种亵渎\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“很多人根本没有自己的观点和品味，他们只是想顺着鄙视链往上爬”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要看不起任何一个堕落的人、等到他哪天觉悟的时候所有人都望尘莫及\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"智商越高思考就会越快，值得思考的就会越少同时也会越难。就像人和动物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"弱小的时候周围都是坏人。强大起来你会发现，周围都是好人\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“请你用绝对清醒的理智去压制你不该有的感情”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"如果我的能力只能让我穷困潦倒 那就穷困潦倒就是我的价值。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"共情是天赋，是对他人的慈。冷血是自我保护，是对自己的慈悲\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"总觉得高考发挥失常了，但仔细想想，这好像就是我的实力\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"不自律的人生是一种什么体验。被命运反复羞辱,却毫无还手之力。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你看不见趋势，不懂得运势，执着于一个不变的方法，依然就背离了结果\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"周易 即济 未济，意在一切定数皆有变数，一切变数皆有定数。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"知命总是好的，但这是以果布局因，果就会改变原来所见的果。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"30岁再买18岁喜欢的东西，已经毫无意义。哪有什么来日方长，我要现在就快乐\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"当理想主义的火，被浪漫主义点燃，再大的风雨都无法浇灭它\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"日出东方催人醒，不及晚霞知我心，空是人间自由身，却非人间自由人\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"很多人根本没有自己的观点和品位，他们只是想顺着鄙视链往上爬…\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"不自律的人生是一种什么体验被命运反复羞辱，却毫无还手之力\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所有大彻大悟之人，都曾无可救药；心不死则道不生，倘若穷途末路，那便势如破竹！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"她总是在枕头下放着一把刀 以防突然有人给她带来一个蛋糕\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你的小伎俩，我虽然看到了，但我觉得我需要像个父亲一样包容你\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"比起有人左右情绪的生活 我更喜欢过无人问津的日子\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“当我开始享受黑暗的那一刻起，我就不再期待黎明.”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我不期待别人给我撑伞，因为我就是那暴风雨\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你不是我权衡利之后的选择，你是我明知不可为而为为之的坚定\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"初心是什么？不被割。使命是什么，割别人\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"零和博弈最好只预判一步。降维打击最好只降一维。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个时代始终是属于他们的，配角就要有配角的觉悟。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"资本说，不要让年轻人过早的挣快钱，这样他们就不好割韭菜了\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“工作是世上最伟大的事，所以我们该把一些工作留给明天。”\"),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,yBAAyB,CAAC,CAAC,CAAC,EAC5CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,qBAAqB,CAAC,CAAC,CAAC,EACxCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAAC