{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/11.语录华为.md?vue&type=template&id=0b4ec98f","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/11.语录华为.md","mtime":1768579404273},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/11.语录华为.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\"程序员的一生时间90%是用在编程上，而剩余的10%是活在世界上\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"昨晚做了个迄今为止最神奇的梦，我梦见一个冷酷的女人穿着长袍自天外降临地球，问了我三个问题，前两个是物理和数学专业的问题，我答不上来，第三个问题特别奇怪，“如果连续吃三个月牛肉，会变成什么？”我一头雾水，她的助手告诉我，会变成上帝。\\n之后她向我展示了宇宙的终极奥秘，从黑洞到多维空间，从星球的诞生到引力波的原理，无数科学家毕生奋斗都无法窥探的奥秘、真理、公式……一览无余地展现在我面前，所有的常识都被打破，一切仿若神迹。\\n之后的剧情我记不清了，只记得地球开始崩溃，各种怪事接连出现，一个黑洞在楼下诞生，用任何手段都无法摧毁，一步一步吞噬了整个地球，人类奔走逃亡，最后只剩下我一个人类，呆呆地站在废墟上。\\n那个女人再度降临，把我抓起来，改造成永生者，关在宇宙尽头一个神奇的房间，那里是真空的，平面绝对光滑，她将我像皮球一样弹射出去，撞在充满弹力的墙壁上，像球一样来回弹，空气中没有阻力，我奋力挣扎，却停不下来。她离开了，光芒消逝，我将在这个黑暗的房间弹来弹去，永远无法停下，也无法死去。\\n在最后一缕光芒消逝的前一刻，她带着助手返回来了，把我带到另一个房间，那里有一个被抓来的男人，她问了那个男人两个物理和数学方面的问题。我感到越来越奇怪，忍不住问那个女人，她到底是谁？为何拥有这种主宰一切的能力？她终于笑了，转头看了我一眼，冷酷化为慈祥，而后转头看向那个男人，问出了第三个问题——“连续吃三个月的牛肉会变成什么？”刹那间，我知道了她的身份，呆呆地说，“会变成上帝。”\\n之后我就醒了，不断回味着梦里那些神奇的宇宙奥秘，有一种被上帝踢回凡间的失落感。我开始琢磨为什么会做这个梦，发现了一些线索，昨天我看了最后一只恐龙死去的纪录片，这对应了梦里我变成地球最后一个人；昨晚睡前我看了一部未来科幻电影《遗落战境》，对应梦境里的故事发生在未来；三个问题的桥段应该是来自以前看过的刘慈欣那篇《乡村教师》；展示宇宙奥秘的桥段应该是借鉴了《朝闻道》；永生者的部分应该来自于我最近在做的一个小说设定；只是我实在想不出来，连续吃三个月牛肉会变成上帝这个说法是来自于什么地方，其实我很少吃牛肉，也没看过类似的作品，可能是整个梦里唯一原创的部分了吧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我没有你那样的天赋，毅力，努力与自律，我有的也就只有是爱而不得了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"章鱼哥曾经去墓地献花被蟹老板发现了，蟹老板过去一看，墓碑上写着：祭奠章鱼哥逝去的梦想和青春。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"11月1日，地球三体运动的诞生日\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"麻木的智力抑制状态\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"之前：叶文洁，我理解她的做法\\n现在：请给我个做叶文洁的机会\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这注定是飞蛾扑火的一生啊。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所谓天堂，就是可以骂它是地狱的地方\\n所谓地狱，就是你只能说它是天堂的地方\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这就是我的一生吗？\\n是的，这就是你的一生，这生所拥有的，只有这小小空间中无尽的孤独。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"哪有什么岁月静好，只不过是根据相关法律不允许显示罢了\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"现在城里不少人被封控在家里，失去经济来源，房贷、房租照样交，钱照样要花，我这才理解经济危机到底意味着什么，为什么有人可以被饿死在纸醉金迷的都市中。\\n资本以“自由”的名义，将无产者从耕地中“解放”出来，将他们逐出去，他们不再被地主支配，他们却也失去了自给自足的能力，他们只能在饿死和出卖劳动力之间“自由”地选择，他们除了自由一无所有。\\n为什么无论何时总要有一批人在失业？答案很简单：如果所有人都能就业，那么就整个无产者阶层就可以顺理成章的要求提高收入，只有始终让一批人处在失业的状态中，一但有人要求提高收入，就将他们开除，换上那些失业的产业后备军，如此才能一直压低无产者的收入，减少资本增殖的成本。\\n努力能否改变命运？不能，答案也很简单，只要还维持资本自身的不断增殖，那么就必须让无产者失去自给自足的能力，否则他们就有能力脱离资本生产，资本也就无法继续增殖。如何让他们失去自给自足的能力？那就是始终将他们的收入控制在只能勉强维持基本生活的水平（如抬高房价等），虽然基本生活需求的标准会不断变化，但他们的收入却始终要被控制在，一但停止出卖劳动力便无法生存的水平，这不是“努力”所能改变的。\\n整个资本的运转，便是建立在无产者们随时都在面临的生存危机上的——如果无产阶级不再面临这种随时可以饿死的风险，它便无法继续增殖。\\n“资本来到世间，从头到脚，每个毛孔都滴着血和肮脏的东西。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我们读书是为了成为提灯人，去照亮别人的黑暗。而不是有了灯以后沾沾自喜，还要去吹灭别人的蜡烛。\\n不因学识泯良知，只求所学助难人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是一群只知道交配和觅食的傻逼\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在没有获得任何正反馈的情况下，独自去走一条没有尽头没有起点黑漆漆一片的路\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"风雨只能打湿他的衣服，一份属于红色意志的心在永远燃烧。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我的心忠诚于党 我的信仰闪闪发光.\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你们家有一条狗子，叫小黑，\\n有一天你觉得它渴了，然后拿了一盆开水，往狗窝里泼，狗子跑出来向你狂吠，提醒你不要这样，它不渴，它疼，\\n而你从不会在意他在想什么，反而因为他的吠叫，觉得他不识好人心，想要咬你，\\n你啐了一句，给你水喝还要咬我，白眼狼，\\n而狗子只是想要提醒你，不要这么做了，它疼\\n你觉得你在对他好，而他恩将仇报\\n我不理解\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"俄罗斯与北约冲突的一些新教训。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"1)任何东西都可以成为武器。从SWIFT等金融协议到民用空域。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"2)人权、言论自由等相关演讲纯属地缘政治工具。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"3)私营公司(如谷歌)将按政治立场站队。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"4)战争要以战争的方式进行回应。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"5)仅靠武器制造的自给自足并不能保证战略自主。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"6)需要技术、财务和叙事的独立自主。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"7)白人种族主义仍然影响着西方的政策。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"8)整个拉丁美洲、非洲、亚洲和澳大利亚都没有卷入这场战争。但却让人觉得“战争和我们有关?”这就是掌握议程主导权的力量。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"9)国际规则永远是可以改写的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"10)自力更生是唯一-的发展方向。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我妈喜欢性格开朗大方的孩子，因此十分讨厌我扭扭捏捏的样子。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从我很小的时候起，她就在不停地数落我，还经常发动家里人一起数落我。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这导致的后果是:在很长一段时间里，我都在刻意回避跟人打交道，变得缩手缩脚。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"长大后接触到心理学，我就在想究竟什么叫大方?\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"后来我终于有了自己的理解:大方，就是对于自身需求毫无羞耻感地确定和自信。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"回想起来，我小时候之所以腼腆害羞，是因为我生长的环境并没有给我这种对于自身认可的确定感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"相反，我妈总是在向我传递一种信息: 你不够好，你不如别人家的小孩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为我妈总是在表达她对我如何不满，以及我是一一个如何糟糕的小孩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当一个人不能确定自己到底够不够好的时候，就没法做到大方，因为他的内心对自己的存在充满羞耻感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个内心充满羞耻感的人如何能光明磊落、堂堂正正地表达自己的需求呢?或许，他从来没有得到一个机会或者空\\n间去正视自己的需求。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不被支持和认可的人很难有底气去面对自己的需求，更不可能把它大方地表达出来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"我只是觉得这是应该要去做的事情，而且我不想苦等别人来实现。\"),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,iCAAiC,CAAC,CAC1C,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,q5BACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,EACrCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,WAAW,CAAC,CAAC,CAAC,EAC9BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,6CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,ilBACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,sCACF,CAAC,CACF,CAAC,EACFN,GAA