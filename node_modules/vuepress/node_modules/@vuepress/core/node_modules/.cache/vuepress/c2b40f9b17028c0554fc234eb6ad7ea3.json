{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/13.关于“孤”和“勇”.md?vue&type=template&id=10b47b03","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/13.关于“孤”和“勇”.md","mtime":1768579404260},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/05.human/13.关于“孤”和“勇”.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"《孤勇者》现在的爆火其实挺可悲的，因为它在本质上是主流群体对非主流群体的一次收编。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"仿佛世家出身的政客为了竞选故意换上矿工们的牛仔裤，姿态不仅笨拙，而且几乎可恶。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"让我们来看看如今提到这首歌时，通常会被联系起来的都是什么群体：缉毒警察、消防员、防疫志愿者、“大白”……尤其是后两个群体，我相信这也是《孤勇者》会在2022年的当下突然走红的原因，它看起来实在太合时宜了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是我们审视一下，这样的对应是否合适。别的不说，就以后两个群体为例。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"兴许他们是“勇”——面对致死率高达万分之三的奥密克戎，也许确实还需要足够的勇气吧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但他们到底“孤”在何处？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们所到之处，无不是鲜花、掌声、“同志们辛苦了”，小学生带着学校布置的任务，为他们唱跳“听我说谢谢你”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而成千上万人无论被他们捅嗓子眼多少回，或者是被贴上封条、困在高速上多少天，也不能流露反感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这样一些有着如此强大依靠的、不会被任何反对动摇的人，他们何以被称为“孤勇者”呢？他们的防护服价值高昂，而且不用自己出一分钱，远远不是什么“破烂的衣裳”、“褴褛的披风”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从正规的新闻报道到抖音视频百家号都充满了他们的身影，大小赞誉无一不足。他们始终站在光里，其中一些借此还赚的盆满钵满，完全无需质问“谁说站在光里的才是英雄”。更进一步，他们本身就是“带着光驯服每一头怪兽”的人，自然不需要借任何人的光——只有别人向他们借光的份。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么，谁才是真正的孤勇者呢？是那些被“光”驯服的“怪兽”，是不讨人喜欢的“小丑”，是那些被泼上满身烂泥和污垢，却不跪也不低头的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们不借谁的光，光也讨厌他们，于是他们也就生活在黑暗中，隐匿在黑暗中，却依然执着地试图与几乎不可能被战胜的对手搏斗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而许许多多的小学生或者成年人们，一边唱着《孤勇者》，一边为“光”战胜“怪兽”而拍手叫好，往“小丑”的身上泼更多的烂泥。还有什么比这更可悲的事吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这首歌本身是赞扬处于贫困身在污地却始终保持善良和希望的人，对应的人是蔚和维克托\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最适合的人群是敲盆被拘留的大妈，是拒不进入方舱隔离的夫妇，是坚持要让孩子在身边的上海妈妈\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"同济大学的学生是孤勇者，接力转发《上海四月》的是孤勇者，因此而被微博封禁的也是孤勇者。唯独能随心所欲在别人家门口钉钢筋的不是。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这首歌，孤勇者歌颂的是小人物的反抗，不把我当回事，大不了鱼死网破一拍两散。凭什么你们这些光鲜亮丽的才是英雄？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但还有一种可能，“孤”正是因为无论有多少鲜花掌声，愿意和他们做一样事情的永远是少数，无论他们做到什么程度，总会被批判，仿佛他们不仅要帮助人们，还得致力于让人们不用付出一丝一毫代价。他们的防护服是很昂贵，然而里面充满的汗水和闷热，是不是够称之为“褴褛”，难道只有一件满是破洞的廉价衣服才配让人尊敬？\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,wGACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN