.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"性情古怪，难以捉摸，但是在不熟的人眼中是很温和的人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"对一些问题会很矛盾，比如我有洁癖，但是又很喜欢猫，所以每天都在花费很多时间处理卫生问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"书桌上的东西一定要一眼就能找到，其他的地方乱糟糟。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对规律性有莫名的执念，但是又不愿意去遵守。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"道德感很差，我会帮助人也会照顾人，但只是出于如果不这样做会比这样做遭受更多恼人的事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"容易沉迷在自己的世界里，而且不是随便谁都能进来说上话的世界。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"孤僻。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"对外情商是在线的，准确来说是除了自己，其他人都是外人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"择偶标准苛刻。但是我找到了，是一个很聪明很优秀的人，数独单方面被虐啊。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"同理心很强，但是说实话只是整合资讯在必要的时候代入导致的。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虽然整体成绩还不错，但其实偏科很严重，越到后面越严重，但是再到后面就会一通百通了，包括生活，社交方面，也通。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"深度内省，针对个人问题进行调律，这也是为啥我作为一个阿斯和重度抑郁患者依旧可以正常生活的原因之一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"具有哲学性思维，并非什么辩证法这样的，而是一种说不清道不明的东西。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"并不是说智商高就是高学历，要想有高学历就得有高的动机\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"傲慢，但是不会不好相处。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"学习能力非常强，因此创新能力也强。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"高敏感，不光精神敏感身体也敏感，日常和各种生活元素作斗争，噪音和不好的气味简直就是噩梦。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"求知欲特别旺盛，好奇心害死猫的那种程度。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"慕强，但是不会表现出来，至少对于不如自己的人基本上没兴趣，愿意相处说明他有过人之处，比如她心很大，特别大，想学，但是学不会，自己心太细，心太重。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"可以控制住自己的欲望，并且能快速转移\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"很多在长得很大以后才学到的东西在很小的时候就懂了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"思维停不下来→睡眠差，多梦\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"心理高度成熟→在一些事上的想法和行为像小孩→化繁为简。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"社恐专家。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"觉得自己特别蠢，特别傻，什么都不懂。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"记忆力很差，但是别人不知道。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"会有些自说自话。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"可以接受人的任何缺陷，但是在自己身上不行。——完美主义——固执。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"耍小聪明的人一眼就能看出来，但是一般不会戳破。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"无性恋+智性恋。感觉对于聪明的人可以战胜高颜值高收入。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"懒得争辩，懒得吵闹，懒得出轨…不太知道怎么说，就是很懒。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"身边真的聪明的人也挺常见，于是导致了和普通智商水平的人话题更少。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"薛定谔的记忆力\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"童年不会太快乐。因为格格不入，感性战胜不了理智，规则战胜不了原则。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"喜欢待在角落里，在自己的房间也一样。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"兴趣点，笑点什么的都很奇怪。比如…我喜欢看别人发呆，感觉他瞳孔变化的过程很有意思。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"追寻一种意义，至于是什么意义，还挺难说的明白。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"喜欢纯粹的事物。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,E