lf._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"‌在中国，任何超脱飞扬的思想都会砰然坠地的，现实的引力太沉重了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌在疯狂面前，理智是软弱无力的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌他看到了天空的红光背景在微微闪动，整个太空成一个整体在同步闪烁，仿佛整个宇宙只是一盏风中的孤灯。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌你看经济学的基本公理就是人类的唯利是图，没有这个前提，整个经济学就将崩溃：社会学的基本设定还没有定论。但可能比经济学的更黑暗，真理总沾着灰尘……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌他们父子之间的沉默要比语言传递更多的信息，从小到大，父亲是用沉默而不是语言教育他的，语言只是沉默的标点符号，正是这种父亲的沉默造就了今日的\"\n        ),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E7%AB%A0%E5%8C%97%E6%B5%B7&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2304100885%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"章北海\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\"。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌什么都有结束的那一天，太阳和宇宙都有死的那一天。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌大部分人的爱情对象也只是存在于自己的想象之中。他们所爱的并不是现实中的她（他），而只是想象中的她（他），现室中的她（他）只是他们创造梦中情人的一个模板，他们迟早会发现梦中情人与模板之间的差异，如果适应这种差异他们就会走到一起，无法适应就分开，就这么简单。你与大多数人的区别在于：你不需要模板。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"‌“没办法，我们在\"),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E5%85%89%E9%94%A5&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2304100885%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"光锥\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\"之外。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“什么？”“光的传播沿时间轴呈锥状，物理学家们称为光锥，光锥之外的人不可能了解光锥内部发生的事件。想想现在，谁知道宇宙中有多少重大事件的信息正在以光速向我们飞来，有些可能已经飞了上亿年，但我们仍在这些事件的光锥之外。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“光锥之内就是命运。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌给岁月以文明，而不是给文明以岁月。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌不要去做忘掉她的努力，没有用的，但随着时间的推移，她对你生活的影响会越来越小的。其实你很幸运，不管她是不是真的存在，能爱就很幸运了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"‌我不需要\"),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E6%80%9D%E6%83%B3%E9%92%A2%E5%8D%B0&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2304100885%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"思想钢印\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\"，我是自己信念的主人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌成吉思汗的骑兵，攻击速度与二十世纪的装甲部队相当；北宋的床弩，射程达一千五百米，与二十世纪的狙击步枪差不多；但这些仍不过是古代的骑兵与弓弩而已，不可能与现代力量抗衡。基础理论决定一切，未来史学派清楚地看到了这一点。而你们，却被\"\n        ),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E5%9B%9E%E5%85%89%E8%BF%94%E7%85%A7&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2304100885%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"回光返照\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\"的低级技术蒙住了眼睛。你们躺在\"),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E7%8E%B0%E4%BB%A3%E6%96%87%E6%98%8E&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A2304100885%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"现代文明\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\n          \"的温床中安于享乐，对即将到来的决定人类命运的终极决战完全没有精神上的准备。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌其实，末日是一段很美的时光，甚至可以说是最美的时光。这是历史上唯一一次的机会，人们可以抛弃一切忧虑和负担，完全属于自己。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌我的心已是一堆燃烧过后的灰烬，没有愤怒的能力了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌你们对人类的呼唤从不理睬，无言是最大的轻蔑。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌大多数人，到死都没向尘世之外瞥一眼。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌她将度过怎样的一生呢？但愿她能记得，茫茫星海中，有一颗星星是属于她的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌周围怎么是这样，看这束夕阳透进窗里的余晖，投在白墙上如一摊肮脏的血；外面孤独的橡树，不过是坟墓中伸出的枯骨……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌她也要在无边的黑暗中漂流了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌人类不感谢罗辑。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他眼中锐利的光芒熄灭了，代之以晚霞般的平静。漫长的使命已经最后完成，那最沉重的责任现在离开了他。以后，不管他在已经女性化的人类眼中是怎样的恶魔和怪物，人们都不得不承认，纵观文明史，他的胜利无人能及。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"‌然后人类出现，与以前漫长的岁月相比仅是弹指一挥间，王朝与时代像焰火般变幻，古猿扔向空中的骨头棒还没落回地面就变成了宇宙飞船。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌宇宙不是童话。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌失去人性，失去很多；失去兽性，失去一切。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"‌弱小和无知不是生存的障碍，傲慢才是。\")]),\n    ]\n  )\n}\nvar stat