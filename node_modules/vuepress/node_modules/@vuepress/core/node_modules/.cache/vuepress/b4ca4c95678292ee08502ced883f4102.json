{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/10.语录.md?vue&type=template&id=2f15a7fa","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/10.语录.md","mtime":1768579404273},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","start","href","target","rel","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《笔记》/10.语录.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"ol\", [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有这样一群人，他们看上去沉默寡言，生人勿近，甚至不合群。在你看来他们是那样的孤独寂寞，但请收起你的怜悯。他们心中自成一方天地，那是别人所不能触及的净土，瑰丽而又惊世；饱含着生命力与自然的野性。对于他们这方土地已经足够热闹，无需尘世喧哗。而所谓的孤独与冷漠不过是这世界的守门人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"2\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“你连想改变别人的念头都不要有。要学着像太阳一样，只是发出光和热，每个人接收阳光的反应有所不同，有人觉得刺眼有人觉得温暖，有人甚至躲开阳光。种子破土发芽前没有任何的迹象，是因为没到那个时间点。只有自己才是自己的拯救者。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"3\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“越是气场平和、心性温柔的人，越不爱和别人太密切地交往，生怕哪里辜负了对方的期待，同时也绝少期待他人。于是在一般社会看来，反而像是比较冷淡的人。”\\n“可惜越温柔的人，偏偏越难驯服。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"4\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人们以为苦难会让人更为强大。但实际上，大部分人被苦难折磨的不成样子，懦弱，保守，浑身充满奴性。像狗群迁徙一样走在街上，发出快乐的笑声。真正因苦难而变强大的人，从不认为自己经受过苦难。那些声称从苦难中走出来的人，是脱了人皮穿上囚服走出来的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"5\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"群众从未渴求过真理，他们对不合口味的证据视而不见；假如谬误对他们有诱惑力，他们更愿意崇拜谬误。谁向他们提供幻觉，谁就可以轻易地成为他们的主人，谁摧毁他们的幻觉，谁就会成为他们的牺牲品。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"6\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"包括我父母从小对我的教育，也很传统。比如吃亏是福，得饶人处且饶人，大事化小小事化了。我的成长经验只告诉我这些都是懦弱的表现形式，只会让人变成软柿子和受气包。自私的人都快乐，他们的世界里没有别人的看法这种东西。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", { attrs: { start: \"7\" } }, [_c(\"li\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为我有幸孤身独处，虽然我从来并不孤独，我只是独自一人而已，独自生活在稠密的思想之中，因为我有点儿狂妄，是无限和永恒中的狂妄分子，而无限和永恒也许就喜欢我这样的人。\\n-----博胡米尔•赫拉巴尔《\"\n        ),\n        _c(\n          \"a\",\n          {\n            attrs: {\n              href: \"https://www.zhihu.com/search?q=%E8%BF%87%E4%BA%8E%E5%96%A7%E5%9A%A3%E7%9A%84%E5%AD%A4%E7%8B%AC&search_source=Entity&hybrid_search_source=Entity&hybrid_search_extra=%7B%22sourceType%22%3A%22answer%22%2C%22sourceId%22%3A756020375%7D\",\n              target: \"_blank\",\n              rel: \"noopener noreferrer\",\n            },\n          },\n          [_vm._v(\"过于喧嚣的孤独\"), _c(\"OutboundLink\")],\n          1\n        ),\n        _vm._v(\"》\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"当黑夜降临，吾必立身万万人前，横刀立渊，血染天穹。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"很庆幸，鲁迅的文章仍然适用\\n很悲哀，鲁迅的文章仍然适用\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"叔本华：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“对于一个年轻人来说，如果他很早就洞察人事、谙于世故，如果他很快就懂得如何与人交接、周旋，胸有成竹地步入社会，那么不论从理智还是道德的角度来考虑，这都是一个不好的迹象。这预示着他的本性平庸。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“Nothing just happens, it's all part of a plan（没有事情随随便便发生，都是计划的一部分）”.\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我一生都会记得本科马哲课老师给我们讲的例子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有人问黑格尔“你怎么证明这张桌子是没有意识的?”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"黑格尔用他厚重的大皮靴狠狠地踢了桌子两脚:“这世界上有比这重要得多的事情值得去研究。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"?\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你让我去探究桌子有没有意识，我确实没法探究。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它或许确实是有意识的，正在骂我无缘无故踢它，但那又如何?它能拿我咋办?它的意识能对这个物质的世界施加哪怕一丁点儿的影响吗?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"它不能。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虚空对虚空的辩经没有任何的意义，“我牛逼是因为我牛逼”的循环论证没有任何的意义。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"网线一拔，你的喜欢或者不喜欢没有任何的意义。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"世界是物质的，你的精神要想发挥作用，就要作用在物质上，否则你就是那张桌子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"若批评不自由，则赞美无意义。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE,CAACA,EAAE,CAAC,IAAI,CAAC,CAAC,CAAC,EACpBD,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4IACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,KAAK,EAAE;IAAI;EAAE,CAAC,EAAE,CAACN,EAAE,CAAC,IAAI,CAAC,CAAC,CAAC,EAC/CD,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gHACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,KAAK,EAAE;IAAI;EAAE,CAAC,EAAE,CAACN,EAAE,CAAC,IAAI,CAAC,CAAC,CAAC,EAC/CD,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8FACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,KAAK,EAAE;IAAI;EAAE,CAAC,EAAE,CAACN,EAAE,CAAC,IAAI,CAAC,CAAC,CAAC,EAC/CD,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yHACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,KAAK,EAAE;IAAI;EAAE,CAAC,EAAE,CAACN,EAAE,CAAC,IAAI,CAAC,CAAC,CAAC,EAC/CD,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8FACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,KAAK,EAAE;IAAI;EAAE,CAAC,EAAE,CAACN,EAAE,