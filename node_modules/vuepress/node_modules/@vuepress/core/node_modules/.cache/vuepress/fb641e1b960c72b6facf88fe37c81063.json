{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/07.谷爱凌的成功，和普通人有什么关系.md?vue&type=template&id=214b3be4","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/07.谷爱凌的成功，和普通人有什么关系.md","mtime":1768579404254},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/07.谷爱凌的成功，和普通人有什么关系.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"这几天铺天盖地的是谷爱凌奥运摘金的新闻。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"对于她个人，她的家庭，这是了不起的成就，值得大声庆祝。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实不止是谷爱凌，每一个运动员,不管出生在哪里，国籍是什么，能有机会参赛，并全力以赴取得自己的最好成绩，都值得被大大的庆祝!\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"无论这个赛事是不是奥运会，无论运动员是不是取得金牌。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我想这也是体育精神，和奥林匹克精神的本意。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"谷爱凌在社交媒体宣布加入中国籍,中国人为之欢呼，合情合理。同时，美国有不同的声音，也可以理解。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '不知道大家记不记得何智丽，中国人，上海出生，在中国长大、训练、成名，因为婚姻加入日本藉,用曰本名字小山智丽参赛，为日本队拿奖牌。中国当年对何的评价，不乏“叛徒”、“卖国贼”、“汉奸\"这些帽子，有几个媒体，多少观众，站出来为她作为运动员的成就鼓掌喝彩?\\n谷爱凌也是美国出生、长大、训练、成名，按照当年中国观众对待何智丽的态度，美国广大群众是不是也应该站出来骂她是“叛徒”,“卖国贼”,“美奸\"?'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果我们觉得这些行为不可接受,对之嗤之以鼻，那不如从审视当年对何智丽的态度开始。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"谷爱凌加入了中国国籍，又取得了金牌,无数人欢呼，似乎与有荣焉。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但其实我们要思考的,是她的成功，和大多数中国人，有什么关系。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"1.目前没有谷爱玲退出美国籍的证据，所有申请退出美国国籍的,在美国都有公开的[记录](https:// www.federalregister.gov/quarterly-publication-of-individuals-who-have-chosen-to-expatriate )，每季度更新,至今还没有她的名字。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一直有很多人呼吁中国支持双重国籍，特别是很多海外的华人，可以方便来往，更容易参与到国内的发展建设，方便和家人团聚。希望从谷爱凌开始，看到海外华人更大的价值,推动双重国籍成为人人都可以享有的权利。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"a person whose application for naturalization as a Chinese national hasbeen approved shall not retain foreignnationality.\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"p\", [_vm._v(\"被批准加入中国国籍的,不得再保留外国国籍。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果未来有越来越多的人可以通过公开透明的渠道持有中国和外国的双重国籍，对很多在海外的华人回国发展,更好地安排自己的生活,有更直接的促进作用。也许你说谷爱凌是特殊杰出人才，没问题，特殊杰出人才也应该有公开透明的通道,我们都希望中国可以吸引越来越多的杰出人才。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '2．谷妈妈提到每年在海淀黄庄“上10天补习班，相当于在美国上一年”\"。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"看到这个，我就想，可不要有国内的妈妈说，你看你看，我让孩子上补习班，和人家谷爱凌的教育方法是一样的，我上的还更多!中国有如此高效的教育，为什么她妈妈要选择大部分教育在美国浪费时间呢?按照这个数学关系，如果在国内上一年，岂不是更有效?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我想谷妈妈是懂教育的,知道最好的教育是平衡的，知道在中国和美国各取所需。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"美国有自由的环境，有多元的选择，有包容和平等，中国有考试做题的方法，有高分秘籍。两者结合，实现了近乎完美的高质量教育。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v('但是对大部分国内的家长，是没有条件在中国和美国“各取所需\"的。'),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果整年都要上那些班里所有学生都在一起上的,“10天等于一年”的补习班,很幸福么?补习班还不够高效，我们还有某些县城中学，早上5点起，晚上11点睡。宽松包容的大环境里面，孩子反而更有内驱力,更愿意吃苦愿意拼搏，天天吃苦，是痛苦，没有幸福，更不是好教育。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '谷爱凌聪慧又努力，每年夏天上海淀的补习班，到美国考试有好成绩，对她是件好事。但是对大部分的中国家长,孩子的教育出如果不能在美国，那这个“美国学校加海淀补习\"模式的优越性,和大家没有什么关系。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"另外很多报道都在说SAT1580分，似乎去斯坦福是靠洋高考，按分数录取的。其实远远不是，美国大学录取，成绩只是一个重要参考，但达到要求以后就一视同仁，还会综合看很多其它方面的表现。这个成绩在美国的亚裔孩子里并不少见，也不是大学录取的保证。斯坦福录取是看综合能力，成绩这一项,她靠在海淀补习，其它参考项呢?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"用一个简单化的比喻，教育要成功,有甜有苦。底层需要是甜的,就是对孩子的无条件的支持和爱，是自由开放的环境,是支持孩子发现的兴趣，并付出努力。也需要一些苦，像黄庄补习班刷题。谷爱凌在美国有足够的甜，每年到海淀沾10天的苦，可能是完美配比。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但如果那些每天泡在苦水里的人，突然因此看到了自己体系的“苦”的巨大意义并为之自豪，甚至变本加厉，是不是挺可悲的?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"希望更多人看到，哪里的孩子，哪里的教育,底层都应该是甜的,作为成人，都应该有权利去争取，去推动，去改变。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"3.主流文化，仍然是崇尚赢，崇尚强者。但是在任何一个比赛里，按照成绩，赢的只有一个。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"谷爱凌因为是强者,所以有无数关注。对她个人，对她的家庭，还是那句话，可喜可贺。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '谷爱凌夺金，看到的有北京市祝贺\"“北京姑娘”，交通部祝贺“交通部后代”，旧金山祝贺“旧金山 girl”......而同样是加州女孩，并且真正地“响应国家号召\"放弃了美国国籍的朱易就没有成为“靓丽的风景线”,周末两次赛场失误后立即“遭到网暴”。不仅无人攀亲,反而被追责乃父。成败论英雄，实用主义到了如此地步，令人唏嘘。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实大家应该意识到，在以成败论英雄的的体系里，其实大部分人是失败者,也是受害者，因为站上领奖台的只有那一两个，而这个人，大概率不是你。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"只有当我们为每一个人的努力和成就喝彩的时候，社会才是在正向发展的。这也是对谷爱凌们最好的保护,因为没有人能够次次夺冠，当失误的时候、失败的时候，她仍然是一个顶级优秀的运动员。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"4.每个人的成长历程，都是复杂的，有多方面因素的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有内在因素--天赋、努力、家庭基础;也有外在条件―-财力、资源、公平、透明、专业的环境。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '内因,每个个人或家庭,各不相同,而那些“外因\"才是和大多数人真正相关的。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '有人找出来1998年《中国科技信息》刊登的对谷爱凌妈妈谷燕女士的报道，问到为什么只有美国才有硅谷，她很直接地回答:“美国的制度造就了硅谷。”看来谷燕女士也很明白这些\"外因\"的重要性。'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"因为有独特的内因基础,可能成为世界顶级运动员的,是极少数。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"出现在你我身上几率微乎其微。但出现的时候,我们要大声喝彩!\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"时间也巧，徐州的悲剧没有得到一个令人信服的调查结果，就被铺天盖地的谷爱凌淹没了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"中国女性面对的体系性困境和结构性桎梏,并没有什么改变。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"现实是,绝大多数女性没有机会成为谷爱凌,而小黑屋里丰县女性的悲剧，如果没有法制的进步，文化的觉醒,才是真真切切可能发生在每一个人身上的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"希望我们在大声喝彩的时候,也莫要忘记。\")]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [_c(\"p\", [_vm._v(\"转自某国内不允许发布的机构\")])]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,sBAAsB,CAAC,CAAC,CAAC,EACzCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,6BAA6B,CAAC,CACtC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uMACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,iCAAiC,CAAC,CAC1C,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mKACF,CAAC,CAC