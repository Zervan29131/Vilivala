 attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"言论自由\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#言论自由\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 言论自由\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"1989年，《郑州晚报》 记者殷新生，因揭披郑州市检察院越权事件，被诬陷入狱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"1998年，《山西青年报》 记者高勤荣，因揭露山西运城渗灌工程造假，被判刑12年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2002年，《京华时报》 记者杨威，因采访物业纠纷问题而遭遇殴打，导致耳鼓膜穿孔。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2003年，《南方都市报》 因报道孙志刚案与非典事件，影响高层仕途，主编程益中被捕。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2005年，《河南商报》 记者范友峰，因调查报道聂树斌案，被迫辞职，淡出新闻界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2006年，冰点周刊因刊登《现代化与历史教科书》，被停刊整顿，主编副主编均被免职。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2008年，《法制日报》 记者朱文娜，因采写辽宁西丰拆迁案，被警方拘传。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2008年，《民主与法制时报》 记者景剑锋,因报道山西公安包庇黑恶势力，被判刑1年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          '2009年，《河北青年报》 副总编辑乐倩，遭遇歹徒报复行凶，歹徒边打边喊\"叫你报!”'\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2010年，《经济观察报》 记者仇子明，因报道凯恩股份交易内蒂,被当地公安局网上通缉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2012年，《东方早报》 记者简光洲，三鹿奶粉首位报道人，发表'新闻已死”，离开新闻行业。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2013年，《新快报》 记者刘虎，因实名举报工商总局副局长，被关押346天。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2013年，《南岛晚报》 记者杨琼文，因曝光海南万宁校长开房案，被迫离职。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2013年，中国揭黑记者第一人王克勤，因《北京暴雨失踪者》-文，《经济观察报》 调查部被解散，王克勤本人被迫离职。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"2016年，《兰州晨报》 《兰州晚报》《西部商报》 三名驻武威记者，因被当地部门视为发充“虚假信息”而遭遇逮捕。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"伴随着新媒体的兴起，传统的调查记者不断没落，而没了他们的参与，人们再也看不清各种事件的全貌。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"罢工自由\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#罢工自由\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 罢工自由\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"1975年1月13日至17日，第四届全国人大第一次会议在北京举行，大会最重要的一项议程即修改宪法，此次修宪，在毛泽东的坚持下，“罢工自由”才首次写入了宪法。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"1976年9月9日教员与世长辞。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"1982年再度制定宪法，“罢工自由”（恶意讨薪）被删除。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"伟人只有一个\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但他来过，接下来只能靠我们燎原\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们在黑暗中摸索未来\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"没人能告诉我们牺牲和付出到底有没有结果，甚至没人能告诉我们对错。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"毛主席的爸妈生了7个孩子，夭折了4个，活下来的只有三兄弟，当二弟泽民三弟泽覃牺牲，当妻子牺牲，全家只剩自己一人时，他会不会迷茫，会不会恨，会不会问自己这一切到底值不值得？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"朱德的女儿朱敏在苏联时被德国人抓进集中营，虐待多年生死未仆，他有没有因此自责过？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"徐东海66口被灭门，贺龙全家109口被杀，他们有没有害怕过？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"还有那么多牺牲的人，他们呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我相信都有，他们也是有血有肉的人。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所谓仪式感和圣人，或者说“昭昭天命”，这都是以后来的眼光看待的，在那个年代，每个革命者都低着头处理一件又一件麻烦，会害怕，会迷茫，会退缩，会做错，甚至有的会叛变。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但还是有人没放弃，这才是最伟大的地方。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"“同志们，8年抗战就要开始了”\")])]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当我知道革命终将胜利，我们必然成功的时候，世界上就没有什么能吓到我了！乌拉\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"过于理想主义的设想，脱离实际，必然失败。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"理想很伟大，但也要看到其中空洞、不准确理解世界和人性本质上的不足的问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"革命需要浪漫激情，可以纯粹而高尚，但建设和管理国家需要脚踏实地和善于周旋妥协，难免庸俗卑下。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEG,EAAE,EAAE;IAAO;EAAE,CAAC,EAAE,CAClCL,EAAE,CACA,GAAG,EACH;IAAEM,WAAW,EAAE,eAAe;IAAEJ,KAAK,EAAE;MAAEK,IAAI,EAAE;IAAQ;EAAE,CAAC,EAC1D,CAACR,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDT,GAAG,CAACS,EAAE,CAAC,OAAO,CAAC,CAChB,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,4CACF,CAAC,CACF,CAAC,EACFT,GAAG,CAACS,EAAE,CAAC,GAAG,CAAC,EACXR,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACS,EAAE,CACJ,0CACF,CAAC,