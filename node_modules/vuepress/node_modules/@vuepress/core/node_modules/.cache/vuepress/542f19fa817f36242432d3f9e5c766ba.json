.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"生活中必然存在绝望，我们需要做的就是先学会和这种心平气和的绝望握手，而不是深陷无力感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从无力感中解救自己，不让生活中繁重的日常诸事和具体的情感绑缚灵魂，深知人生围城的必然，但仍要反抗这必然带来的绝望，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"城里的人想冲出去”，去向哪里？去接触一个不同的环境，新的人与事，可是为什么生活却总是在重复？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“你不讨厌，但毫无用处”是他唯一的好友对其中肯的评价。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"社会的零余者是最有权力嘲笑掌有职权的人的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"虽然不愿意相信，但是生活中的痛苦很大程度上都是自己造成的，自我即地狱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当少年海阔天空言志的时光变成渺远难觅的昨日岁月，生活的林林总总扑面而来，我们也进入了方鸿渐式的围城，总希望一夜难眠辗转反侧后下定的突围决心，可以带我们逃离现在的围城，但是现实生活中的每一件事情都如蛛丝缠住了你，轻盈的灵魂被生活和情感的千头万绪撕扯着，绑缚着你身体的每一根神经，你必须面对日复一日，周而复始的生活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"逃出一座城后，不容你喘息，意识就会告诉你这不过是另一座城。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“很长一段时间，我的生活看似马上就要开始了，真正的生活，但是总有一些阻碍阻挡着，有些事得先解决，有些工作还有待完成，时间貌似够用，还有一笔债务要去付清，然后生活就会开始，最后我终于明白，这些障碍，正是我的生活”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"围城是永远也无法逃离的，这是一个周而复始的游戏，只要自我和群体存在，自我的无法改变，个体与任何群体的相容度就自然也不可能改变，那么我们是不是要像《围城》中所说“抛下一切希望罢，你们这些进来的人”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"绝望之于虚妄，正与希望相同\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"方鸿渐式的绝望并不在于围城存在的必然，而在于他不断的逃离与认清\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"生活中必然的绝望，我们需要做的就是先学会和这种心平气和的绝望握手，而不是深陷无力感。从无力感中解救自己，不让生活中繁重的日常诸事和具体的情感绑缚灵魂，深知人生围城的必然，但仍要反抗这必然带来的绝望，正如鲁迅《过客》式的英雄，前面是什么？前面是坟，但我仍要走。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"周而复始的围城带来生活中心平气和的绝望，然后反抗，于无物之阵中战斗，绝望之为虚妄，正与希望相同，正因为反抗，慢慢才会衍生出生生不息的希望，而不是的投降！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"语言表面上也看似“逢场作戏”，实则隐喻着作者情感上的睥睨慈悲，他笔下的人物或窘迫难堪、粗鄙媚俗，或虚伪遮掩、蝇营狗苟，他们都生活在作者几乎是尖酸刻薄的语言讽喻中，但被如此描述下的每一个人物都执拗自我，活得认真，恰恰是这份认真，营筑了各自的围城，才有了大时代中个人努力下的挣扎与计较，有了群体生活中个人心理的不堪与狼狈，读者读着书中各色人物，哀其不幸，恨其不争，自然想到这围城亦是自己的人生，走入一个又一个循环，难以突围。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,6CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,6BAA6B,CAAC,CAAC,CAAC,EAChDN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,uBAAuB,CAAC,CAAC,CAAC,EAC1CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8JACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,4GACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oGACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAAC