{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/01.八佰.md?vue&type=template&id=290d2871","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/01.八佰.md","mtime":1768579404265},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/99.archive/01.八佰.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"昨天看八佰。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"导演是管虎。回想起来，我当时花了大约四秒，记起来他是老炮儿的导演。两部电影也确实是有相似之处的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"首先，老炮和八佰的明暗色彩都没毛病。就好像华丽的布幔，就算当不起主干，亦可装点门面；以至于预告片都能让人有所期待。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"再者，管虎似乎很执着于用动物隐喻。老炮里的鸵鸟、八佰里的白马，用的很明显；但不甚高明，一上来大家就知道是隐喻，开始猜他想说什么；也没有恍然大悟，就违和，也没意思。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还有软色情桥段。老炮许晴摆体位，尚能理解；八佰伊娃李不停露脸、脱衣服送旗就有些过，暴露其结构松散，得靠旁门左道让观众觉得值回票价。再有就是“痞子英雄”情结。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"老炮核心就是这个不说了；至于八佰，硬要安排混混去装电话线，历史上四行仓库保卫战期间电话线一直是畅通的；历史上国民党反动派才招揽地痞流氓办事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"​\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"还有一点很有意思，老炮上映后不久大家就知道冯小刚是个小人；八佰上映前大家就知道姚晨对祖国有些意见。电影中姚就出来露个脸，开玩笑，洗洗更健康。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"​\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"要是挑历史对应的毛病，有很多，不细说。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"要挑宣发的别扭之处，也有很多，可以自己搜。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"宣发其实挺谨慎的，尽量不提自己是历史片。其实只要投资到位，比烂都是可以的，何况还兼职贩卖爱国情怀，疫情放假好不容易出来正儿八经看个电影、票房不太用担心。老炮八佰都是华谊出的，兄弟俩现在都质押了九成以上股权，现在看还能再坚持一会。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其实可以用虎头蛇尾概括。宣发用力，内容不足是其一。后半段节奏失调是其二。大量铺垫去渲染，着重表现结尾的惨烈不易却是撤退是其三。主创没有历史大局观，没能够将八百壮士的历史意义与后面的历史有机连接起来是其四。其实看得出来，主创们知道精神主题应该是什么，但仅限于看了历史课本上定义的那种知道。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以上种种，还有其它，共同构成这个电影最大的问题，那就是精英主义心态。主创们凭这种心态认为：宣传无需讲究，制造话题即可，正负面只要度把握好就无所谓；历史无需真实，只要有真实事件的骨架，再随便加上些煽情内容群众就会买账；艺术内涵不用太多，多了观众都不一定能看懂；再不行，加些软色情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"私以为，在文艺创作与新闻传播创作者与参与者中这种心态是普遍存在的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中国古代是礼不下庶人的，当时的文化圈在某种程度上是鄙视底层人民的，一直到党让知识分子下乡与群众结合、新中国扫盲普及基础教育，这种落后心态还是顽固的留存下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在他们眼中，人民群众就是用来提供生产生活资料的，就是用来占领舆论高地的，就是用来为资本服务的。所以人民群众享没享受到发展成果不重要，是不是知道真实的历史与现实不重要，有没有自己的思想不重要、最好是没有；至于电影怎样，就更不重要，掏钱买票就行。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“人的正确思想只能从社会实践中来，只能从社会的生产斗争、阶级斗争和科学实践这三项实践中来”（毛泽东）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我错了。\\n八佰最大的问题其实是之中四行守军所做种种努力皆是为争取列强援助，电影最后竟冲锋似的、“惨烈地”冲向英租界以求撤退。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中国人民是自己站起来的，中国人民要站起来首要的就是摆脱帝国主义的工业倾销控制，建立关税壁垒，才有可能发展起来现代工业。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"而在思想上就必然要求放弃当时对西方帝国主义势力的一切幻想。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么，这部电影，想说什么呢。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,QAAQ,CAAC,CAAC,CAAC,EAC3BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,