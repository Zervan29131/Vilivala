{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/01.综述.md?vue&type=template&id=1c8d2184","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/01.综述.md","mtime":1768579404273},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","id","staticClass","href","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/《素材》/01.综述.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"在这里写下的既非正史也非杂谈。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它的内容将包根括当前人类所知晓的一切，却又是一切荒诞的垃圾堆。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"它可以说是神话但它是历史，因为历史的诞生标志着人们不再相信故事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我将要记述的是龙魂皇帝辉煌灰暗的一生和诸神的落幕。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"命运和因果的交织，其本身便是虚无。\")]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"综述一种族\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#综述一种族\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 综述一种族\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人族:命运之神和因果之神联合创出的造物，没有特别的长处，也没有特别的缺陷，各种力量都可以学习甚至可以创造神灵，可以说是九族之首\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"龙族:其本身诞生于战争之中，在天赋上可以说是最强大的。种族生长持续于其一生。在各个方面的天赋.上可能说是除了元素之子。之外，各种族中最强。这种非凡的种族的详细情况笔者将在后续章节中展开。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"精灵:精灵是各种精灵的统称包括火精灵，居住在高山的高精灵，在沼泽的灰精灵。当然、居于统治地位的是风之子的白精灵。整体来说，力量上低于人类，肢体灵活性上则远远高于，对于战争没有什么兴趣，有着自己的生活。自然假如有机会谁不想要平静的生活?\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"矮人:天地开辟之初，清者为天，浊者为地。大地形成之后,其余的部分成为泰坦-力大无穷的巨人，矮人就是泰坦血脉的传承者。在开辟矿脉，制造铠甲和机械方面都有着天生的灵感与智慧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"兽人:生命力的代表，在通常20岁时接受第一次试练来代表自己成人，在60岁时接受第二次试炼，代表着自己的新生。因而整个兽人以勇武的猛士而称雄于大陆。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"恶魔:火焰之子，出生岩浆之中。狡诈是恶魔的符号，同样的也是最诚实的种族之一。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"灵族:精神力量的代言人，一个普通的灵族人的天赋是最天才的人类法师也难以企及的，一部分高深者甚至能够舍弃肉体而存在。当然，天赋的本身也是阻碍。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"鱼人:海洋的歌者，水手在海洋.上常常能看先它们，能幻了化双腿在陆地生活，但是貌似还都是在水里比较适合他们，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"弃者:存在和各种族有相似性，但又不是该种族都属于此类。如近人族，半精灵，半身人，半兽人，蜥缘人，蛮人，巨魔，地龙，飞蛇，龙人等种族，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"综述-历史\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#综述-历史\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 综述—历史\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"本书为了叙述方便，在开篇,对于整个大陆将街概括性的简介以方使读者阅读，我们所居住的世界产生于一片的虚无。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在虚无中诞生了能量之神安其与物质之神森，二者在交缠中诞生了世界之神即地神盖亚。在地神手中的工作中我们居住的世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大陆，海洋天空被创造了，在这中诞生 了水元素神，火元素神，山神，海神，大气之神等自然神。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"与之相对是命运之神和因果之神。自然神们在创造了一切后便默默离开，只有得到他们青睐者，才有可能在灵魂的最深处与之相见。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们的神力在法术和仪式中仍然存在。主宰现有世界的是命运之神费特和因果之神茹尔，命运是无常的，因果是注定的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在对于世界的本源上，二者有根本的区别，而他们最大的实验场便是人间，而我们一般称前者居住的地方存天堂，后者为地狱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在世界的第一纪元，世界诞生，山川草木被创造，九族中的前身开始繁行。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在世界的第二纪元，九族的八族被创造，各个元素神创造了自己元素之子种族，命运和因果开始实验自己的理论。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在世界的第三纪元，人类-这一拥有世界上所有天赋(包括神性)的种族往被创造到了这个世界中。在第三纪元末，元素神不再以真实存在显现。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在世界的第四纪元，这是命运与因果交织的纪元，各个神灵不断被能造，又被人类所毁灭，如和平之神变为毁灭之神(寂静者),贪婪之神变为建设之神(创造者)。在连神灵都无法逃脱的时代，命运和因果永存。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在世界的第五纪元，即现在到未来的纪元，这是神灭的时代。所有的神衹退出人界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"因为命运因果其本身的区别已经是谜，当游戏规则判定的输赢无所谓时，游戏本身也无法进行。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是这也是人类的纪元和英雄纪元。当然，虽然这个时代的史料丰富，作者本身的阅历也足够庞大，但是本书所记载的所有事情和知识的时代均在龙魂皇帝重新建立教廷之前。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"龙魂帝国末期大事件-光荣政变\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#龙魂帝国末期大事件-光荣政变\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 龙魂帝国末期大事件—光荣政变\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"龙魂皇帝第二次跨海远征博-帝国，教会通过暗算成功迫使龙魂皇帝卧病在床，同时囚禁在没的负责人，掌控了国内大权。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"由于这次远征之前向罗罗卡扎地区商人和各地诸侯大量借款，以未来征服土地为担保。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是这次远征只是平手，获得一定量岁币和沿海驻扎点，不足以完全偿还借款。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"教会借机散布不能偿还借款和抄掠诸侯以补充国库的谣言。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"皇帝并非没有察觉，但是他仍然相信以自己的威望和实力足以说服诸人延期付款。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"加上教会成功控制皇帝在商会的代言人，以他的名义回到了罗罗卡扎。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在chergun城,这里是大军出征的补给基地，实际上有一只精兵把守，负责整训和运粮，实际上战斗力极强。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"自然把守的是心腹，但是二把手就未必了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"教会利用这一点成功在暗地里掌握了这只军队，同时派遣死士进去牢狱，自然管理监狱的人是打点好了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"皇帝登陆后召集商人准备商讨款项相关事物，在期间教会使者发布元老院最终劝告，表示要暂时监禁皇帝，在激烈抵抗后，皇帝被俘虏。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"通过皇帝印玺，教会召唤剩余部队登陆，留守指挥官认为有诈，将1/3部队(包括皇帝的儿子)派往哈特蒙德。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"剩余在上岸后被全部缴械。经过谈判，国家所欠款项以3成利息，10年时间偿还，半年后皇帝身死，以遗诏的名义还政于教会(元老院)，哈特蒙德拥立皇帝儿子，联邦以自治形式半独立。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,iBAAiB,CAAC,CAAC,CAAC,EACpCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,kCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,IAAI,EAAE;IAAEE,KAAK,EAAE;MAAEI,EAAE,EAAE;IAAQ;EAAE,CAAC,EAAE,CACnCN,EAAE,CACA,GAAG,EACH;IAAEO,WAAW,EAAE,eAAe;IAAEL,KAAK,EAAE;MAAEM,IAAI,EAAE;IAAS;EAAE,CAAC,EAC3D,CAACT,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,CACd,CAAC,EACDN,GAAG,CAACM,EAAE,CAAC,QAAQ,CAAC,CACjB,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iEACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,+FACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uHACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,E