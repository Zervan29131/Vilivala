{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/12.太阳系文明猜想.md?vue&type=template&id=013a59b6","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/12.太阳系文明猜想.md","mtime":1768579404258},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/04.universe/12.太阳系文明猜想.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"40亿年前，火星和地球仍处于活跃期，行星内部的压力和热量都还未释放完毕，每时每刻都有火焰和岩浆从地底喷出。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"古菌率先出现在了火星上。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在火星炽热的环境当中，绝大多数原生物都只能以火山热泉为能量来源，依附在海底的火山口附近生存。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而古菌依靠光能分解硫化氢、甲烷等物质来获取能源，开创了利用太阳光能的时代。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"宇宙文明的根基就在于能源，古菌掌握了更高级的能量利用方式，成为了火星上唯一的霸主。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"古菌呈现紫色是自然选择的结果。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"太阳光中，绿光光子含量最多，紫光光子含量最少，绿光也就成了古菌的最爱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们几乎把太阳光中的绿光完全吸收，而剩下的紫光光子含量少，被他们反射出来，因此他们便呈现紫色。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在科学方面，他们没有走上个体发展的道路，而是紧密的结合起来，用群体的力量来形成智慧。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"每一个古菌有活跃和休眠两种状态，这两种状态就分别构成了最简单的逻辑。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而如果几个古菌同时展现不同的休眠和活跃状态，那么就可以表述一件复杂的事情。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"休眠为0，活跃为1，古菌利用二进制开创0和1的逻辑时代。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"依靠着简单的本能进行探索，组成了第一台古菌智能“电脑”。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"由于古菌群落的壮大，不断的吸收火星上的甲烷和其他温室气体，使得火星快速的降温。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"火星的大气开始变的稀薄，变的越来越冷，火山活动也开始减缓，不久之后，火星将会变成一片冰冷死寂的世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"古菌没有办法改变自身，所以他们把眼光望向了地球，继而研发出太空飞船飞往地球。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那个时候的地球表面的火山活动比火星还要剧烈的多。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"古菌到达地球后，开始疯狂繁殖，抢占地球最宝贵的光能，形成能量利用形式上的优势。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在一千万年的时间里，地球也变成了火星一样的紫色星球。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"但是古菌已经把阳光吸收掉了，只剩下古菌无法吸收的紫光。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是蓝细菌进化出一种叫卟啉的分子，这种分子跟古菌的视黄醛一样，也是可以吸收光能。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而且主要就是吸收紫光，几乎完全不能吸收绿光。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是光有能量可不行，生命最终是要靠物质来维持的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而要合成有机物，最重要的就是氢离子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"此时地球上最多的物质就是二氧化碳，甲烷和硫化氢了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"古菌体内的视黄醛把光能转化能量，进一步劈开硫化氢，将其中的氢离子释放出来，氢离子再和二氧化碳制造出有机物。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"硫化氢被古菌完全占据，可如果蓝细菌不用掉从紫光中积蓄的能量，能量就会被白白浪费掉，于是蓝细菌直接用光能劈开水分子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"水分子虽然在地球和火星上随处可见，但是古菌却从不敢利用这种物质，因为劈开水分子，会释放出一个剧毒物质，那就是氧气。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"化学式为H2O的水分子被劈开后，形成的氧气是一切生命的大敌。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"氧气会带来氧化，对于生命体来说，氧化还有另一个名字，那就是衰老。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"古菌的寿命理论上是无限的，但是一旦接触到氧气，开始氧化之后，很快就会死去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"水分子被劈开后，蓝细菌吸收掉了逃逸出来的氢离子，同水中的二氧化碳合成了有机物，这个行为便是光合作用。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这个行为改变了地球几十亿年的进程。因此蓝细菌也可以说是所有植物的始祖。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那时候的地球没有任何氧气，而这种全新的气体可以氧化蓝星上的任何离子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"空气中的硫化氢被氧化沉积，海洋中的铁离子被氧化形成铁锈。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一开始的地球是最适合古菌生存的，但是蓝细菌造出来的氧气却在改变着这一切。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大气层中的甲烷被全部氧化掉之后，蓝星遭受到了火星一样的结局，那就是变冷。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"地球的温度开始骤降，火山活动和温室效应的正循环被打破，随即地核的活动开始变缓。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"整个地球变成了洁白一片，即使是赤道上也是千里冰封，万里雪原。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"古菌和蓝细菌都被深埋在冰层之下。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而此时的火星也是一样，因为火星的质量比蓝星小，本来他的引力就不足以束缚二氧化碳气体。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"再加上古菌们的不断吸收，火星也变成了一颗死寂的星球。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"太阳系已知第一代文明就此终结。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,cAAc,CAAC,CAAC,CAAC,EACjCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,gDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GA