{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--3-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/94.资本与奴隶.md?vue&type=template&id=a93fcd58","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/94.资本与奴隶.md","mtime":1768579404257},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/03.随笔/94.资本与奴隶.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"今天，要上工了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你踱到工厂，一个奴隶跪在地上：“老爷好。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你问：怎么还不上工？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"奴隶说：大伙都在等老爷训下。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你说：不用等，早晨7点上工，晚上10点下工，以后就这么定。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"奴隶点点头，戴着镣铐的手掏出卷闸门遥控器：请老爷开厂门。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你摇摇头：不用，你们自己开门。这东西交给你保管。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"奴隶开了门，有监工们挥着皮靴，把一个个大大小小男男女女的奴隶们，抽着他们，赶进工厂里。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：快干活！不干活的，要挨鞭子，狠狠地抽！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"奴隶问：老爷，这个机器要怎么开啊？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：这上面不是有字吗？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"奴隶说：老爷，我不识字。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你心里一盘算，要请个老师，建个学校来教这些人识字啊。老师要多少工钱？要吃多少粮？唉……该花的成本，还是要花的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说：就按这个钮，这样按，再这样按。等明天我请个识字先生来，教你们这些字。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"奴隶点点头，上工了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是一排奴隶坐在流水线上，开始操作机器。你看了会，发现有个奴隶在偷懒，于是指使监工狠狠抽了他一顿。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"看了会，你觉得没劲，就回家了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"一个月后，监工向你汇报：老爷，这个月我们生产了工件XXXX个。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你一算，这不对啊，这效率也太低了。我用的可是高级的加工机器，怎么可能这么低效呢？监工也委屈地说：老爷啊，不是小的不上心，这鞭子都抽断了好几根了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"于是你又到工厂去看了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"早晨7点，监工的嗓子就在那喊开了：快点，快点，你们这群贱骨头！上工了！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"又是一顿抽鞭子的声音。一排奴隶低着头，麻木地拖着脚镣，叮叮当当地在厂门口，慢慢地挪。鞭子抽得狠了，有奴隶摔在地上，被链子拴成一串的奴隶队伍停了下来。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"监工威胁说：再偷懒，就拿你去喂狗！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是奴隶们稍稍加快了步子。顶头的奴隶拿出遥控器，按了钮，门没开。他又盯着遥控器看了会，继续木然地按那个钮，门一直没动静。监工倒是门儿清，熟练地从窗户钻进厂房，倒鼓了会，门开了。监工出来对你一哈腰：老爷，不知道哪个贱骨头把门帘的电给断了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：不是有监控吗，查！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"监工低头说：老爷，这帮贱骨头都精得很，早就把监控的电也断了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你摇摇头：赶紧上工吧，都快8点了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是又响起一阵鞭子声，奴隶们叮叮当当地摇着他们的镣铐和链子，进了工厂。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你往里头走，巡视了会，发现流水线突然停了。你喊来监工，让他查。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"监工说：老爷，有个贱骨头病死了，刚刚倒下。这流水线吧，一个岗停了，整个岗都要停……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：赶紧的，让人补上，线不能停。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是流水线又动起来了。还没多久，咔当一声，车间一角冒出一股浓烟。你赶过去看，原来是有个奴隶不识字，按错了按钮，把工具卡在设备里，绞坏了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"监工上去把这奴隶抽得皮开肉绽，你看着觉得心烦，说，把这奴隶拉下去，拉下去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"监工说：老爷，这工序上的设备一坏，流水线又停了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：没事，有个备用的，换上。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"流水线又开了会，你下定决心要弄明白为什么生产效率会这么低。于是你坚持待在车间里，看着。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不多时，车间里又有一台机器咣当一声，冒了烟了。你赶过去看，附近奴隶早就一哄而散，就有个大铁锤子，硬生生地砸在机器里，显然是人为破坏的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你生气了，说：谁干的？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"没人说话。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：查！看监控！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"话刚说完，突然想到监控肯定也被奴隶断了电了。所以你只好说：把这机器边上的所有奴隶全部砍了！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"话音刚落，奴隶们跪在地上哭作一团。监工赶紧跑过来说：老爷，不能这样啊，死一两个还好，这要死得多了，还得去买奴隶，这都是钱呐。而且，这些奴隶好不容易会按这些钮了，要教他们这些，可都是花了钱的，再买新奴隶来，还得请识字先生，不划算啊。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你想了想，说：“那就把这里的每个奴隶都抽顿鞭子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"于是流水线停了，所有奴隶围在一起，看监工抽鞭子。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"抽完了，你说，上工吧，这都中午12点了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你在车间边上吃了饭，喝了点茶，混到下午2点，再回到车间，发现流水线又停了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你来回一查，发现有奴隶故意做得很慢，他一慢，整个流水线都慢下来，渐渐地就停止了运转。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你说：查！把这些偷懒的都查出来，全部砍……全部抽鞭子！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是又是一顿鞭子。你开始觉得，这些奴隶从小就挨鞭子长大的，都挨惯了，又不能真的砍了他们，否则还要再请教书先生。就算真的重买一批奴隶回来，重新教他们识字，可能结果还是一样。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"于是你对监工说：算了，别抽了，给他们点吃的，让他们回马棚里睡觉，晚上你到我这来开会。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一年后。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你6点半走到工厂门前，有位员工站在厂房门口，说：董事长好！\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你点点头：早上7点开工，晚上10点下工，有问题吗？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"员工说：公司是我家，公司好，我才不会失业，没有问题！\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你笑着说：很好，现在市场竞争激烈啊，有份工作，不要失业，大家一起奋斗嘛！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这时员工们陆续都到齐了，站成一排，齐刷刷地喊：董事长好！我们愿和公司一齐奋斗！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你点头说：对嘛，我这里是计件工资，干得多，拿得多。准备开工。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"于是一名员工拿出遥控器，打开大门。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人事部的小领导走过来，说：今天开始考勤，每个人都要打卡。全勤有奖，缺勤或者迟到早退，都要扣钱。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"于是员工们争先恐后地打卡，6点50左右，都打完卡，开始上工了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你踱步进厂，问其中一位员工：这些按钮，你都会吗？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"员工笑着说：董事长您放心，我读了小学，初中，高中，还上了大专，进行过培训，这些我都会。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你问：那学费不便宜吧，都是你自己出的？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"员工说：幼儿园起一年就好几千，大专更贵了。不过没关系，这都是我应该出的，为了工作嘛！\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你点点头，觉得很合适。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人事部经理在你面前一哈腰：董事长，咱们这些员工，都是千挑万选地招进来的。不好的员工，我们根本不会通过录取，您放心。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你追问说：如果有病的呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人事部经理说：哎呀，现在不像以前了，我们根本不用管有病的，直接开除就行了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你点头巡视车间，发现大家都在工作，现场井然有序。你问车间经理：现在计件，一个件要给多少钱？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"经理说：一个件，给工人3毛钱。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你心里一算：这样工人一个月就能拿6000多块了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"你问人事部经理：我们这里招工，一个工人的市场价是多少？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人事部经理说：大概4500。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你点点头，对车间经理说：把计件工资调到一个件2毛3。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"车间经理有点为难：这样工人们只能拿4600了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说：对啊，市场价，人工就是4500，我这还多100呐。把工作时间调到早7点到晚11点，推迟1小时下工，让他们多干活。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"车间经理说：这样工人会不会太累，休息时间少了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说：没事，他们自己会少看电视，少看电影，少点娱乐，早点睡觉，自己会调节的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"车间经理点点头，准备把这事拟成管理文件下发。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你叫住他，补充说：要说，我们这里是敞开大门让员工上班的。但他们是自由的，他们想在哪里工作，就在哪里工作。不在我这工作，还可以到别人那工作！既然在我这做了，我这还是计件工资，多给他一小时的工作机会，他还能做更多的件，把工资再补回来，做得多的，还是能拿五六千，也不少了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"车间经理说：我们这很多人还背着房贷……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说：对啊，他就更不敢走人了，还得在我这上工。想以前，我还要给他们盖马棚住呢！现在吃也不用我管，教育也不用我管，住也不用我管，我只要他们来干活就行，多简单。还不还得上房贷，有别人操心，不归我管。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人事经理提醒说：董事长，还是有员工偷懒，每个月只拿3000块，他就租个房，觉得够过日子就行了，但是拖慢整体流水线效率啊。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说：这好办。搞个KPI，施行末位淘汰。每个月考核员工计件数和合格率，得分最低的，警告一次。一年内警告三次的，扫地出门。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你突然想起什么，问：监控还好吧？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"车间经理说：监控是好的。员工们都在计件拿工资，没功夫琢磨监控的事。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"人事经理补充说：可以再搞个奖励制……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你打断他：你啊，给员工评级，一级员工，二级员工，三级员工。一级员工的计件工资是2毛5一个，比别人多2分钱。反正以前是给他们3毛钱的计件，现在全部改成2毛3了，你控制好一级员工的数量，让他们挤破头，也只能评上来两三个人，拿2毛5的计件工资。他们愿意拼抢了，我们拿的利润反而更多。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"回家后，你让会计呈了张报表。看着生产效率和利润表，你满意地笑了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [_c(\"p\", [_vm._v(\"