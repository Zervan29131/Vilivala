ar _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"受伤了酒精可以消毒，\\n可你要是酒驾了，\\n你告诉警察你哪受伤了啊，\\n为什么要不说呢，\\n你不说警察会知道你心受伤了吗？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一个人的生活就是这样，\\n你磕伤了，做手术了，\\n你不敢和父母说，\\n而你连个诉苦的人都没有，\\n60%的幸福来自另一半，\\n所以孤独了该找一个陪你走下去的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你别劝一个男人少喝酒，\\n你认识的他时他已经是\\n把所有苦咽在肚子里后给你的最好一面，\\n不要劝一个喜欢喝闷酒的男人，\\n多陪陪他吧，那叫孤独。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有些人在大冷天穿的很少，\\n你以为是在炫酷，\\n她当然可以了，\\n因为有人在背后为她披大衣，\\n她并不冷。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"动车开的很快，\\n但动车方向从来只向前，\\n这就是人生，\\n一趟只有一个方向，\\n没有来时路，\\n一生都是归途。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"低质量的恋爱，\\n不如高质量的独处。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要觉得一个人的生活无趣，\\n因为曾经你谈恋爱时候觉得\\n对方严重影响自己生活\\n才放弃一段感情的，\\n而你，不长记性。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"谈恋爱了就花全部时间爱她，\\n单身了就花时间爱自己，\\n现在做一个自律的人，\\n既是为了为自己充电，\\n更是配的上更优秀的对方。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"一段恋爱在什么时候结束的，\\n在你真正知道你要闯荡社会时候，\\n你会重新审视现在的恋爱，\\n因为对方即使陪你了很久，\\n但你在生活面前没有选择。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要自己一个人去看海，\\n经验之谈，\\n一个人看海的人没有一个不孤独，\\n它的确能容纳你的痛苦，\\n但你孤单之后会还想去看海，\\n就像是一种上瘾。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我很慢热，\\n对喜欢的人不表白，\\n说的少，但行动力十足，\\n认真到细节，\\n可我从不说，\\n就像是杜甫的诗，\\n外人看到的只是故事，\\n同感的人知道的是他的痛。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"