{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/17.爽感和依赖.md?vue&type=template&id=16e3fb4d","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/17.爽感和依赖.md","mtime":1768579404253},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","id","staticClass","href","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/02.ToRead/08.写法/17.爽感和依赖.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"人性中难以克服的爽感依赖\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#人性中难以克服的爽感依赖\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 人性中难以克服的\"),\n        _c(\"strong\", [_vm._v(\"爽感依赖\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"依赖症包含多种，爽感依赖其实就是心理快感依赖。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"举个例子，同样的两个朋友，他们同样的家境、才华、学历，对你也都好，但一个朋友喜欢吹捧，经常夸你，说好话，不论事情如何都给你正面评价；\\n而另一位朋友比较直，你有错就会完全没有遮掩地挑出来，有时还不分场合，让你难堪。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"也许你自己都不会意识到，\"),\n        _c(\"strong\", [\n          _vm._v(\n            \"你会慢慢疏远那个说真话的朋友，接近那个爱捧你的朋友，原因很简单，他让你很爽。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"除非有一天你以批判性态度来审视这段友谊，否则你可能一直都跳不出来，还以为对方是真的对你好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而且，当你意识到后，想要接近另外一位说真话的朋友时，爽感依赖才会真正尖锐起来：\"\n        ),\n        _c(\"strong\", [\n          _vm._v(\n            \"你发现和说真话的朋友在一起，是真的难受。他完全不捧你，即使这样做有助于你的改变和提升。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"网络小说-vs-经典文学\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#网络小说-vs-经典文学\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 网络小说 VS 经典文学\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"有时候你决定再看一章就不看了，然后你通了宵。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"有时候你决定就大概扫一眼目录，然后你追了两年。\"),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不知道从什么时候开始，我看的书开始转向经典文学名著，其中最令我记忆深刻的一个片段来自\"\n        ),\n        _c(\"strong\", [_vm._v(\"托尔斯泰的《战争与和平》\")]),\n        _vm._v(\"：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"名叫海伦的公爵小姐面带笑容，站了起来，她总是流露着她走进客厅以后就流露的美女般的微笑。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"p\", [\n          _vm._v(\n            \"她从闪到两边去让路的男人中间走过时，她那点缀着藤蔓和藓苔图案的参加舞会穿的洁白的衣裳发出刷刷的响声，雪白的肩膀、发亮的头发和钻石都熠熠生辉，她一直往前走去，向安娜·帕夫洛夫娜身边走去，两眼不看任何人，但对人人微露笑容，宛如她把欣赏她的身段、丰满的肩头、装束时髦的、完全袒露的胸脯和脊背之美的权利恭恭敬敬地赐予每个人，宛如她给舞蹈晚会增添了光彩。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"p\", [\n          _vm._v(\n            \"海伦太美了，从她身上看不到半点娇媚的表情，恰恰相反，好像她为自己坚信不疑的、诱惑力足以倾到一切的姿色而深感羞愧，好像她希望减少自己的美貌的诱惑力，可是无能为力。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"想知道夹带些许虚荣心、得意感、美少女的羞涩，以及作为人群中的公主的傲然和俏皮该如何表现，我想这一段简直是教科书级的描写。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [_vm._v(\"当代文学杂志\")]),\n        _vm._v(\"上发表的作品，感受一下：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"美美是个憨憨的姑娘，长相敦实但挺喜庆，手上的肉比脸上还多，小胖手在瘦老头身上一划拉，就算通上电了。美美身上带着一股闪亮的热气，她一进来荒凉的房间就有了暖色。美美到现在还没对象，马上奔三了，怪愁人的！有时候她挑人家，有时候人家挑她，反正相那么多亲都没结果。\\n美美来了，瘦老头眼睛亮了，粉面桃花气色这么好找到心上人了？哪有，就涂点腮红。谁娶了美美都好福气！不是我那两个小子已经成家，非让你成我家儿媳妇……要是我再小几岁你再老几岁……胖老头用鼻子哼一声，熊样，皮包骨头快咽气的主想法还不少。\\n——\"\n          ),\n          _c(\"strong\", [_vm._v(\"取自张鲁镭作品，《风筝》片段\")]),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"最后我们再比较一下，网络小说里描写一女性角色出场时的片段：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"刚下车，就瞧见一学长被同学打趣着推了出来，这倒是不能怪人家，叶骁本就生得白净，乌黑的长发散开，加上那双提溜转的眼睛，虽不是大眼娃娃，却水灵灵的，鼻子小小的挺着，堪堪的唇红齿白。 穿了件叶驰大人亲自挑选并强制命令叶骁换上的淡鹅黄色连身裙，有点蓬的下摆裹着165cm的叶骁，倒是让她这有点肉的身材显得玲珑有致。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这部网络小说还是质量较好的那种。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"经典小说通常是对社会、人性的深刻洞察后加工而成的文学作品\"),\n        ]),\n        _vm._v(\n          \"，它的起源一般是通过作家眼睛观察到的时代现状，加上他们的独特思考方式、独特写作方式，最终构建出来一栋文学大厦。经典小说往往带有共情，开智的效果，当然这只是附带的，作者本人可能并没有这个想法，他只想传达些什么，控诉些什么，然后展示这个世界。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"而网络小说则是谄媚。\"),\n          _c(\"strong\", [\n            _vm._v(\"网络小说并不谋求社会责任和洞察世界，其源头为\"),\n          ]),\n          _vm._v(\"利益\"),\n        ]),\n        _vm._v(\n          \"。读者想要读什么文字，他们就提供什么文字，以换取流量、版税、名气、月票等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"他们只关注，会不会有人付费，会不会有人追书，有没有人看，他们不会想着揭露社会和引发思考，这样的根源决定了网络小说缺乏营养、同质化严重现象。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"当然，也有通俗文学转为经典作品的情况，比如说《简爱》，但原因也不复杂：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ol\", [\n        _c(\"li\", [\n          _vm._v(\n            \"当代写作水平，特别是网络小说的写作水平实在太低，相对而言《简爱》的文字素养就好了太多；\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"经过时间的洗涤，历史中某些作品展示出来的高价值因素慢慢显露，社会意义得到关注，促进了这些作品传为经典；\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"我们也不能排除幸运儿的可能。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"《百年孤独》的确很棒且世界知名，但有些人是把它当催眠本来看的，一上来就读，估计两天就会放弃，还形成心理阴影，以后也不敢读了，多不值得。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有的时候，适当介入，可以培养人对热点的敏锐度，让他紧跟时代脉搏，只要有独立的意识，不过激，完全不会有问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\"很多热门电视剧都是网络小说改编的，你有探究意识吗？\"),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"你知道年轻人嘴里的“流行词”来自于哪里吗？\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"修仙实际上来自我国本土宗教道教的仙人流你清楚吗？\")]),\n        _vm._v(\" \"