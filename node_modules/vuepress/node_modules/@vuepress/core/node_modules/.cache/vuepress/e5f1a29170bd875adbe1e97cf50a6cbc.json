m._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"首先我并不认为牺牲休闲娱乐的时间会让事情变得更好。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这种把时间等同于努力把努力等同于结果的模式在学习上走不通，在工作上更是走不通。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"最重要的是，我不希望当我老了，回顾青春时只有学习，回顾青年时只有工作。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"相反，我总是在提醒自己，生命不是永生，而是一场体验。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"如果生命是永生，我可以奋斗个500年，只为后面永远的安逸。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但生命只是一场体验，用50年最美好，最鲜活的时光，来保障后面30年苍老的、衰弱的暮年。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个性价比实在是太低了，人生终究只是一场体验。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"既然是一场体验，就必然有时间限制，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"有的人觉得乏味选择中途离场，有的人没玩尽兴迟迟不肯离开，有的人牺牲前半场的快乐来获取后半场的安逸。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"而我觉得每一部分的体验都弥足珍贵，各有颜色。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"认清了这个事实后，我不再思考那些难解的终极问题，人生的意义是什么。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"既然都难逃一死，那生命的价值是什么。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"相反，我开始关心那些我本能做到但却迟迟未做的事情。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如何与伴侣相处，如何获得做事本身的愉悦，如何仰望星空时不胡思乱想，如何早早上床睡个好觉。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人生既是一场体验，我就不应向它多要求什么，从学习放大到人生，我们总说年轻时要好好学习，不要谈恋爱，不要玩。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但事实 上，年轻却是恋爱的最好时光，年轻也是探索兴趣的最好时代，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"谈恋爱让我们知道怎样与异性相处，为未来的婚姻经营打下基础，\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"玩可以让我们了解自己摸索自己，知道自己喜欢什么擅长什么，为未来的职业规划做好铺垫。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"诚然学习工作和恋爱娱乐必定会发生冲突。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是解决冲突，让生活保持平衡，这难道不是我们]应该早早培养的能力吗？\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,6CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,yBAAyB,CAAC,CAAC,CAAC,EAC5CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,wBAAwB,CAAC,CAAC,CAAC,EAC3CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,oBAAoB,CAAC,CAAC,CAAC,EACvCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL