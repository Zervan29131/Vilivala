{\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"多年前，有位无神论学者在一次讲演中，跟他的观众说道，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“这个世界,绝对不会有神的存在。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"说着还在讲台上高声挑战道，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“神，如果你真的存在的话，那你现在就杀死我吧！”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"说完之后，学者还故意等了一会儿，不过什么都没有发生……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"学者非常得意地跟台下的观众说，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“看吧，神 根本就不存在！”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这个时候，观众席中有一个老妇人缓缓站起来……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对这位学者说道，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“先生，您逻辑缜密，一看就是饱学之士。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但我还是有几个疑惑，不知道先生能否给我解惑?”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"接着，老妇人悠悠说道，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“多年来，我相信神明的存在，心中也慢慢有了神的教诲……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在我恐惧的时候，给我安慰；\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"在我悲伤的时候，使我快乐。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"同时我也谨记，在别人需要帮助的时候，给予帮助，最大程度地将善意传播出去……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"因为相信神明的存在，我的人生变得更加幸福和快乐了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"如果有一天我死了，死后我发现神根本不存在，那些教诲也不存在……\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么请问，我这一生到底损失了什么呢?”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"现场一片寂静，这位学者思考了一会儿说，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“你损失了很多东西，首先，你沉迷于自己的想法中，没有成长和长大。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"”其次，神灵并不一定喜欢你这么崇敬祂。“\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"”你死了之后，神灵可能因为你崇拜它是偶像，而直接扔你下地狱“\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"老妇人接着说道，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“那我还有一个疑惑，\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"假若我不信神，可是我在死后却发现神是真实存在的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那些因果报应，天堂地狱，六道轮回都是存在的，……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"那么此时，我又损失了什么呢？”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"学者竟然无言以对……\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这位学者说道：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"”不信神，一样可以自己掌控自己的欢乐和忧愁，一样可以内心平安喜悦不恐惧，一样可以最大程度地把善传播出去，在自己能力所及的范围内帮助别人…“\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"”请问这跟信不信神又有什么关系呢？“\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"”基督教徒都是普遍的亵渎神灵者，用自己的想法去投射到神灵身上，妄想着神灵按照你的想法行动，这样的想法，怎能不获得罪行？“\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\n            \"量子力学诺贝尔奖获得者理查德.费曼说：“自然是道解不开的数学之迷…有规律这个事实本身就是个奇迹。”\"\n          ),\n        ]),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,0BAA0B,CAAC,CAAC,CAAC,EAC7CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,6BAA6B,CAAC,CAAC,CAAC,EAChDN,GAAG,CAACM,EAAE,CA