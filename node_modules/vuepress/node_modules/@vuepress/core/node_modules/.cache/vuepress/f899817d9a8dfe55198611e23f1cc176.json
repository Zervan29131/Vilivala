m.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"今天你可以失去获得它的权利，你不抗争，明天你同样会失去更多的权利，人身权，财产权，包括土地、房屋。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"中国现在这种状况不是偶然造成的，而是长期温水煮青蛙的一个结果，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"大家会觉得农民的土地被侵占了与我何干，火车不开发票、偷漏税与我何干，别人的房屋被强行拆迁与我何干，\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"有一天，这些事情都会落在你的身上。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“但是一个人的力量能改变什么呢？”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“看看罗莎·帕克斯，整个世界为之改变。”他说。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“你靠什么赢得尊重？”我问。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“靠我为自己权利所作的斗争。”郝劲松说，“权利是用来伸张的，否则权利就只是一张纸。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"采访郝劲松的时候，我问过他：“你以谁的名义在诉讼？”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“公民。”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"“公民和普通百姓的概念区别是什么？”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"“能独立地表达自己的观点，却不傲慢，对政治表示服从，却不卑躬屈膝。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"能积极地参与国家的政策，看到弱者知道同情，看到邪恶知道愤怒，我认为他才算是一个真正的公民。”\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我们生而为中国公民，具有宪法赋予的权利和义务。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以前觉得那些都是躺在政治书上的冷冰冰的文字，与我无关，蓦然回首，发现这些都渗透在生活的点点滴滴中。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我不愿做个愚昧无知的人，我想睁眼看世界，我想摆脱偏见，但蒙昧就是自身，唯有《看见》。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EA