ttrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"一人一票的选举制度本来就只是一场愚民的游戏而已，让普通人误以为自己有选择自己利益的权力，从而推卸实际决策者的责任。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"实际上，人类自打进入群居时代以来，任何时代任何社会的组织机构都只能是金字塔式的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"社会资源（财富、身份）和天赋资源（智力、体能）的分配，人人生而不平等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"结果是必然要有个别人来为全社会全人类做出选择，这既是必然的，也是符合社会整体利益和绝大多数个体利益的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"工业文明以来物质财富的丰富，才让人类有闲功夫玩民主人权这些虚妄的概念游戏。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"真正面临激烈的生存竞争的时候，没有一个智力正常的社会组织会选择所谓个体权利和选举制度。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我以前不理解，既然选举制度是先进的，罗马共和国为啥会变成罗马帝国。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这几年闲了读史，特别是罗马帝国衰亡史，才明白所谓的选举制度其实只是一场贵族游戏而已，反而是所谓独裁的皇帝更能代表普通罗马公民的利益。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"普通罗马人也不傻，支持谁反对谁心中自然有数。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"另外，绝大多数人即使真的有选择的机会和权力，也不一定有选择的能力，瞎选择的结果是大家一块玩完。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我自己办公司后深深体会到，寻找、培养、选择一个理想的总经理有多难。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，很多国家可以一人一票选国家总统总理，却从来没见过任何一家成功的企业，是由股东或者员工一人一票选总经理的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你说的问题，是因为讨论篇幅的限制产生的误解，我的观点的不是这样的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"绝大多数人没有选择的能力和条件，不是因为愚蠢，而是因为先天禀赋和社会分工不同。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"比如有的人善于写作，有的人长于数学，有的人身体柔韧性特别好，非要让这些人去做同一件事情，是不公平也是不合理的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"人类社会管理的复杂度日益提高，专业的事应该让专业的人去做。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就好像，我们不能让医院的全体工作人员，对一个脑科手术方案投票一样。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"为什么我们要对社会治理方案进行一人一票表决呢？\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"核心在于问责机制，而不是投票机制，你仔细想想。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"另外，西方选举制度问题的麻烦在于一人一票导致的民粹化。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"但是他们的制度在设计时并不是这样的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"美国先贤们设计的政治制度，上防暴君，下防暴民，设置了层层的防火墙，只不过现在这些防火墙被社会发展和互联网技术瓦解了。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,0CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,qDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,uCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,6CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,mCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oEACF,CAA