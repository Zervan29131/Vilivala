{"remainingRequest":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js??ref--3-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js??ref--6!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js??ref--1-0!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js??ref--1-1!/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js??ref--1-2!/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/02.关于工具.md?vue&type=template&id=3893d683","dependencies":[{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/02.关于工具.md","mtime":1768579404261},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/babel-loader/lib/index.js","mtime":1768628719475},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/cache-loader/dist/cjs.js","mtime":1768628718969},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/vue-loader/lib/index.js","mtime":1768628718490},{"path":"/Users/zervan.cn/Documents/GitHub/Vilivala/node_modules/@vuepress/markdown-loader/index.js","mtime":1768628722078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["render","_vm","_c","_self","attrs","$parent","slotKey","_v","staticRenderFns","_withStripped"],"sources":["/Users/zervan.cn/Documents/GitHub/Vilivala/docs/03.fun/06.social/02.关于工具.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"『工具』是很高贵的，是人类存世的意义之一，也是人类最伟大的发明和贡献。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在社会中，『工具』是很高贵的，是人类存世的意义之一，也是人类最伟大的发明和贡献。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而在现在的话术里面，『工具』反而成为了一钟不上台面的解决问题的消耗品。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这是社会经济文化风向变化所导致的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为什么？因为社会性质慢慢变了。大家越来越发现，工具不值钱，或者说再值钱也比不过背后的资本。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"资本可以啥都不会，只有钱，甚至不懂经营也可以找到『经营工具人』，不懂技术找『技术工具人』，至于别的更没技术含量的那简直满大街都是工具人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"为什么会这样呢？很简单，拥有资本的人，在社会框架里面占了过大的优势。一个很简单的例子，老板开公司，工人的劳动剩余价值100，公司总收入200，老板分走了100，打工人拿到100 。老板没出力就获得了100的剩余价值。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"很多人总会这样告诉你，老板承担了『风险』，工人不管货能不能卖出去，他的工钱是死拿的，绝不会亏。亏钱都是老板在背。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"实际上是老板作为投资人，话语权被社会框架极度放大，他把你打工价值100直接压到20，不干拉倒。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而20这个数字怎么来的？不是他编的，而是由社会成本决定的。简单来说就是一个人不用住桥洞，不用挨饿，所必须的最低成本。20年前刚上社会的打工人，一个月拿1000，10年前拿2000，今年拿3000，但是跟物价比较，永远都是刚够你租一间单人房，每天吃最便宜的盖饭，坐最低价的公交车，年底剩不下来什么玩意。这个就是社会最底层劳动力的最低成本。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"那么你想想，几十年科技进步，生产力发展，为什么这些『基本单位』打工人，相对价值成本还一直是那么多呢？发展带来的红利呢？进步呢？为啥没发展到刚毕业的年轻人干一年能买半套房呢？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"投资的永远不会给你打工人应得的那点价值，因为他给你，就意味着社会进步生产力进步带来的资本红利也分给你，你出一样的劳动，却能获得和资本一样的增值。这是做梦。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果打工人能获得增值的好处，那么打工人和顶级资本家之间的贫富应该是按照不变的比例前进的。打工人月薪1000，马云1000万；月薪2000，马云2000万……这么下去贫富差距一直是成比例的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而现实却是你1000元，马云1000万，你2000元，马云一个亿，你3000元，马云100个亿……这就是所谓的贫富差距变大\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"资本家有了资本，就有了压价的能力；打工人的工作量不能存储，只能按天按次花费大量时间慢慢释放，一天不干就亏一天，所以毫无溢价能力。你今天不干活，白亏一天，而资本放着不动是不会亏的。两者谈判，哪个会先受不了？\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以资本家，却可以用压价的手法把工具人控制在一系列标准内：干一年能攒下来一点钱；干十年可以攒几个平方，干30年外加贷款可以攒下一套房……\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"打工人也就成了『工具』，因为『工具』是不参与分红的。只考虑它的损耗而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"既然是『工具』那还用给你什么好脸色吗？都是螺丝钉而已。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"实际上的工具是什么？它应该是人类最高目标之一。人类的科技、文化等发展，也不过是在不断完善一些『工具』而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"别说科研生产里面工具多重要了，就算是文化领域，能开发某个具体技巧的，那也不是一般的大师。比如希区柯克对剧情玩法的种种技术，说起来也是技巧，但这种改进整个电影领域能有几个这样的大师呢？凤毛麟角。所以说真正能让『工具』有一丁点实质发展的人，大致都成为了大师或者精英。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"从这个角度来看，当不上资本家的，也就只能向内索取意义，以改进『工具』为人生一大目标了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这个世界就是这个样子：在我们眼中的『大师』比如手冢治虫、宫崎骏，可能在那些资本家眼里也不过是『出色』的工具大师而已。高贵不到哪去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"strong\", [\n          _vm._v(\"注：以上文章整理自网络，如涉及版权请联系删除，谢谢。\"),\n        ]),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,C