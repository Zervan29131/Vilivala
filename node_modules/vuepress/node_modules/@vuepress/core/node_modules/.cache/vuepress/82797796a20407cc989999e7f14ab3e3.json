 _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"假设你是一家造纸厂的负责人，从市场上买纸浆，做成纸然后卖出去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"现在纸价飞涨，大家都觉得你应该加班加点地干，但你却停工了。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"为什么？因为下游的纸价上涨，但上游的纸浆涨得更快。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果你开工，意味着做得越多亏得越多，所以就停工了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"这就是一家造纸厂“躺平”的故事，而且这种事就发生在此时此刻。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而这时候有人问哎呀纸厂都躺平了，最后怎么收场？很简单啊，纸厂停工带来两个后果：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一、纸张供应减少，纸价进一步上涨；\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"二、纸浆需求减少，纸浆价格下跌。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以，在理论上，纸厂“躺平”的结果就是纸价和纸浆价格达到一个新的平衡，纸厂在新的平衡下可以盈利，于是他就又“站起来”了。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"悲观一点，市场是会失效的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"那就是无论纸厂怎么躺，纸浆价格和纸价就是达不到新的平衡。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"卖纸浆的说我再降价越卖越亏，不如直接倒了（咱这是倒纸浆，美国之前倒过牛奶）。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"买纸的说你再涨价，我这企业挣的那点利润全给你纸厂了，那我也不买了，大不了推无纸化办公。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"市场失灵的结果，就是一条产业链上，谁也别活。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，这种事情在中国不会发生，因为我们还有最大的法宝——宏观调控。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"现在政府部门已经在和纸浆供应方谈话了，要控制价格。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"国常会提出要应对大宗商品涨价，人民币宣布进入长期升值。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"这些都是宏观的手段。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以“躺平”的结果就两个：要么问题解决，大家都站起来继续向前，要么问题恶化，谁都别站着，大家一起死。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"把“纸厂”替换成“年轻人”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"把“纸浆价格”替换成“生活成本”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"把“纸价”替换成“收入”\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"基本这事就说明白了。\")]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,iCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,+BAA+B,CAAC,CACxC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,2BAA2B,CAAC,CAAC,CAAC,EAC9CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,gCAAgC,CAAC,CACzC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,mBAAmB,CAAC,CAAC,CAAC,EACtCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,kBAAkB,CAAC,CAAC,CAAC,EACrCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,8DACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,eAAe,CAAC,CAAC,CAAC,EAClCN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CAAC,8BAA8B,CAAC,CACvC,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,w