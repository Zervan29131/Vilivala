{ attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [_vm._v(\"婚姻是一种动态的社交\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"两个人在交流过程中，在各自的成长过程中，本身就是不断变化的，这个变化可以向坏，比如出轨，经济纠纷。也可以向好。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"比如各种奇葩的浪漫爱情电影。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以严格来说不存在什么“将就”的社交关系，因为人与人的关系都是动态的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"所以与其说，婚姻是“找一个完美的伴侣”，不如说婚姻是买一张票，开始一种旅程。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我不知道罗马好不好玩，我也没见过，但我想去看看。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"我会享受途中的一切，寻找它的意义和价值。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你学生时代爱得死去活来，鬼哭神嚎的那个伴侣——持续了多久？你俩分手后还是朋友么？那么好的感情，那么不将就的感情，也没成功不是吗？因为关系是动态的。不是绝对的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"既然人际关系是动态的，而你就应该相信你可以相对把握住这个动态，往好的方向引导。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"至于“我把握不住，干脆不要尝试了”，这是纯粹的消极生活理念。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对于我们来说，尝试是非常有价值的。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"假设现在有个时光机，能让你跟105岁马上就要临终的自己聊个几分钟。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你觉得那时候的你，会鼓励你“尝试一切吧，不要抗拒”，还是“你乖乖躲起来就好”。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"一个人如果活到老，还在逃避，那是真的白过了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"“婚姻既不是结果也不是定式，婚姻是开始一段全新未知的旅程。”\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"人们天性反感制度，我中学时候坚决不入团，因为我觉得这是一种对自己有害无益的制度。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"入团的唯一好处是方便入党，而入党的唯一好处是进体制，这些都是一脉相承的体制，如果我不想进体制那么我就不入团。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"为此我老师做了我好多轮工作，最后放弃了。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但是，我想说的是但是，那些糊里糊涂入了团的同学，也从没听说过心疼那点团费或者为此后悔的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"关键的不是制度，而是具体的利害。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果我被威胁不入团就怎样，或者团里活动好玩，那我也乖乖入团，不就是写点舔的申请书和交点团费吗。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我觉得没必要纠结这点差异，收获远比恐惧多，因为收获是可以自己经营的，收获越多，恐惧越少。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"婚姻就像一条小河，有的人是松鼠进去就大概率淹死，可我觉得我是牛。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果作为成年牛还怕蹚到脚脖子的水，那不是逃避，而是懦弱或者智商有问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"我不是要不尊重不婚的人，没人知道别人面对怎样的困难，但我觉得害怕制度的人也没必要当作这是所有人都需要考虑的。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"而且就不应当是首先考虑的，因为制度本来就是为了满足需求而发明的，首先考虑的肯定是需求，无非是不想做或者不能做而已。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"想做、能做而已。想结婚，能结婚，就结了。不想结，谁能逼？那些痛斥父母逼婚的，他们父母成功了没？大清早亡了\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"归根结底是每种人生活模型不同，有那种结婚后生孩子给自己找保险希望有个孩子会赚钱的自私的人，也有那种要不就不结婚要结婚生子就要一个给孩子最好的人，大家根据自己的喜好选择就好了。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,YAAY,CAAC,CAAC,CAAC,EAC/BN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,yDACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,C