self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"p\", [\n        _vm._v(\n          \"与人在线上交谈，要以所有聊天记录即便被公开也不会造成严重影响为底线。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"与异性在线下单独相处，所有言行要以对方男女朋友在场也不会引起一丝尴尬或不适为底线。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"如果对方单身但不是你追求对象，就假设对方有男女朋友。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"如果对方单身且是你追求对象，请务必在约对方出来之前就让对方知道你有追求的意思，分清什么是暗示，什么是打幌子。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"对方可以拒绝或推辞，对方可以装傻但你不能。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"你提出邀约的同时就必须做好被拒绝要能从容接受的准备，要在表达之后坦荡的接受对方的不接受。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"这些行为确实不利于你最快速度追到对方，但是会被死缠烂打或欺诈套路捕获的人，本身也好不到哪里去。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"诡计也许能让你得到某个人，但坦荡才能让你成为自己都欣赏的人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"除了别在背后说坏话，其实喜爱更不该让第三者代为表达。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"你可以在公开场合秀恩爱，但绝不能在公众面前秀单相思。\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"不要当众表白，不要和对方的闺蜜兄弟诉说，如果你不能或不敢直接对对方表达爱意，那就别说。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"甚至能当面搭讪，都最好别通过其他途径得到对方的联系方式。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"为什么涉及到两性、尤其是成人话题尤其能凸显一个人的猥琐与否。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"其根源是，欲望本身没有任何问题，而是达成欲望的方式让人显得猥琐。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"av画面本身并没有什么问题，而给潜意识灌输的逻辑却很猥琐。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"就好比吃饭是人的正常需求，但Av教你去小偷小摸，去强，去违背对方意志来得到某种阴暗的快感。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"与之相反的是，种种经典电影里的情圣同样好色，但却很迷人。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"别说出众的外貌，就看王小波，同样蓬头垢面，可坦荡且光明的表达性需求，不媚俗不具有攻击性，本身就是种魅力。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"由此延伸出来的是，其实猥琐的实质是对自身欲望的不恰当流露。\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"但同样的，弓腰驼背蓬头垢面确实很猥琐，但这种猥琐本质上并不具备攻击性，也就是没有欲望的流露，然而没太多需要克制的地方。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"真正需要关心的是相由心生，是和欲望有关的猥琐。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"无欲无求的人不会猥琐，有欲求能轻松实现的也不会猥琐，所以每当你觉得气质猥琐，一定是内心有某种欲望，但却在扭曲这种欲望。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"要么是压抑它的表达，眼红别人，暗中嫉妒，要么是不正确的表达，企图诋毁他人，尤其是恶意揣测不熟悉的人。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"要么是当这种欲望需要对方帮助你实现时，你表现的做作。\")]),\n      _vm._v(\" \"),\n      _c(\"br\"),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"以上说的种种，从未要求你克制自身欲望，而是反复强调，要坦诚的表达。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"综上所述，唯一克制猥琐的，就是正视自己的欲望，并且光明坦荡的实现。\"\n        ),\n      ]),\n    ]\n  )\n}\nvar staticRenderFns = []\nrender._withStripped = true\n\nexport { render, staticRenderFns }"],"mappings":"AAAA,IAAIA,MAAM,GAAG,SAASA,MAAMA,CAAA,EAAG;EAC7B,IAAIC,GAAG,GAAG,IAAI;IACZC,EAAE,GAAGD,GAAG,CAACE,KAAK,CAACD,EAAE;EACnB,OAAOA,EAAE,CACP,yBAAyB,EACzB;IAAEE,KAAK,EAAE;MAAE,UAAU,EAAEH,GAAG,CAACI,OAAO,CAACC;IAAQ;EAAE,CAAC,EAC9C,CACEJ,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,oCACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CACND,GAAG,CAACM,EAAE,CACJ,2CACF,CAAC,CACF,CAAC,EACFN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EAAE,CAAC,GAAG,EAAE,CAACD,GAAG,CAACM,EAAE,CAAC,4BAA4B,CAAC,CAAC,CAAC,EAC/CN,GAAG,CAACM,EAAE,CAAC,GAAG,CAAC,EACXL,EA